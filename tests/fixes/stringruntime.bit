fn runtime_slice(string source) {
    return source >> get(1:3);
}
fn runtime_name(string source) {
    file path = source;
    return path >> name;
}
host {
    dir scratch = "bit-strings-{term >> pid}";
    do(scratch >> make);
    file source = scratch >> file("example.txt");
    do(source >> write("first\n\nlast\n"));
    print(source >> get(0));
    print(source >> get(1));
    print(source >> get(2));
    print(source >> get(3));
    num negative = -1;
    print(source >> get(negative));
    print(source >> read);
    print(runtime_slice("abcdef"));
    print("abcdef" >> get(3:1));
    print(runtime_name("path/example.txt"));
    bytes b = mem >> take(2);
    do(b >> set(0, 65) >> set(1, 66));
    print(b >> text);
    do(b >> free);
    do(source >> remove);
    do(scratch >> remove);
}
