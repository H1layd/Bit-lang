fn label(num value):
    if value < 0:
        return "minus";
    else if value == 0:
        return "zero";
    else:
        return "plus";

fn count():
    num total = 0;
    for i in 0:3:
        if i == 0:
            next;
        do(total >> ch(total + i));
    return total;

host {
    print(label(0));
    print(count());

    # The else belongs to the outer conditional.
    if false:
        if true:
            print("wrong");
    else:
        mas values = (2, 4);
        for v in values:
            print(v);

    num n = 0;
    while n < 3:
        do(n >> ch(n + 1));
    print(n);

    recover:
        num zero = "0" >> num;
        print(1 / zero);
    else:
        print("recovered");

    if true {
        print("braces");
    }
}
