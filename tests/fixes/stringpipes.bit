fn pipe_make(num n) { return " value-{n} "; }
fn pipe_fail() { return "bad-number" >> num; }
fn pipe_fail_text() { do(pipe_fail()); return "never"; }
fn pipe_piece(num n) { return "{n}"; }
host {
    print(pipe_make(4) >> sz);
    print(pipe_make(4) >> trim);
    print(pipe_make(4) >> get(1:5));
    print(pipe_make(4) >> get(1));
    print(pipe_make(4) >> starts(" value"));
    print(pipe_make(4) >> ends("4 "));
    print(pipe_make(4) >> replace("value", "v"));
    mas parts = pipe_make(4) >> split("-");
    print(parts >> get(0, "missing"));
    print(parts >> get(1, "missing"));
    print(pipe_make(4) >> replace(pipe_piece(4), pipe_piece(5)));
    print(pipe_make(4) >> ends(pipe_piece(4) + " "));
    recover {
        print(pipe_make(4) >> replace(pipe_piece(4), pipe_fail_text()));
    } else {
        print("caught replacement");
    }
    recover {
        print(pipe_make(9) >> get(pipe_fail()));
    } else {
        print("caught");
    }
    recover {
        print(pipe_make(9) >> get(pipe_fail():3));
    } else {
        print("caught range");
    }
}
