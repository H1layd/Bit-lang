fn seven(num a, num b, num c, num d, num e, num f, num g) {
    return a + b + c + d + e + f + g;
}
fn nine(num a, num b, num c, num d, num e, num f, num g, num h, num i) {
    return a * 100 + b * 10 + c + d * 100000 + e * 10000 + f * 1000 + g * 100000 + h * 1000 + i;
}
fn words(string a, string b, string c, string d, string e, string f, string g, string h) {
    return a + b + c + d + e + f + g + h;
}
host {
    print(seven(1, 2, 3, 4, 5, 6, 7));
    print(nine(1, 2, 3, 4, 5, 6, 7, 8, 9));
    print(words("a", "b", "c", "d", "e", "f", "g", "h"));
    print(seven(1, 1, 1, 1, 1, 1, 1) + nine(1, 1, 1, 1, 1, 1, 1, 1, 1));
}
