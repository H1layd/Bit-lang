# процессы: запуск, ожидание, остановка и отсутствующий процесс (macOS, Linux)
host {
    proc r = "exit 7" >> start;
    print("код выхода {r >> wait}");
    proc p = "exec sleep 5" >> start;
    do(term >> wait(100));
    print("работает {p >> alive}, имя '{p >> name}'");
    proc q = p >> pid >> proc;
    print("тот же по pid: {q >> pid == p >> pid}");
    do(p >> kill);
    print("после kill код {p >> wait}, работает {p >> alive}");
    proc none = "нет_такого_процесса_bit" >> proc;
    print("нет: pid {none >> pid}, работает {none >> alive}, имя '{none >> name}', wait {none >> wait}");
    recover {
        do(none >> kill);
    } else {
        print("сбой: {term >> error}");
    }
}
