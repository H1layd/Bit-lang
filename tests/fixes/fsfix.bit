host {
    dir d = "bit-fsfix-{term >> pid}";
    do(d >> make);
    file f = d >> file("a.bin");
    bytes data = mem >> take(5);
    do(data >> set(0, 65) >> set(2, 66) >> set(4, 67));
    do(f >> save(data));
    do(data >> free);
    do(f >> copy("{d}/b.bin"));
    file g = d >> file("b.bin");
    print("размер копии {g >> sz} (должно быть 5)");
    file asfile = d >> path;
    print("папка это файл? {asfile >> exists}");
    do(f >> remove);
    do(g >> remove);
    do(d >> remove);
    print("папка осталась: {d >> exists}");
}
