host {
    string value = term >> env("BIT_TEST_ENV");
    if (term >> args >> get(0, "")) == "start":
        do(term >> wait(500));
        file marker = "child.txt";
        do(marker >> write(value));
    else:
        file local = "local.txt";
        if (term >> args >> get(0, "")) == "shell":
            print("{value} / {local >> read}");
        else:
            print("{value} / {local >> read} / {term >> env('BIT_ТЕСТ')}");
}
