fn unwind_string(num n) {
    return "value-{n}";
}
fn unwind_target(string value, num marker) {
    return value >> sz + marker;
}
fn unwind_failure() {
    return "invalid-number" >> num;
}
fn unwind_body_failure(string value) {
    do(unwind_failure());
}
fn unwind_replace() {
    string value = "seed";
    for i in 0:99 {
        do(value >> ch(unwind_string(i)));
        do(value >> ch(value));
    }
    return value;
}
fn unwind_format(string value) {
    return "[{value}]";
}
fn unwind_replaced_failure() {
    string value = "seed";
    do(value >> ch(unwind_string(9)));
    do(value >> ch(value));
    do(unwind_failure());
}
fn unwind_parameter_recover(string value) {
    do(value >> ch("[{value}]"));
    recover {
        do(unwind_failure());
    } else {
        return value;
    }
    return value;
}
fn unwind_parameter_borrowed(string value) {
    recover {
        do(unwind_failure());
    } else {
        return value;
    }
    return value;
}
fn unwind_runtime_slice() {
    return "абвг" >> get(1:2);
}
fn unwind_runtime_empty() {
    return "abc" >> get(2:1);
}
fn unwind_runtime_name() {
    file path = "folder/name.txt";
    return path >> name;
}
fn unwind_runtime_bytes() {
    bytes data = mem >> take(2);
    do(data >> set(0, 65) >> set(1, 66));
    string result = data >> text;
    do(data >> free);
    return result;
}
fn unwind_pipe_trim(num n) {
    return unwind_string(n) >> trim;
}
fn unwind_pipe_slice(num n) {
    return unwind_string(n) >> get(1:3);
}
fn unwind_pipe_char(num n) {
    return unwind_string(n) >> get(1);
}
fn unwind_fail_text() {
    do(unwind_failure());
    return "unreachable";
}
fn unwind_interpolate(num n) {
    return "prefix {unwind_string(n)} middle {unwind_string(n)} suffix";
}
fn unwind_method_replace(num n) {
    return "value-10" >> replace(unwind_string(n), unwind_string(2));
}
fn unwind_pad_fill(num n) {
    return "x" >> pad(3, unwind_string(n));
}
fn unwind_pad_left_fill(num n) {
    return unwind_string(n) >> pad_left(12, unwind_string(n + 1));
}
fn unwind_process_input(num n) {
    mas missing = ("bit-nonexistent-executable-for-unwind-test");
    string output = missing >> run(unwind_string(n));
    if (output >> sz) != 0 or (term >> status) != 127 {
        print("unexpected-process-status" >> num);
    }
    mas empty = (string);
    recover {
        print(empty >> run(unwind_string(n + 1)));
    } else {
        if term >> error == "" { print("missing-process-error" >> num); }
    }
}
fn unwind_more_local_methods(num n) {
    string value = unwind_string(n);
    string upper = value >> upper;
    string lower = value >> lower;
    string piece = value >> get(0:2);
    string repeated = value >> repeat(2);
    string padded = value >> pad(16, ".");
    string padded_left = value >> pad_left(16, ".");
    bool found = value >> contains("value");
    num index = value >> find("-");
    num code = value >> code;
    string number = "{n}";
    num parsed = number >> num;
    recover {
        print(value >> num);
    } else {
        if not (value >> contains("value")) { print("lost-value" >> num); }
    }
    if not found or index != 5 or code != 118 or parsed != n {
        print("wrong-local-method" >> num);
    }
    return (upper >> sz) + (lower >> sz) + (piece >> sz) + (repeated >> sz) +
        (padded >> sz) + (padded_left >> sz);
}
fn unwind_local_methods(num n) {
    string value = unwind_string(n);
    bool prefix = value >> starts("value");
    bool suffix = value >> ends("{n}");
    string trimmed = value >> trim;
    string changed = value >> replace("value", "new");
    recover {
        print(value >> replace("value", unwind_fail_text()));
    } else {
        if not (value >> starts("value")) {
            print("lost-local-receiver" >> num);
        }
    }
    if not prefix or not suffix {
        print("invalid-local-method" >> num);
    }
    return (trimmed >> sz) + (changed >> sz);
}
host {
    string process_list = os >> procs;
    if process_list >> sz == 0 { print("empty-process-list" >> num); }
    string temp_base = term >> env("TMPDIR");
    if temp_base == "" { do(temp_base >> ch(term >> env("TEMP"))); }
    if temp_base == "" { do(temp_base >> ch("/tmp")); }
    dir temp_directory = _bitc_mkdtemp(temp_base + "/bit-unwind.XXXXXX");
    do(temp_directory >> remove_all);
    recover {
        dir invalid_directory = _bitc_mkdtemp(temp_base + "/bit-invalid");
        print("unexpected-temp" >> num);
    } else { }
    num caught = 0;
    all target = unwind_target;
    for n in 0:63 {
        recover {
            do(unwind_target(unwind_string(n), unwind_failure()));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            do(target(unwind_string(n), unwind_failure()));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            do(unwind_body_failure(unwind_string(n)));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            do(unwind_replaced_failure());
        } else {
            do(caught >> ch(caught + 1));
        }
    }
    if caught != 256 {
        print("wrong-recovery-count" >> num);
    }
    do(unwind_target(unwind_string(7), 2));
    do(target(unwind_string(8), 3));
    do(unwind_replace());
    do(unwind_format(unwind_string(6)));
    do(unwind_parameter_recover(unwind_string(10)));
    do(unwind_parameter_borrowed(unwind_string(11)));
    do(unwind_runtime_slice());
    do(unwind_runtime_empty());
    do(unwind_runtime_name());
    do(unwind_runtime_bytes());
    do(unwind_process_input(12));
    for i in 0:100 {
        if unwind_string(i) >> sz < 1 {
            print("invalid-length" >> num);
        }
        if not (unwind_string(i) >> starts("value")) {
            print("invalid-prefix" >> num);
        }
        do(unwind_pad_fill(i));
        do(unwind_pad_left_fill(i));
        if (i >> pad(12, unwind_string(i + 2))) >> sz < 1 { print("invalid-num-pad" >> num); }
        if (2.5 >> pad_left(12, unwind_string(i + 3))) >> sz < 1 { print("invalid-dec-pad" >> num); }
        recover {
            print(i >> pad(-1, unwind_string(i + 4)));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) >> pad(-1, unwind_string(i + 1)));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) >> pad(12, unwind_fail_text()));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) >> pad(unwind_failure(), "x"));
        } else {
            do(caught >> ch(caught + 1));
        }
        do(unwind_more_local_methods(i));
        do(unwind_local_methods(i));
        do(unwind_pipe_trim(i));
        do(unwind_pipe_slice(i));
        do(unwind_pipe_char(i));
        do(unwind_method_replace(i));
        do(unwind_interpolate(i));
        recover {
            print("first {unwind_string(i)} middle {unwind_fail_text()} end");
        } else {
            do(caught >> ch(caught + 1));
        }
        if unwind_string(i) == unwind_string(i) {
            do(caught >> ch(caught + 1));
        }
        if unwind_string(i) != "never" {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) == unwind_fail_text());
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) + unwind_fail_text());
        } else {
            do(caught >> ch(caught + 1));
        }
        do(random >> seed(unwind_string(i)));
        if term >> env(unwind_string(i)) >> sz > 1000000 {
            print("unexpected-environment" >> num);
        }
        recover {
            do(term >> env(unwind_string(i), unwind_fail_text()));
        } else {
            do(caught >> ch(caught + 1));
        }
        if "value-1" >> starts(unwind_string(i)) {
            do(caught >> ch(caught + 1));
        }
        recover {
            print("value-1" >> replace(unwind_string(i), unwind_fail_text()));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) >> get(unwind_failure()));
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) >> num);
        } else {
            do(caught >> ch(caught + 1));
        }
        recover {
            print(unwind_string(i) >> get(unwind_failure():2));
        } else {
            do(caught >> ch(caught + 1));
        }
    }
}
