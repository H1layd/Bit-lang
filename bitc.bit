    do(o >> add("Lrt_esignal: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\321\\203\\321\\201\\321\\202\\320\\260\\320\\275\\320\\276\\320\\262\\320\\270\\321\\202\\321\\214 \\320\\276\\320\\261\\321\\200\\320\\260\\320\\261\\320\\276\\321\\202\\321\\207\\320\\270\\320\\272 \\321\\201\\320\\270\\320\\263\\320\\275\\320\\260\\320\\273\\320\\276\\320\\262\""));
    do(o >> add("Lrt_ethread: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\321\\201\\320\\276\\320\\267\\320\\264\\320\\260\\321\\202\\321\\214 \\320\\277\\320\\276\\321\\202\\320\\276\\320\\272\""));
    do(o >> add("Lrt_epad_width: .asciz \"pad: \\321\\210\\320\\270\\321\\200\\320\\270\\320\\275\\320\\260 \\320\\276\\321\\202 0 \\320\\264\\320\\276 1000000\""));
    do(o >> add("Lrt_epad_count: .asciz \"repeat: \\321\\207\\320\\270\\321\\201\\320\\273\\320\\276 \\320\\276\\321\\202 0 \\320\\264\\320\\276 100000000\""));
    do(o >> add("Lrt_ehex_width: .asciz \"hex: \\321\\210\\320\\270\\321\\200\\320\\270\\320\\275\\320\\260 \\320\\276\\321\\202 0 \\320\\264\\320\\276 64\""));
    do(o >> add("Lrt_efixed_places: .asciz \"fixed: \\320\\267\\320\\275\\320\\260\\320\\272\\320\\276\\320\\262 \\320\\276\\321\\202 0 \\320\\264\\320\\276 17\""));
    do(o >> add("Lrt_eread: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\320\\277\\321\\200\\320\\276\\321\\207\\320\\270\\321\\202\\320\\260\\321\\202\\321\\214 \\321\\204\\320\\260\\320\\271\\320\\273: \""));
