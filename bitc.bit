# ═══════════════════════════════════════════════════════════════════
#  bitc — компилятор языка bit, написанный на самом bit.
#
#    .bit  →  ассемблер ARM64 или x86_64  →  машинный код (macOS, Linux, Windows)
#
#  bitc run   файл.bit [--arch arm64|x86_64] [--os macos|linux|windows]
#  bitc build файл.bit [-o имя] [--arch ...] [--os ...]
#  bitc asm   файл.bit [--arch ...] [--os ...]
# ═══════════════════════════════════════════════════════════════════

num MAXV = 9223372036854775807;
num MINV = -9223372036854775807 - 1;

bool IS_ARM = true;
bool IS_LINUX = false;
bool IS_WINDOWS = false;
bool OPTIMIZE = false;
bool SIGNALS_USED = false;
string PATH = "";
mas SRCL = (string);
mas SOURCE_NAMES = (string);
mas SOURCE_START = (num);
mas SOURCES_ACTIVE = (string);
mas SOURCES_LOADED = (string);

# ───────── токены ─────────
mas TK = (string);
mas TV = (string);
mas TN = (num);
mas TL = (num);
num P = 0;

# ───────── узлы дерева программы ─────────
mas NK = (string);
mas NS = (string);
mas NT = (string);
mas NM = (string);
mas NV = (num);
mas NA = (num);
mas NB = (num);
mas L1 = (num);
mas C1 = (num);
mas L2 = (num);
mas C2 = (num);
mas NL = (num);
mas LST = (num);
mas FNS = (num);
mas GLOBS = (num);
mas RECORDS = (num);
mas FN_VALUE_ARGS = (string);
mas FN_VALUE_RET = (string);

# ───────── переменные ─────────
mas VN = (string);
mas VT = (string);
mas VLINE = (num);
mas VLIM = (num);
mas VLOOP = (num);
mas VSLOT = (num);
mas VOWN = (num);                  # stack cleanup record for an owned string, or -1
mas VGLOB = (num);
mas VLAB = (string);
mas SCV = (num);
num SCTOP = 0;
num SCBASE = 0;
mas SCM = (num);
num SMTOP = 0;
mas GLIST = (num);
mas LBRK = (string);                # метки выхода из цикла (break)
mas LCNT = (string);                # метки перехода к следующей итерации (next)
num LDEP = 0;                       # глубина вложенности циклов
mas LREC = (num);
mas LOWN = (num);
num RECDEP = 0;

# ───────── экземпляры функций ─────────
mas IKEY = (string);
mas IFN = (num);
mas ILAB = (string);
mas IRET = (string);
mas ICODE = (string);
mas IARGS = (string);
mas QUEUE = (num);
string GINIT = "";
num NLAB = 0;
mas STRS = (string);
mas DECS = (string);

# ───────── текущая функция ─────────
mas OUT = (string);
mas ARGS_SLOTS = (num);
num ARGS_ARG0 = 0;
mas STUBS = (string);
mas ST = (num);
num VBASE = 0;
num NSLOTS = 0;
string RETLAB = "";
bool DRY = false;
num CUR = -1;
mas RETS = (string);
num OWNDEP = 0;
bool UNKRET = false;

# результат выражения
string RT = "";
num RV = -1;
bool RLK = false;
num RL = 0;
bool RHK = false;
num RH = 0;
num RMSZ = -1;
bool RFRESH = false;

# операнды для арифметики диапазонов
bool ALK = false;
num AL = 0;
bool AHK = false;
num AH = 0;
bool BLK = false;
num BL = 0;
bool BHK = false;
num BH = 0;
num XF = 0;
num XV = 0;

# найденное действие
string MF = "";
string MA = "";
string MR = "";
bool MLF = false;
string MMODE = "";

# константа
string CTEXT = "";
num CVAL = 0;

# ═══════════════════════════ мелочи ═══════════════════════════

fn mset(mas m, num i, all v) {
    if i >= 0 and i < m >> sz {
        do(m >> set(i, v));
    }
}

fn sput(mas m, num i, num v) {
    if i >= 0 and i < m >> sz {
        do(m >> set(i, v));
    } else {
        do(m >> add(v));
    }
}

fn is_space(num c) {
    return c == 32 or c == 9 or c == 10 or c == 13;
}

fn starts(string s, string p) {
    mas q = p >> bytes;
    return s >> bytes >> text(0, q >> sz) == p;
}

fn ends(string s, string p) {
    mas b = s >> bytes;
    num n = b >> sz;
    num m = p >> bytes >> sz;
    return n >= m and b >> text(n - m, n) == p;
}

fn trim(string s) {
    mas b = s >> bytes;
    num i = 0;
    num j = b >> sz;
    while i < j and is_space(b >> get(i, 0)) {
        do(i >> ch(i + 1));
    }
    while j > i and is_space(b >> get(j - 1, 0)) {
        do(j >> ch(j - 1));
    }
    return b >> text(i, j);
}

fn split_lines(string s) {
    mas out = (string);
    mas b = s >> bytes;
    num n = b >> sz;
    num start = 0;
    num i = 0;
    while i < n {
        if b >> get(i, 0) == 10 {
            do(out >> add(b >> text(start, i)));
            do(start >> ch(i + 1));
        }
        do(i >> ch(i + 1));
    }
    do(out >> add(b >> text(start, n)));
    return out;
}

fn split(string s, num sep) {
    mas out = (string);
    if s == "" {
        return out;
    }
    mas b = s >> bytes;
    num n = b >> sz;
    num start = 0;
    num i = 0;
    while i < n {
        if b >> get(i, 0) == sep {
            do(out >> add(b >> text(start, i)));
            do(start >> ch(i + 1));
        }
        do(i >> ch(i + 1));
    }
    do(out >> add(b >> text(start, n)));
    return out;
}

fn hex(num v) {
    mas d = "0123456789abcdef" >> bytes;
    if v <= 0 {
        return "0";
    }
    string s = "";
    num x = v;
    while x > 0 {
        num r = x % 16;
        do(s >> ch(d >> text(r, r + 1) + s));
        do(x >> ch(x / 16));
    }
    return s;
}

fn mangle(string s) {
    mas b = s >> bytes;
    mas parts = (string);
    for k in 0:(b >> sz) - 1 {
        num c = b >> get(k, 0);
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 {
            do(parts >> add(b >> text(k, k + 1)));
        } else {
            do(parts >> add("_" + hex(c)));
        }
    }
    return parts >> join("");
}

fn asm_str(string s) {
    mas b = s >> bytes;
    mas parts = (string);
    do(parts >> add("\""));
    for k in 0:(b >> sz) - 1 {
        num c = b >> get(k, 0);
        if c == 34 {
            do(parts >> add("\\\""));
        } else if c == 92 {
            do(parts >> add("\\\\"));
        } else if c >= 32 and c < 127 {
            do(parts >> add(b >> text(k, k + 1)));
        } else {
            do(parts >> add("\\{c / 64}{(c / 8) % 8}{c % 8}"));
        }
    }
    do(parts >> add("\""));
    return parts >> join("");
}

# безопасная подстановка в команду shell: 'текст', а ' внутри → '\''
fn quote(string s) {
    mas b = s >> bytes;
    mas parts = (string);
    do(parts >> add("'"));
    for k in 0:(b >> sz) - 1 {
        if b >> get(k, 0) == 39 {
            do(parts >> add("'\\''"));
        } else {
            do(parts >> add(b >> text(k, k + 1)));
        }
    }
    do(parts >> add("'"));
    return parts >> join("");
}

fn source_index(num line) {
    num i = (SOURCE_START >> sz) - 1;
    while i >= 0 and (SOURCE_START >> get(i, 1)) > line {
        do(i >> ch(i - 1));
    }
    return i;
}

fn source_line(num line) {
    num start = SOURCE_START >> get(source_index(line), 1);
    return line - start + 1;
}

fn fail(string msg, num line) {
    string name = SOURCE_NAMES >> get(source_index(line), PATH);
    num local_line = source_line(line);
    print("Ошибка в {name}, строка {local_line}:");
    if line >= 1 and line <= SRCL >> sz {
        print("  {local_line} | {trim(SRCL >> get(line - 1, ''))}");
    }
    print("  {msg}");
    do(term >> exit(1));
}

# ═══════════════════════════ лексер ═══════════════════════════

fn is_kw(string w) {
    return w == "fn" or w == "num" or w == "dec" or w == "string" or w == "bool" or w == "mas" or w == "map"
        or w == "all" or w == "file" or w == "dir" or w == "bytes" or w == "proc" or w == "conn" or w == "server" or w == "do" or w == "print" or w == "if"
        or w == "else" or w == "while" or w == "for" or w == "in" or w == "return" or w == "true"
        or w == "false" or w == "and" or w == "or" or w == "not" or w == "break" or w == "next" or w == "recover"
        or w == "pick" or w == "thread" or w == "lock";
}

fn is_type(string w) {
    return w == "num" or w == "dec" or w == "string" or w == "bool" or w == "mas" or w == "map" or w == "all"
        or w == "file" or w == "dir" or w == "bytes" or w == "proc" or w == "conn" or w == "server" or w == "lock";
}

fn is_base(string w) {
    return w == "num" or w == "dec" or w == "string" or w == "bool";
}

fn digit(num c) {
    return c >= 48 and c <= 57;
}

fn hexval(num c) {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 102 {
        return c - 87;
    }
    if c >= 65 and c <= 70 {
        return c - 55;
    }
    return -1;
}

fn alpha(num c) {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c >= 128;
}

fn tok(string k, string v, num n, num line) {
    do(TK >> add(k));
    do(TV >> add(v));
    do(TN >> add(n));
    do(TL >> add(line));
}

fn char_len(num c) {
    if c >= 240 {
        return 4;
    }
    if c >= 224 {
        return 3;
    }
    if c >= 192 {
        return 2;
    }
    return 1;
}

fn smart_quote(mas b, num i) {
    num c = b >> get(i, 0);
    num c1 = b >> get(i + 1, 0);
    num c2 = b >> get(i + 2, 0);
    if c == 226 and c1 == 128 and (c2 == 152 or c2 == 153 or c2 == 156 or c2 == 157 or c2 == 158) {
        return true;
    }
    return c == 194 and (c1 == 171 or c1 == 187);
}

fn escape(num e) {
    if e == 110 {
        return "\n";
    }
    if e == 116 {
        return "\t";
    }
    if e == 114 {
        mas carriage = (13);
        return carriage >> text(0, 1);
    }
    if e == 92 {
        return "\\";
    }
    if e == 34 {
        return "\"";
    }
    if e == 39 {
        return "'";
    }
    return "";
}

fn is_sym1(string s) {
    return s == "(" or s == ")" or s == "{{" or s == "}}" or s == ";" or s == "=" or s == ","
        or s == ":" or s == "+" or s == "-" or s == "*" or s == "/" or s == "%" or s == "<" or s == ">";
}

fn lex(string src, num line0, bool interpolation) {
    num start = TK >> sz;
    mas b = src >> bytes;
    num n = b >> sz;
    num i = 0;
    num line = line0;
    while i < n {
        num c = b >> get(i, 0);
        if c == 10 {
            do(line >> ch(line + 1));
            do(i >> ch(i + 1));
        } else if c == 32 or c == 9 or c == 13 {
            do(i >> ch(i + 1));
        } else if c == 35 {
            while i < n and b >> get(i, 0) != 10 {
                do(i >> ch(i + 1));
            }
        } else if c == 48 and (b >> get(i + 1, 0) == 120 or b >> get(i + 1, 0) == 88) {
            num j = i + 2;
            num v = 0;
            bool big = false;
            while j < n and hexval(b >> get(j, 0)) >= 0 {
                num d = hexval(b >> get(j, 0));
                if big or v > (MAXV - d) / 16 {
                    do(big >> ch(true));
                } else {
                    do(v >> ch(v * 16 + d));
                }
                do(j >> ch(j + 1));
            }
            if j == i + 2 {
                do(fail("после 0x нужны шестнадцатеричные цифры, например 0x1f", line));
            }
            if big {
                do(fail("число слишком большое для num (максимум 0x7fffffffffffffff)", line));
            }
            do(tok("num", b >> text(i, j), v, line));
            do(i >> ch(j));
        } else if digit(c) {
            num j = i;
            while j < n and digit(b >> get(j, 0)) {
                do(j >> ch(j + 1));
            }
            if j + 1 < n and b >> get(j, 0) == 46 and digit(b >> get(j + 1, 0)) {
                do(j >> ch(j + 1));
                while j < n and digit(b >> get(j, 0)) {
                    do(j >> ch(j + 1));
                }
                do(tok("dec", b >> text(i, j), 0, line));
            } else {
                num v = 0;
                num k = i;
                bool big = false;
                while k < j {
                    num d = b >> get(k, 48) - 48;
                    if big or v > (MAXV - d) / 10 {
                        do(big >> ch(true));
                    } else {
                        do(v >> ch(v * 10 + d));
                    }
                    do(k >> ch(k + 1));
                }
                string txt = b >> text(i, j);
                if big and txt != "9223372036854775808" {
                    do(fail("число слишком большое для num (максимум 9223372036854775807)", line));
                }
                if big {
                    do(v >> ch(MINV));
                }
                do(tok("num", txt, v, line));
            }
            do(i >> ch(j));
        } else if smart_quote(b, i) {
            do(fail("кавычка {b >> text(i, i + char_len(c))} не подходит — используй \" или '", line));
        } else if alpha(c) {
            num j = i;
            while j < n and (alpha(b >> get(j, 0)) or digit(b >> get(j, 0))) {
                do(j >> ch(j + 1));
            }
            string w = b >> text(i, j);
            if is_kw(w) {
                do(tok("kw", w, 0, line));
            } else {
                do(tok("id", w, 0, line));
            }
            do(i >> ch(j));
        } else if c == 34 or c == 39 {
            num j = i + 1;
            num seg = j;
            mas parts = (string);
            bool done = false;
            while not done {
                num cc = b >> get(j, -1);
                if cc == -1 or (cc == 10 and not interpolation) {
                    string q = "\"";
                    if c == 39 {
                        do(q >> ch("'"));
                    }
                    do(fail("строка не закрыта — не хватает кавычки {q}", line));
                    do(done >> ch(true));
                } else if cc == c {
                    do(done >> ch(true));
                } else if cc == 92 and j + 1 < n {
                    num e = b >> get(j + 1, 0);
                    do(parts >> add(b >> text(seg, j)));
                    string es = escape(e);
                    if es == "" {
                        do(parts >> add("\\" + b >> text(j + 1, j + 1 + char_len(e))));
                        do(j >> ch(j + 1 + char_len(e)));
                    } else {
                        do(parts >> add(es));
                        do(j >> ch(j + 2));
                    }
                    do(seg >> ch(j));
                } else {
                    do(j >> ch(j + 1));
                }
            }
            do(parts >> add(b >> text(seg, j)));
            do(tok("str", parts >> join(""), 0, line));
            do(i >> ch(j + 1));
        } else {
            string two = b >> text(i, i + 2);
            string one = b >> text(i, i + 1);
            if two == ">>" or two == "->" or two == "==" or two == "!=" or two == "<=" or two == ">=" {
                do(tok("sym", two, 0, line));
                do(i >> ch(i + 2));
            } else if is_sym1(one) {
                do(tok("sym", one, 0, line));
                do(i >> ch(i + 1));
            } else {
                do(fail("непонятный символ '{b >> text(i, i + char_len(c))}'", line));
                do(i >> ch(i + 1));
            }
        }
    }
    do(tok("eof", "", 0, line));
    return start;
}

# ═══════════════════════════ парсер ═══════════════════════════

fn pk(num k) {
    return TK >> get(P + k, "eof");
}

fn pv(num k) {
    return TV >> get(P + k, "");
}

fn pl(num k) {
    num i = P + k;
    if i >= TL >> sz {
        return TL >> get((TL >> sz) - 1, 1);
    }
    return TL >> get(i, 1);
}

fn at(string v) {
    string k = pk(0);
    return (k == "sym" or k == "kw") and pv(0) == v;
}

fn atk(string v, num k) {
    string kk = pk(k);
    return (kk == "sym" or kk == "kw") and pv(k) == v;
}

fn take() {
    num t = P;
    do(P >> ch(P + 1));
    return t;
}

fn describe(num t) {
    string k = TK >> get(t, "eof");
    if k == "eof" {
        return "конец файла";
    }
    if k == "str" {
        return "строка";
    }
    return "'{TV >> get(t, '')}'";
}

fn expect(string v, string hint) {
    if not at(v) {
        string msg = "ожидалось '{v}', а тут {describe(P)}";
        if hint != "" {
            do(msg >> ch(msg + " — " + hint));
        }
        do(fail(msg, pl(0)));
    }
    return take();
}

fn pend() {
    if not at(";") {
        do(fail("не хватает ';' — в bit каждая команда заканчивается на ;", TL >> get(P - 1, 1)));
    }
    do(take());
}

fn pname(string what) {
    string k = pk(0);
    if k != "id" {
        if k == "kw" {
            do(fail("'{pv(0)}' — служебное слово, его нельзя взять как {what}", pl(0)));
        }
        do(fail("ожидалось {what}, а тут {describe(P)}", pl(0)));
    }
    string v = pv(0);
    do(take());
    return v;
}

fn node(string k, num line) {
    num n = NK >> sz;
    do(NK >> add(k));
    do(NS >> add(""));
    do(NT >> add(""));
    do(NM >> add(""));
    do(NV >> add(0));
    do(NA >> add(-1));
    do(NB >> add(-1));
    do(L1 >> add(0));
    do(C1 >> add(0));
    do(L2 >> add(0));
    do(C2 >> add(0));
    do(NL >> add(line));
    return n;
}

fn kind(num n) {
    return NK >> get(n, "");
}

fn fs(num n) {
    return NS >> get(n, "");
}

fn ft(num n) {
    return NT >> get(n, "");
}

fn fm(num n) {
    return NM >> get(n, "");
}

fn fv(num n) {
    return NV >> get(n, 0);
}

fn fa(num n) {
    return NA >> get(n, -1);
}

fn fb(num n) {
    return NB >> get(n, -1);
}

fn ln(num n) {
    return NL >> get(n, 0);
}

fn l1(num n) {
    return L1 >> get(n, 0);
}

fn c1(num n) {
    return C1 >> get(n, 0);
}

fn l2(num n) {
    return L2 >> get(n, 0);
}

fn c2(num n) {
    return C2 >> get(n, 0);
}

fn item(num start, num k) {
    return LST >> get(start + k, -1);
}

fn arg(num n, num k) {
    return LST >> get(l1(n) + k, -1);
}

fn mklist(mas items) {
    num s = LST >> sz;
    for x in items {
        do(LST >> add(x));
    }
    return s;
}

fn setl1(num n, mas items) {
    do(mset(L1, n, mklist(items)));
    do(mset(C1, n, items >> sz));
}

fn setl2(num n, mas items) {
    do(mset(L2, n, mklist(items)));
    do(mset(C2, n, items >> sz));
}

fn record_by_name(string name) {
    for r in RECORDS {
        if fs(r) == name {
            return r;
        }
    }
    return -1;
}

fn array_element(string ty) {
    return is_base(ty) or record_by_name(ty) >= 0;
}

fn builtin_records() {
    num r = node("record", 1);
    do(mset(NS, r, "FileInfo"));
    mas fields = (num);
    mas names = ("path", "sz", "modified");
    for name in names {
        num field = node("field", 1);
        do(mset(NS, field, name));
        string ty = "num";
        if name == "path" {
            do(ty >> ch("string"));
        }
        do(mset(NT, field, ty));
        do(fields >> add(field));
    }
    do(setl1(r, fields));
    do(RECORDS >> add(r));
}

fn declared_type() {
    return (pk(0) == "kw" and is_type(pv(0))) or (pk(0) == "id" and record_by_name(pv(0)) >= 0);
}

fn record_def() {
    num header = pl(0);
    do(take());
    string name = pname("имя структуры");
    if name == "main" or name == "host" or name == "record" or name == "use"
        or record_by_name(name) >= 0 or fn_by_name(name) >= 0 {
        do(fail("имя структуры {name} уже занято", header));
    }
    num r = node("record", header);
    do(mset(NS, r, name));
    num colon = pl(0);
    do(expect(":", "после имени структуры нужно ':'"));
    num base = source_indent(header);
    num width = source_indent(pl(0));
    if pk(0) == "eof" or pl(0) <= colon or width <= base {
        do(fail("после ':' нужны поля структуры с отступом", colon));
    }
    mas fields = (num);
    while pk(0) != "eof" and source_indent(pl(0)) > base {
        num line = pl(0);
        if source_indent(line) != width or not declared_type() {
            do(fail("поле структуры пишется с типом и тем же отступом, например num x;", line));
        }
        string ty = pv(0);
        do(take());
        if ty == "all" {
            do(fail("в поле структуры нужен явный тип", line));
        }
        if ty == "mas" or ty == "map" {
            do(expect("(", "в поле нужен тип элемента, например {ty}(num)"));
            string el = pv(0);
            if not declared_type() or (ty == "mas" and not array_element(el)) or (ty == "map" and not plain(el)) {
                do(fail("у поля {ty} нужен конкретный тип элемента", pl(0)));
            }
            do(take());
            do(expect(")", ""));
            do(ty >> ch(ty + ":" + el));
        }
        string field = pname("имя поля");
        if field == "ch" or field == "input" {
            do(fail("имя поля {field} занято встроенной операцией", line));
        }
        for f in fields {
            if fs(f) == field {
                do(fail("поле {field} уже объявлено", line));
            }
        }
        do(pend());
        num f = node("field", line);
        do(mset(NS, f, field));
        do(mset(NT, f, ty));
        do(fields >> add(f));
    }
    do(setl1(r, fields));
    do(RECORDS >> add(r));
}

fn normalize_source_path(string path) {
    mas parts = (string);
    for part in split(path, 47) {
        if part == ".." {
            do(parts >> pop);
        } else if part != "" and part != "." {
            do(parts >> add(part));
        }
    }
    return "/" + (parts >> join("/"));
}

fn source_folder(string path) {
    mas b = path >> bytes;
    num i = (b >> sz) - 1;
    while i >= 0 and (b >> get(i, 0)) != 47 {
        do(i >> ch(i - 1));
    }
    return b >> text(0, i + 1);
}

fn add_source(string path, string text) {
    num first = (SRCL >> sz) + 1;
    do(SOURCE_NAMES >> add(path));
    do(SOURCE_START >> add(first));
    for line in split_lines(text) {
        do(SRCL >> add(line));
    }
    return lex(text, first, false);
}

fn source_use(string parent) {
    num line = pl(0);
    do(take());
    if pk(0) != "str" {
        do(fail("модуль подключается так: use \"путь.bit\";", line));
    }
    num path_node = primary_p();
    num part = item(l1(path_node), 0);
    if c1(path_node) != 1 or kind(part) != "lit" or fs(part) == "" {
        do(fail("в use нужен непустой путь без интерполяции", line));
    }
    string path = fs(part);
    do(pend());
    if not starts(path, "/") {
        do(path >> ch(source_folder(parent) + path));
    }
    do(path >> ch(normalize_source_path(path)));
    if SOURCES_ACTIVE >> has(path) {
        do(fail("циклическое подключение модуля {path}", line));
    }
    if SOURCES_LOADED >> has(path) {
        return;
    }
    file module = path;
    if not (module >> exists) {
        do(fail("не могу открыть модуль {path}", line));
    }
    num saved = P;
    do(SOURCES_ACTIVE >> add(path));
    string text = "";
    recover {
        do(text >> ch(module >> read));
    } else {
        do(fail("не могу прочитать модуль {path}: {term >> error}", line));
    }
    do(P >> ch(add_source(path, text)));
    do(program(path, false));
    do(P >> ch(saved));
    do(SOURCES_ACTIVE >> pop);
    do(SOURCES_LOADED >> add(path));
}

fn program(string path, bool entry) {
    while pk(0) != "eof" {
        if at("fn") {
            do(FNS >> add(function()));
        } else if pv(0) == "host" and atk("{{", 1) {
            if not entry {
                do(fail("host {{ }} разрешён только в главном файле", pl(0)));
            }
            do(FNS >> add(host_block()));
        } else if pk(0) == "id" and pv(0) == "use" {
            do(source_use(path));
        } else if pk(0) == "id" and pv(0) == "record" {
            do(record_def());
        } else if declared_type() {
            do(GLOBS >> add(decl()));
        } else {
            do(fail("вне функции может быть только fn, host {{ }} или переменная, а тут {describe(P)}", pl(0)));
        }
    }
}

# host { ... } — точка входа; внутри это обычная функция с именем main
fn host_block() {
    num line = pl(0);
    do(take());                          # host
    num n = node("fn", line);
    do(mset(NS, n, "main"));
    mas ps = (num);
    do(setl1(n, ps));
    mas body = brace_block();
    do(setl2(n, body));
    return n;
}

fn function() {
    num line = pl(0);
    do(take());
    num n = node("fn", line);
    string fnm = pname("имя функции");
    if fnm == "main" {
        do(fail("точка входа пишется как host {{ }}, а не fn main", line));
    }
    if record_by_name(fnm) >= 0 {
        do(fail("имя {fnm} уже занято структурой", line));
    }
    do(mset(NS, n, fnm));
    mas ps = (num);
    if at("(") {
        do(take());
        while not at(")") {
            if not declared_type() {
                do(fail("у параметра нужен тип: num, dec, string, bool, mas или all", pl(0)));
            }
            string ty = pv(0);
            do(take());
            num p = node("param", pl(0));
            do(mset(NT, p, ty));
            do(mset(NS, p, pname("имя параметра")));
            do(ps >> add(p));
            if not at(")") {
                do(expect(",", ""));
            }
        }
        do(take());
    }
    do(setl1(n, ps));
    mas body = pblock(line);
    do(setl2(n, body));
    return n;
}

fn brace_block() {
    do(expect("{{", ""));
    mas st = (num);
    while not at("}}") {
        if pk(0) == "eof" {
            do(fail("не хватает закрывающей '}}'", pl(0)));
        }
        do(st >> add(statement(false)));
    }
    do(take());
    return st;
}

fn source_indent(num line) {
    mas b = SRCL >> get(line - 1, "") >> bytes;
    num i = 0;
    num width = 0;
    while true {
        num c = b >> get(i, 0);
        if c == 32 {
            do(width >> ch(width + 1));
        } else if c == 9 {
            do(width >> ch(width + 4 - width % 4));
        } else {
            return width;
        }
        do(i >> ch(i + 1));
    }
    return width;
}

fn pblock(num header) {
    if not at(":") {
        return brace_block();
    }
    num colon_line = pl(0);
    do(take());
    num base = source_indent(header);
    num width = source_indent(pl(0));
    if pk(0) == "eof" or at("}}") or pl(0) <= colon_line or width <= base {
        do(fail("после ':' нужен блок с отступом на следующей строке", colon_line));
    }
    mas st = (num);
    while pk(0) != "eof" and not at("}}") {
        num col = source_indent(pl(0));
        if col <= base {
            return st;
        }
        if col != width {
            do(fail("неверный отступ внутри блока", pl(0)));
        }
        do(st >> add(statement(true)));
    }
    return st;
}

# For a split range, its right operand can still start on the next line.
fn for_range() {
    if not at(":") {
        return false;
    }
    string k = pk(1);
    return (k != "eof" and pl(1) == pl(0)) or k == "num" or k == "dec" or k == "str" or k == "id"
        or (k == "sym" and (pv(1) == "(" or pv(1) == "-"))
        or (k == "kw" and (pv(1) == "true" or pv(1) == "false" or pv(1) == "not"));
}

fn block_else(num header, bool layout) {
    return at("else") and (not layout or source_indent(pl(0)) == source_indent(header));
}

fn statement(bool layout) {
    string k = pk(0);
    string v = pv(0);
    num line = pl(0);
    if declared_type() {
        return decl();
    }
    if k == "kw" {
        if v == "do" {
            do(take());
            do(expect("(", ""));
            num e = expr_p();
            do(expect(")", ""));
            do(pend());
            num n = node("do", line);
            do(mset(NA, n, e));
            return n;
        }
        if v == "print" {
            do(take());
            do(expect("(", "print пишется так: print(\"текст\");"));
            num e = expr_p();
            do(expect(")", ""));
            do(pend());
            num n = node("print", line);
            do(mset(NA, n, e));
            return n;
        }
        if v == "if" {
            return if_stmt(layout);
        }
        if v == "pick" {
            return pick_stmt(layout);
        }
        if v == "thread" {
            return thread_stmt();
        }
        if v == "while" {
            do(take());
            num cond = expr_p();
            mas body = pblock(line);
            num n = node("while", line);
            do(mset(NA, n, cond));
            do(setl1(n, body));
            return n;
        }
        if v == "for" {
            do(take());
            string var = pname("имя переменной цикла");
            do(expect("in", ""));
            num a = expr_p();
            num b = -1;
            if for_range() {
                do(take());
                do(b >> ch(expr_p()));
            }
            mas body = pblock(line);
            num n = node("for", line);
            do(mset(NS, n, var));
            do(mset(NA, n, a));
            do(mset(NB, n, b));
            do(setl1(n, body));
            return n;
        }
        if v == "return" {
            do(take());
            num e = -1;
            if not at(";") {
                do(e >> ch(expr_p()));
            }
            do(pend());
            num n = node("return", line);
            do(mset(NA, n, e));
            return n;
        }
        if v == "recover" {
            do(take());
            bool aligned = layout or at(":");
            mas body = pblock(line);
            num else_line = pl(0);
            if aligned and at("else") and not block_else(line, true) {
                do(fail("else должен быть на одном отступе с recover", else_line));
            }
            do(expect("else", "после recover {{ }} нужен else {{ }} на случай сбоя"));
            mas failb = pblock(else_line);
            num n = node("recover", line);
            do(setl1(n, body));
            do(setl2(n, failb));
            return n;
        }
        if v == "break" {
            do(take());
            do(pend());
            return node("break", line);
        }
        if v == "next" {
            do(take());
            do(pend());
            return node("next", line);
        }
        if v == "fn" {
            do(fail("функцию нельзя объявлять внутри другой функции", line));
        }
    }
    if k == "id" and atk("=", 1) {
        do(fail("менять значение можно только через ch: do({v} >> ch(...));", line));
    }
    do(expr_p());
    do(fail("действие нужно обернуть в do(...), например do(x >> ch(5));", line));
    return -1;
}

fn thread_stmt() {
    num line = pl(0);
    do(take());
    string name = pname("имя потока");
    mas body = pblock(line);
    mas params = (num);
    num f = node("fn", line);
    string fname = "@thread_{f}";
    do(mset(NS, f, fname));
    do(setl1(f, params));
    do(setl2(f, body));
    do(FNS >> add(f));
    num n = node("spawn", line);
    do(mset(NS, n, name));
    do(mset(NA, n, f));
    return n;
}

fn pick_stmt(bool layout) {
    num line = pl(0);
    do(take());
    num subj = expr_p();
    if at(":") {
        do(fail("pick пишется с фигурными скобками: pick x {{ 1 {{ ... }} else {{ ... }} }}", pl(0)));
    }
    do(expect("{{", "после pick нужен блок со значениями"));
    mas cases = (num);
    bool has_else = false;
    mas else_body = (num);
    while not at("}}") and pk(0) != "eof" {
        num cl = pl(0);
        if at("else") {
            do(take());
            do(else_body >> ch(pblock(cl)));
            do(has_else >> ch(true));
            break;
        }
        mas vals = (num);
        do(vals >> add(expr_p()));
        while at(",") {
            do(take());
            do(vals >> add(expr_p()));
        }
        mas body = pblock(cl);
        num c = node("pickcase", cl);
        do(setl1(c, vals));
        do(setl2(c, body));
        do(cases >> add(c));
    }
    do(expect("}}", "pick не закрыт — нужна закрывающая скобка"));
    num n = node("pick", line);
    do(mset(NA, n, subj));
    do(setl1(n, cases));
    if has_else {
        do(mset(NM, n, "else"));
        do(setl2(n, else_body));
    }
    return n;
}

fn if_stmt(bool layout) {
    num line = pl(0);
    do(take());
    num cond = expr_p();
    bool aligned = layout or at(":");
    mas then = pblock(line);
    num n = node("if", line);
    do(mset(NA, n, cond));
    do(setl1(n, then));
    if block_else(line, aligned) {
        num else_line = pl(0);
        do(take());
        do(mset(NM, n, "else"));
        if at("if") {
            mas e = (num);
            do(e >> add(if_stmt(aligned)));
            do(setl2(n, e));
        } else {
            mas e = pblock(else_line);
            do(setl2(n, e));
        }
    }
    return n;
}

fn decl() {
    num t = take();
    string ty = TV >> get(t, "");
    num dl = TL >> get(t, 0);
    mas items = (num);
    bool more = true;
    while more {
        num line = pl(0);
        string name = pname("имя переменной");
        num it = node("item", line);
        do(mset(NS, it, name));
        do(mset(NT, it, ty));
        do(mset(NV, it, -1));
        if ty == "lock" and not at("=") {
            do(mset(NM, it, "lock"));
        } else if at("(") {
            do(take());
            num limit = -1;
            if not at(")") {
                num lt = take();
                if ty != "mas" {
                    do(fail("у {ty} в скобках ничего не пишут: {ty} {name}(); — пустая переменная", TL >> get(lt, 0)));
                }
                if TK >> get(lt, "") != "num" {
                    do(fail("в mas a(...) пишется число — максимум элементов", TL >> get(lt, 0)));
                }
                do(limit >> ch(TN >> get(lt, 0)));
            }
            do(expect(")", ""));
            if ty == "mas" {
                if limit == -1 {
                    do(fail("пустой массив без лимита пишется так: mas {name} = ();", line));
                }
                do(mset(NM, it, "mas"));
                do(mset(NV, it, limit));
                if at("=") {
                    do(take());
                    do(mset(NA, it, mas_init()));
                }
            } else {
                if ty == "all" {
                    do(fail("all нельзя сделать пустой — тип берётся из значения: all x = 5;", line));
                }
                if ty == "map" {
                    do(fail("пустой словарь: map {name} = (num), (dec), (string) или (bool)", line));
                }
                do(mset(NM, it, "empty"));
            }
        } else if at("=") {
            do(take());
            if ty == "mas" {
                do(mset(NM, it, "mas"));
                do(mset(NA, it, mas_init()));
            } else if ty == "map" {
                do(mset(NM, it, "map"));
                do(mset(NA, it, map_init()));
            } else {
                do(mset(NM, it, "value"));
                do(mset(NA, it, expr_p()));
            }
        } else if at(">>") {
            do(take());
            num m = method(-1);
            if fs(m) != "input" {
                do(fail("при создании переменной через >> можно только input, а тут {fs(m)}", ln(m)));
            }
            if ty == "all" or ty == "mas" or ty == "map" {
                do(fail("для input нужен точный тип: num, dec, string или bool", line));
            }
            do(mset(NM, it, "input"));
            do(mset(NA, it, m));
        } else {
            do(fail("после {name} нужно '= значение', '()' или '>> input()'", pl(0)));
        }
        do(items >> add(it));
        if at(",") {
            do(take());
        } else {
            do(more >> ch(false));
        }
    }
    do(pend());
    num n = node("decl", dl);
    do(setl1(n, items));
    return n;
}

fn map_init() {
    if at("(") and (pk(1) == "kw" or pk(1) == "id") and plain(pv(1)) and atk(")", 2) {
        num line = pl(0);
        string ty = pv(1);
        do(take());
        do(take());
        do(take());
        num n = node("maslit", line);
        do(mset(NT, n, ty));
        return n;
    }
    return expr_p();
}

fn mas_init() {
    if at("(") and (pk(1) == "kw" or pk(1) == "id") and array_element(pv(1)) and atk(")", 2) {
        num line = pl(0);
        do(take());
        string ty = pv(0);
        do(take());
        do(take());
        num n = node("maslit", line);
        do(mset(NT, n, ty));
        return n;
    }
    if at("(") {
        num line = pl(0);
        do(take());
        mas el = (num);
        while not at(")") {
            do(el >> add(expr_p()));
            if not at(")") {
                do(expect(",", ""));
            }
        }
        do(take());
        num n = node("maslit", line);
        do(setl1(n, el));
        return n;
    }
    return expr_p();
}

fn method(num obj) {
    string k = pk(0);
    if k != "id" and not (k == "kw" and (pv(0) == "file" or pv(0) == "dir" or pv(0) == "bytes" or pv(0) == "proc" or pv(0) == "num")) {
        do(fail("после >> нужно действие (get, add, ch, sz, input), а тут {describe(P)}", pl(0)));
    }
    num line = pl(0);
    string name = pv(0);
    do(take());
    mas args = (num);
    if at("(") {
        do(take());
        while not at(")") {
            num a = expr_p();
            if at(":") {
                do(take());
                num r = node("range", ln(a));
                do(mset(NA, r, a));
                do(mset(NB, r, expr_p()));
                do(a >> ch(r));
            }
            do(args >> add(a));
            if not at(")") {
                do(expect(",", ""));
            }
        }
        do(take());
    }
    num n = node("pipe", line);
    do(mset(NA, n, obj));
    do(mset(NS, n, name));
    do(setl1(n, args));
    return n;
}

fn bin(string op, num line, num l, num r) {
    num n = node("bin", line);
    do(mset(NS, n, op));
    do(mset(NA, n, l));
    do(mset(NB, n, r));
    return n;
}

fn expr_p() {
    num e = and_p();
    while at("or") {
        num line = pl(0);
        do(take());
        do(e >> ch(bin("or", line, e, and_p())));
    }
    return e;
}

fn and_p() {
    num e = not_p();
    while at("and") {
        num line = pl(0);
        do(take());
        do(e >> ch(bin("and", line, e, not_p())));
    }
    return e;
}

fn not_p() {
    if at("not") {
        num line = pl(0);
        do(take());
        num n = node("un", line);
        do(mset(NS, n, "not"));
        do(mset(NA, n, not_p()));
        return n;
    }
    return cmp_p();
}

fn is_cmp(string s) {
    return s == "<" or s == ">" or s == "<=" or s == ">=" or s == "==" or s == "!=";
}

fn cmp_p() {
    num e = add_p();
    if (pk(0) == "sym") and is_cmp(pv(0)) {
        num line = pl(0);
        string op = pv(0);
        do(take());
        do(e >> ch(bin(op, line, e, add_p())));
        if (pk(0) == "sym") and is_cmp(pv(0)) {
            do(fail("сравнения нельзя писать цепочкой — соедини через and", line));
        }
    }
    return e;
}

fn add_p() {
    num e = mul_p();
    while at("+") or at("-") {
        num line = pl(0);
        string op = pv(0);
        do(take());
        do(e >> ch(bin(op, line, e, mul_p())));
    }
    return e;
}

fn mul_p() {
    num e = unary_p();
    while at("*") or at("/") or at("%") {
        num line = pl(0);
        string op = pv(0);
        do(take());
        do(e >> ch(bin(op, line, e, unary_p())));
    }
    return e;
}

fn unary_p() {
    if at("-") and pk(1) == "num" and pv(1) == "9223372036854775808" {
        num line = pl(0);
        do(take());
        do(take());
        num n = node("num", line);
        do(mset(NV, n, MINV));
        do(mset(NS, n, "-9223372036854775808"));
        return n;
    }
    if at("-") {
        num line = pl(0);
        do(take());
        num n = node("un", line);
        do(mset(NS, n, "-"));
        do(mset(NA, n, unary_p()));
        return n;
    }
    return postfix_p();
}

fn postfix_p() {
    num e = primary_p();
    while at(">>") {
        do(take());
        do(e >> ch(method(e)));
    }
    return e;
}

fn lambda_value(bool typed) {
    num line = pl(0);
    mas params = (num);
    if typed {
        do(expect("(", ""));
        while not at(")") {
            if not declared_type() {
                do(fail("у параметра анонимной функции нужен тип", pl(0)));
            }
            num param = node("param", pl(0));
            do(mset(NT, param, pv(0)));
            do(take());
            do(mset(NS, param, pname("имя параметра")));
            do(params >> add(param));
            if not at(")") {
                do(expect(",", ""));
            }
        }
        do(take());
    } else {
        num param = node("param", line);
        do(mset(NT, param, "num"));
        do(mset(NS, param, pname("имя параметра")));
        do(params >> add(param));
    }
    do(expect("->", ""));
    num value = expr_p();
    num ret = node("return", line);
    do(mset(NA, ret, value));
    num f = node("fn", line);
    string name = "@lambda_{f}";
    do(mset(NS, f, name));
    do(setl1(f, params));
    mas body = (ret);
    do(setl2(f, body));
    do(FNS >> add(f));
    num n = node("var", line);
    do(mset(NS, n, name));
    return n;
}

fn primary_p() {
    string k = pk(0);
    num line = pl(0);
    if k == "num" {
        if pv(0) == "9223372036854775808" {
            do(fail("число слишком большое для num (максимум 9223372036854775807)", line));
        }
        num t = take();
        num n = node("num", line);
        do(mset(NV, n, TN >> get(t, 0)));
        do(mset(NS, n, TV >> get(t, "")));
        return n;
    }
    if k == "dec" {
        num t = take();
        num n = node("dec", line);
        do(mset(NS, n, TV >> get(t, "")));
        return n;
    }
    if k == "str" {
        num t = take();
        return interp(TV >> get(t, ""), line);
    }
    if at("true") or at("false") {
        num n = node("bool", line);
        if at("true") {
            do(mset(NV, n, 1));
        }
        do(take());
        return n;
    }
    if k == "id" and atk("->", 1) {
        return lambda_value(false);
    }
    if k == "id" {
        string name = pv(0);
        do(take());
        if at("(") {
            do(take());
            mas args = (num);
            while not at(")") {
                do(args >> add(expr_p()));
                if not at(")") {
                    do(expect(",", ""));
                }
            }
            do(take());
            num n = node("call", line);
            do(mset(NS, n, name));
            do(setl1(n, args));
            return n;
        }
        num n = node("var", line);
        do(mset(NS, n, name));
        return n;
    }
    if at("(") {
        if (atk(")", 1) and atk("->", 2))
            or (pk(2) == "id" and ((pk(1) == "kw" and is_type(pv(1))) or record_by_name(pv(1)) >= 0)) {
            return lambda_value(true);
        }
        do(take());
        num e = expr_p();
        do(expect(")", ""));
        return e;
    }
    if at("print") {
        do(fail("print — это команда, её нельзя вставить внутрь выражения", line));
    }
    do(fail("ожидалось значение, а тут {describe(P)}", line));
    return -1;
}

fn lit(string s, num line) {
    num n = node("lit", line);
    do(mset(NS, n, s));
    return n;
}

fn interp(string raw, num line) {
    mas b = raw >> bytes;
    num n = b >> sz;
    mas parts = (num);
    mas buf = (string);
    num seg = 0;
    num i = 0;
    while i < n {
        num c = b >> get(i, 0);
        if c == 123 {
            if b >> get(i + 1, 0) == 123 {
                do(buf >> add(b >> text(seg, i)));
                do(buf >> add("{{"));
                do(i >> ch(i + 2));
                do(seg >> ch(i));
            } else {
                num depth = 1;
                num j = i + 1;
                num quote_char = 0;
                while j < n and depth > 0 {
                    num cc = b >> get(j, 0);
                    if quote_char != 0 {
                        if cc == 92 {
                            do(j >> ch(j + 1));
                        } else if cc == quote_char {
                            do(quote_char >> ch(0));
                        }
                    } else if cc == 34 or cc == 39 {
                        do(quote_char >> ch(cc));
                    } else if cc == 123 {
                        do(depth >> ch(depth + 1));
                    } else if cc == 125 {
                        do(depth >> ch(depth - 1));
                    }
                    do(j >> ch(j + 1));
                }
                if depth > 0 {
                    do(fail("в строке не закрыта '{{' — для самой скобки пиши {{{{", line));
                }
                string inner = trim(b >> text(i + 1, j - 1));
                if inner == "" {
                    do(fail("пустые {{}} в строке — внутри должна быть переменная", line));
                }
                do(buf >> add(b >> text(seg, i)));
                string bs = buf >> join("");
                if bs != "" {
                    do(parts >> add(lit(bs, line)));
                }
                mas fresh = (string);
                do(buf >> ch(fresh));
                num savep = P;
                do(P >> ch(lex(inner, line, true)));
                num e = expr_p();
                if pk(0) != "eof" {
                    do(fail("не понял, что вставить в строку: {{{inner}}}", line));
                }
                do(P >> ch(savep));
                do(parts >> add(e));
                do(i >> ch(j));
                do(seg >> ch(i));
            }
        } else if c == 125 {
            if b >> get(i + 1, 0) == 125 {
                do(buf >> add(b >> text(seg, i)));
                do(buf >> add("}}"));
                do(i >> ch(i + 2));
                do(seg >> ch(i));
            } else {
                do(fail("лишняя '}}' в строке — для самой скобки пиши }}}}", line));
                do(i >> ch(i + 1));
            }
        } else {
            do(i >> ch(i + 1));
        }
    }
    do(buf >> add(b >> text(seg, n)));
    string rest = buf >> join("");
    if rest != "" or parts >> sz == 0 {
        do(parts >> add(lit(rest, line)));
    }
    num r = node("str", line);
    do(setl1(r, parts));
    return r;
}

# ═══════════════════════ типы и диапазоны ═══════════════════════

fn is_mas(string t) {
    return t >> bytes >> text(0, 4) == "mas:";
}

fn is_map(string t) {
    return starts(t, "map:");
}

fn is_fn_value(string t) {
    return starts(t, "fn:");
}

fn elem(string t) {
    if t == "bytes" {
        return "num";
    }
    return t >> bytes >> text(4, 1000);
}

# массив или bytes: у обоих есть номера, sz, get, set, add
fn is_seq(string t) {
    return is_mas(t) or t == "bytes";
}

fn tn(string t) {
    if t == "void" {
        return "ничего";
    }
    if t == "mas:?" {
        return "пустой mas";
    }
    if is_mas(t) {
        return "mas из {elem(t)}";
    }
    return t;
}

fn is_path(string t) {
    return t == "string" or t == "file" or t == "dir";
}

fn is_numt(string t) {
    return t == "num" or t == "dec";
}

fn kind_of(string e) {
    if e == "num" {
        return 0;
    }
    if e == "dec" {
        return 1;
    }
    if e == "string" {
        return 2;
    }
    return 3;
}

fn res(string t) {
    do(RFRESH >> ch(false));
    do(RMSZ >> ch(-1));
    do(RT >> ch(t));
    do(RV >> ch(-1));
    do(RLK >> ch(false));
    do(RHK >> ch(false));
}

fn resv(string t, num v) {
    do(res(t));
    do(RV >> ch(v));
}

fn rng(bool lk, num l, bool hk, num h) {
    do(RLK >> ch(lk));
    do(RL >> ch(l));
    do(RHK >> ch(hk));
    do(RH >> ch(h));
}

# расширенные числа: XF = 0 точно, 1 больше максимума, -1 меньше минимума
fn xadd(num a, num b) {
    if b > 0 and a > MAXV - b {
        do(XF >> ch(1));
    } else if b < 0 and a < MINV - b {
        do(XF >> ch(-1));
    } else {
        do(XF >> ch(0));
        do(XV >> ch(a + b));
    }
}

fn xsub(num a, num b) {
    if b < 0 and a > MAXV + b {
        do(XF >> ch(1));
    } else if b > 0 and a < MINV + b {
        do(XF >> ch(-1));
    } else {
        do(XF >> ch(0));
        do(XV >> ch(a - b));
    }
}

fn xmul(num a, num b) {
    if a == 0 or b == 0 {
        do(XF >> ch(0));
        do(XV >> ch(0));
        return;
    }
    bool neg = (a < 0) != (b < 0);
    if a == 1 or b == 1 {
        do(XF >> ch(0));
        do(XV >> ch(a * b));
        return;
    }
    if a == MINV or b == MINV {
        if neg {
            do(XF >> ch(-1));
        } else {
            do(XF >> ch(1));
        }
        return;
    }
    num aa = a;
    if aa < 0 {
        do(aa >> ch(0 - aa));
    }
    num ab = b;
    if ab < 0 {
        do(ab >> ch(0 - ab));
    }
    num lim = MAXV / ab;
    if neg and MAXV % ab == ab - 1 {
        do(lim >> ch(lim + 1));
    }
    if aa > lim {
        if neg {
            do(XF >> ch(-1));
        } else {
            do(XF >> ch(1));
        }
        return;
    }
    do(XF >> ch(0));
    if neg {
        do(XV >> ch((0 - aa) * ab));
    } else {
        do(XV >> ch(aa * ab));
    }
}

fn xless(num f1, num v1, num f2, num v2) {
    if f1 != f2 {
        return f1 < f2;
    }
    if f1 != 0 {
        return false;
    }
    return v1 < v2;
}

fn fbound(bool k, num v, bool lo) {
    if not k {
        if lo {
            return "-∞";
        }
        return "∞";
    }
    return "{v}";
}

# ═══════════════════════ состояние анализа ═══════════════════════
# на каждую переменную 10 чисел:
#   0 есть значение, 1/2 известно «от», 3/4 известно «до», 5 точно элементов, 6..9 факты i < a >> sz

fn sidx(num v, num f) {
    return (v - VBASE) * 10 + f;
}

fn sdef(num f) {
    if f >= 6 {
        return -1;
    }
    return 0;
}

fn sget(mas s, num v, num f) {
    if v < VBASE {
        return sdef(f);
    }
    return s >> get(sidx(v, f), sdef(f));
}

fn sset(mas s, num v, num f, num val) {
    if v < VBASE {
        return;
    }
    num i = sidx(v, f);
    while s >> sz <= i {
        for k in 0:5 {
            do(s >> add(0));
        }
        for k in 0:3 {
            do(s >> add(-1));
        }
    }
    if i >= 0 and i < s >> sz {
        do(s >> set(i, val));
    }
}

fn scopy(mas s) {
    mas r = (num);
    for x in s {
        do(r >> add(x));
    }
    return r;
}

fn fact_has(mas s, num i, num a) {
    for k in 6:9 {
        if sget(s, i, k) == a {
            return true;
        }
    }
    return false;
}

fn fact_add(mas s, num i, num a) {
    if fact_has(s, i, a) {
        return;
    }
    for k in 6:9 {
        if sget(s, i, k) == -1 {
            do(sset(s, i, k, a));
            return;
        }
    }
    do(sset(s, i, 9, a));
}

fn facts_drop_idx(mas s, num v) {
    for k in 6:9 {
        do(sset(s, v, k, -1));
    }
}

fn facts_drop_mas(mas s, num v) {
    num n = (s >> sz) / 10;
    for b in 0:n - 1 {
        for k in 6:9 {
            num j = b * 10 + k;
            if s >> get(j, -1) == v and j >= 0 and j < s >> sz {
                do(s >> set(j, -1));
            }
        }
    }
}

fn merge2(mas a, mas b) {
    mas r = (num);
    num na = a >> sz;
    num nb = b >> sz;
    num n = na;
    if nb > n {
        do(n >> ch(nb));
    }
    num blocks = n / 10;
    for k in 0:blocks - 1 {
        num o = k * 10;
        bool ia = a >> get(o, 0) == 1;
        bool ib = b >> get(o, 0) == 1;
        if ia and ib {
            do(r >> add(1));
        } else {
            do(r >> add(0));
        }
        bool alk = a >> get(o + 1, 0) == 1;
        bool blk = b >> get(o + 1, 0) == 1;
        num al = a >> get(o + 2, 0);
        num bl = b >> get(o + 2, 0);
        if alk and blk {
            do(r >> add(1));
            if al < bl {
                do(r >> add(al));
            } else {
                do(r >> add(bl));
            }
        } else {
            do(r >> add(0));
            do(r >> add(0));
        }
        bool ahk = a >> get(o + 3, 0) == 1;
        bool bhk = b >> get(o + 3, 0) == 1;
        num ah = a >> get(o + 4, 0);
        num bh = b >> get(o + 4, 0);
        if ahk and bhk {
            do(r >> add(1));
            if ah > bh {
                do(r >> add(ah));
            } else {
                do(r >> add(bh));
            }
        } else {
            do(r >> add(0));
            do(r >> add(0));
        }
        num am = a >> get(o + 5, 0);
        num bm = b >> get(o + 5, 0);
        if am < bm {
            do(r >> add(am));
        } else {
            do(r >> add(bm));
        }
        for f in 6:9 {
            num x = a >> get(o + f, -1);
            bool keep = false;
            if x != -1 {
                for g in 6:9 {
                    if b >> get(o + g, -1) == x {
                        do(keep >> ch(true));
                    }
                }
            }
            if keep {
                do(r >> add(x));
            } else {
                do(r >> add(-1));
            }
        }
    }
    return r;
}

fn msz_of(num v) {
    if v < 0 {
        return 0;
    }
    if VGLOB >> get(v, 0) == 1 {
        return 0;
    }
    return sget(ST, v, 5);
}

fn seq_min(num v, num known) {
    if known >= 0 {
        return known;
    }
    return msz_of(v);
}

fn assigned(num v, bool lk, num l, bool hk, num h) {
    if VGLOB >> get(v, 0) == 1 {
        return;
    }
    do(sset(ST, v, 0, 1));
    if VT >> get(v, "") == "num" {
        do(sset(ST, v, 1, 0));
        do(sset(ST, v, 3, 0));
        if lk {
            do(sset(ST, v, 1, 1));
            do(sset(ST, v, 2, l));
        }
        if hk {
            do(sset(ST, v, 3, 1));
            do(sset(ST, v, 4, h));
        }
    }
    do(facts_drop_idx(ST, v));
}

# ═══════════════════════ переменные ═══════════════════════

fn sc_push() {
    do(sput(SCM, SMTOP, SCTOP));
    do(SMTOP >> ch(SMTOP + 1));
}

fn sc_pop() {
    do(SMTOP >> ch(SMTOP - 1));
    do(SCTOP >> ch(SCM >> get(SMTOP, 0)));
}

fn slot() {
    num off = NSLOTS * 8;
    do(NSLOTS >> ch(NSLOTS + 1));
    return off;
}

fn find(string name) {
    num i = SCTOP - 1;
    while i >= SCBASE {
        num v = SCV >> get(i, -1);
        if VN >> get(v, "") == name {
            return v;
        }
        do(i >> ch(i - 1));
    }
    for g in GLIST {
        if VN >> get(g, "") == name {
            return g;
        }
    }
    return -1;
}

fn fn_by_name(string name) {
    for f in FNS {
        if fs(f) == name {
            return f;
        }
    }
    return -1;
}

fn lookup(string name, num line) {
    num v = find(name);
    if v >= 0 {
        return v;
    }
    if fn_by_name(name) >= 0 {
        do(fail("{name} — это функция, вызывай её так: {name}(...)", line));
    }
    do(fail("переменная {name} не создана", line));
    return -1;
}

fn new_var(string name, string ty, num line, num limit, num loop) {
    num v = VN >> sz;
    do(VN >> add(name));
    do(VT >> add(ty));
    do(VLINE >> add(line));
    do(VLIM >> add(limit));
    do(VLOOP >> add(loop));
    do(VSLOT >> add(-1));
    do(VOWN >> add(-1));
    do(VGLOB >> add(0));
    do(VLAB >> add(""));
    return v;
}

fn declare(string name, string ty, num line, num limit, num loop) {
    if name == "term" or name == "mem" {
        do(fail("имя {name} занято — это встроенный {name}", line));
    }
    num old = find(name);
    if old >= 0 {
        do(fail("переменная {name} уже есть (строка {VLINE >> get(old, 0)}) — придумай другое имя", line));
    }
    num v = new_var(name, ty, line, limit, loop);
    do(mset(VSLOT, v, slot()));
    do(sput(SCV, SCTOP, v));
    do(SCTOP >> ch(SCTOP + 1));
    return v;
}

fn vslot(num v) {
    return VSLOT >> get(v, 0);
}

fn vty(num v) {
    return VT >> get(v, "");
}

# ═══════════════════════ машинные команды ═══════════════════════

fn em(string s) {
    do(OUT >> add("    " + s));
}

fn emlab(string l) {
    do(OUT >> add(l + ":"));
}

fn push() {
    do(OUT >> add("    @push"));
}

fn pop(string r) {
    do(OUT >> add("    @pop " + r));
}

fn newlab(string p) {
    do(NLAB >> ch(NLAB + 1));
    return "L{p}{NLAB}";
}

fn strlab(string s) {
    num i = 0;
    for x in STRS {
        if x == s {
            return "Lstr{i}";
        }
        do(i >> ch(i + 1));
    }
    do(STRS >> add(s));
    return "Lstr{i}";
}

fn declab(string t) {
    num i = 0;
    for x in DECS {
        if x == t {
            return "Ldec{i}";
        }
        do(i >> ch(i + 1));
    }
    do(DECS >> add(t));
    return "Ldec{i}";
}

fn acc() {
    if IS_ARM {
        return "x0";
    }
    return "rax";
}

fn cr(string r) {
    if IS_ARM {
        return r;
    }
    if r == "x0" {
        return "rax";
    }
    if r == "x1" {
        return "rcx";
    }
    if r == "x2" {
        return "rdx";
    }
    if r == "x3" {
        return "rsi";
    }
    if r == "x4" {
        return "rdi";
    }
    return r;
}

fn pr(num i) {
    if IS_ARM {
        return "x{i}";
    }
    if i == 0 {
        return "rdi";
    }
    if i == 1 {
        return "rsi";
    }
    if i == 2 {
        return "rdx";
    }
    if i == 3 {
        return "rcx";
    }
    if i == 4 {
        return "r8";
    }
    return "r9";
}

fn imm_lines(string reg, num v) {
    mas out = (string);
    if not IS_ARM {
        do(out >> add("mov {reg}, {v}"));
        return out;
    }
    if v == 0 {
        do(out >> add("mov {reg}, #0"));
        return out;
    }
    bool neg = v < 0;
    num w = v;
    if neg {
        do(w >> ch(v + MAXV + 1));
    }
    bool first = true;
    for k in 0:3 {
        num part = w % 65536;
        if k == 3 and neg {
            do(part >> ch(part + 32768));
        }
        do(w >> ch(w / 65536));
        if part != 0 {
            if first {
                do(out >> add("movz {reg}, #{part}, lsl #{k * 16}"));
            } else {
                do(out >> add("movk {reg}, #{part}, lsl #{k * 16}"));
            }
            do(first >> ch(false));
        }
    }
    return out;
}

fn op_imm(string reg, num v) {
    for l in imm_lines(reg, v) {
        do(em(l));
    }
}

# адрес слота на arm64: ldr/str берут смещение только до 32760; дальше — через x16
fn arm_slot(num off) {
    if off <= 32760 {
        return "[x28, #{off}]";
    }
    num hi = off / 4096;
    num lo = off % 4096;
    do(em("add x16, x28, #{hi}, lsl #12"));
    return "[x16, #{lo}]";
}

fn op_ld(string reg, num off) {
    if IS_ARM {
        string a = arm_slot(off);
        do(em("ldr {reg}, {a}"));
    } else {
        do(em("mov {reg}, [rbx + {off}]"));
    }
}

fn op_st(string reg, num off) {
    if IS_ARM {
        string a = arm_slot(off);
        do(em("str {reg}, {a}"));
    } else {
        do(em("mov [rbx + {off}], {reg}"));
    }
}

fn op_stz(num off) {
    if IS_ARM {
        string a = arm_slot(off);
        do(em("str xzr, {a}"));
    } else {
        do(em("mov qword ptr [rbx + {off}], 0"));
    }
}

fn op_lstr(string reg, string s) {
    string l = strlab(s);
    do(op_addr(reg, l));
}

fn op_addr(string reg, string l) {
    if IS_ARM {
        do(em("adrp {reg}, {l}@PAGE"));
        do(em("add {reg}, {reg}, {l}@PAGEOFF"));
    } else {
        do(em("lea {reg}, [rip + {l}]"));
    }
}

fn op_ldmem(string reg, string l) {
    if IS_ARM {
        do(em("adrp {reg}, {l}@PAGE"));
        do(em("ldr {reg}, [{reg}, {l}@PAGEOFF]"));
    } else {
        do(em("mov {reg}, [rip + {l}]"));
    }
}

fn op_call(string f) {
    if IS_ARM {
        do(em("bl {f}"));
    } else {
        do(em("call {f}"));
    }
}

fn op_jmp(string l) {
    if IS_ARM {
        do(em("b {l}"));
    } else {
        do(em("jmp {l}"));
    }
}

fn op_jz(string l) {
    if IS_ARM {
        do(em("cbz x0, {l}"));
    } else {
        do(em("test rax, rax"));
        do(em("jz {l}"));
    }
}

fn op_jnz(string l) {
    if IS_ARM {
        do(em("cbnz x0, {l}"));
    } else {
        do(em("test rax, rax"));
        do(em("jnz {l}"));
    }
}

fn op_mov(string d, string s) {
    if d != s {
        do(em("mov {d}, {s}"));
    }
}

fn op_acc_to(num i) {
    do(op_mov(pr(i), acc()));
}

fn op_rt1(string f) {
    do(op_acc_to(0));
    do(op_call(f));
}

fn op_field(string d, string s, num off) {
    if IS_ARM {
        if off == 0 {
            do(em("ldr {d}, [{s}]"));
        } else {
            do(em("ldr {d}, [{s}, #{off}]"));
        }
    } else {
        if off == 0 {
            do(em("mov {d}, [{s}]"));
        } else {
            do(em("mov {d}, [{s} + {off}]"));
        }
    }
}

fn op_cmpj(string a, string b, string cc, string l) {
    do(em("cmp {a}, {b}"));
    if IS_ARM {
        do(em("b.{cc} {l}"));
    } else if cc == "ge" {
        do(em("jge {l}"));
    } else if cc == "gt" {
        do(em("jg {l}"));
    } else {
        do(em("je {l}"));
    }
}

fn op_inc(string r) {
    if IS_ARM {
        do(em("add {r}, {r}, #1"));
    } else {
        do(em("add {r}, 1"));
    }
}

fn load_var(string reg, num v) {
    if VGLOB >> get(v, 0) == 1 {
        string l = VLAB >> get(v, "");
        if IS_ARM {
            do(em("adrp x9, {l}@PAGE"));
            do(em("ldr {reg}, [x9, {l}@PAGEOFF]"));
        } else {
            do(em("mov {reg}, [rip + {l}]"));
        }
    } else {
        do(op_ld(reg, vslot(v)));
    }
}

fn store_var(string reg, num v) {
    if VGLOB >> get(v, 0) == 1 {
        string l = VLAB >> get(v, "");
        if IS_ARM {
            do(em("adrp x9, {l}@PAGE"));
            do(em("str {reg}, [x9, {l}@PAGEOFF]"));
        } else {
            do(em("mov [rip + {l}], {reg}"));
        }
    } else {
        do(op_st(reg, vslot(v)));
    }
}

fn die_stub(string msg, num line) {
    num local_line = source_line(line);
    string l = newlab("err");
    string m = strlab(msg);
    do(STUBS >> add(l + ":"));
    if IS_ARM {
        do(STUBS >> add("    adrp x0, {m}@PAGE"));
        do(STUBS >> add("    add x0, x0, {m}@PAGEOFF"));
        for x in imm_lines("x1", local_line) {
            do(STUBS >> add("    " + x));
        }
        do(STUBS >> add("    bl _bit_die"));
    } else {
        do(STUBS >> add("    lea rdi, [rip + {m}]"));
        do(STUBS >> add("    mov rsi, {local_line}"));
        do(STUBS >> add("    call _bit_die"));
    }
    return l;
}

fn ovf_stub(num line) {
    return die_stub("переполнение num — число не влезло", line);
}

fn num_to_dec() {
    if IS_ARM {
        do(em("scvtf d0, x0"));
        do(em("fmov x0, d0"));
    } else {
        do(em("cvtsi2sd xmm0, rax"));
        do(em("movq rax, xmm0"));
    }
}

fn is_branch(string l) {
    if IS_ARM {
        return starts(l, "    b ");
    }
    return starts(l, "    jmp ");
}

fn is_branch_l(string l) {
    if IS_ARM {
        return starts(l, "    b L");
    }
    return starts(l, "    jmp L");
}

fn expand(mas dst, string l) {
    if l == "    @push" {
        if IS_ARM {
            do(dst >> add("    str x0, [sp, #-16]!"));
        } else {
            do(dst >> add("    sub rsp, 16"));
            do(dst >> add("    mov [rsp], rax"));
        }
    } else if starts(l, "    @pop ") {
        string r = l >> bytes >> text(9, 100);
        if IS_ARM {
            do(dst >> add("    ldr {r}, [sp], #16"));
        } else {
            do(dst >> add("    mov {r}, [rsp]"));
            do(dst >> add("    add rsp, 16"));
        }
    } else {
        do(dst >> add(l));
    }
}

fn peephole(mas src, mas dst) {
    string prev = "";
    bool has = false;
    for l in src {
        if has and prev == "    @push" and starts(l, "    @pop ") {
            string r = l >> bytes >> text(9, 100);
            if r != acc() {
                do(prev >> ch("    mov {r}, {acc()}"));
            } else {
                do(has >> ch(false));
            }
        } else if has and is_branch(prev) and is_branch_l(l) {
            do(has >> ch(has));
        } else if has and ends(l, ":") and not starts(l, " ") and (prev == "    b " + (l >> bytes >> text(0, (l >> bytes >> sz) - 1)) or prev == "    jmp " + (l >> bytes >> text(0, (l >> bytes >> sz) - 1))) {
            do(prev >> ch(l));
        } else {
            if has {
                do(expand(dst, prev));
            }
            do(prev >> ch(l));
            do(has >> ch(true));
        }
    }
    if has {
        do(expand(dst, prev));
    }
}

fn finish(string label) {
    mas code = (string);
    num frame = (NSLOTS * 8 + 15) / 16 * 16;
    do(code >> add(label + ":"));
    if IS_ARM {
        do(code >> add("    stp x29, x30, [sp, #-16]!"));
        do(code >> add("    mov x29, sp"));
        do(code >> add("    stp x27, x28, [sp, #-16]!"));
        if frame > 0 {
            if frame < 4096 {
                do(code >> add("    sub sp, sp, #{frame}"));
            } else {
                for x in imm_lines("x9", frame) {
                    do(code >> add("    " + x));
                }
                do(code >> add("    sub sp, sp, x9"));
            }
        }
        do(code >> add("    mov x28, sp"));
    } else {
        do(code >> add("    push rbp"));
        do(code >> add("    mov rbp, rsp"));
        do(code >> add("    push rbx"));
        do(code >> add("    sub rsp, {frame + 8}"));
        do(code >> add("    mov rbx, rsp"));
    }
    do(peephole(OUT, code));
    do(code >> add(RETLAB + ":"));
    if IS_ARM {
        do(code >> add("    sub sp, x29, #16"));
        do(code >> add("    ldp x27, x28, [sp], #16"));
        do(code >> add("    ldp x29, x30, [sp], #16"));
        do(code >> add("    ret"));
    } else {
        do(code >> add("    lea rsp, [rbp - 8]"));
        do(code >> add("    pop rbx"));
        do(code >> add("    pop rbp"));
        do(code >> add("    ret"));
    }
    for x in STUBS {
        do(code >> add(x));
    }
    return code >> join("\n");
}

# ═══════════════════════ команды ═══════════════════════

# Only claim ownership when uses do not capture the string in shared storage.
# The AST walk treats uses in arguments, container values and closures as escapes.
fn string_escapes(num n, string name) {
    if n < 0 {
        return false;
    }
    string k = kind(n);
    if k == "var" {
        return fs(n) == name;
    }
    num a = fa(n);
    if k == "return" and kind(a) == "var" and fs(a) == name {
        return false;
    }
    if k == "do" and kind(a) == "pipe" and (fs(a) == "ch" or fs(a) == "input") {
        num receiver = fa(a);
        if kind(receiver) == "var" and fs(receiver) == name {
            for j in 0:c1(a) - 1 {
                num value = arg(a, j);
                if kind(value) != "var" and string_escapes(value, name) {
                    return true;
                }
            }
            return false;
        }
    }
    bool copying = k == "bin" and (fs(n) == "+" or is_cmp(fs(n)));
    # Calls hold arguments, and returned strings own a reference. Record constructors
    # still store raw field pointers until container ownership is integrated.
    bool held_call = k == "call" and record_by_name(fs(n)) < 0;
    # These string methods copy their results or only compare; their receiver is
    # never stored beyond the call. Arguments are still analysed separately.
    bool safe_receiver = false;
    if k == "pipe" and kind(a) == "var" and fs(a) == name {
        string method = fs(n);
        do(safe_receiver >> ch(method == "sz" or method == "starts" or
            method == "ends" or method == "trim" or method == "replace" or
            method == "upper" or method == "lower" or method == "get" or
            method == "repeat" or method == "pad" or method == "pad_left" or
            method == "contains" or method == "find" or method == "code" or
            method == "num" or method == "exists" or method == "remove_all"));
    }
    bool read_only = safe_receiver or k == "print" or copying;
    if not (read_only and kind(a) == "var") and string_escapes(a, name) {
        return true;
    }
    if not (copying and kind(fb(n)) == "var") and string_escapes(fb(n), name) {
        return true;
    }
    for j in 0:c1(n) - 1 {
        num part = item(l1(n), j);
        bool copied_part = (k == "str" and c1(n) > 1) or held_call;
        if not (copied_part and kind(part) == "var") and string_escapes(part, name) {
            return true;
        }
    }
    for j in 0:c2(n) - 1 {
        if string_escapes(item(l2(n), j), name) {
            return true;
        }
    }
    return false;
}

fn string_changes(num n, string name) {
    if n < 0 {
        return false;
    }
    if kind(n) == "pipe" and (fs(n) == "ch" or fs(n) == "input") {
        num receiver = fa(n);
        if kind(receiver) == "var" and fs(receiver) == name {
            return true;
        }
    }
    if string_changes(fa(n), name) or string_changes(fb(n), name) {
        return true;
    }
    for j in 0:c1(n) - 1 {
        if string_changes(item(l1(n), j), name) {
            return true;
        }
    }
    for j in 0:c2(n) - 1 {
        if string_changes(item(l2(n), j), name) {
            return true;
        }
    }
    return false;
}

fn own_local(num start, num count, num v, bool fresh, bool parameter) {
    string name = VN >> get(v, "");
    for j in 0:count - 1 {
        if string_escapes(item(start, j), name) {
            if parameter {
                do(op_rt1("_bit_str_retain"));
            }
            return;
        }
    }
    if parameter {
        bool changed = false;
        for j in 0:count - 1 {
            if string_changes(item(start, j), name) {
                do(changed >> ch(true));
                break;
            }
        }
        if not changed {
            # The caller already holds this argument until the call returns.
            return;
        }
    }
    if not fresh {
        do(op_rt1("_bit_str_retain"));
    }
    num frame = slot();
    do(NSLOTS >> ch(NSLOTS + 1));
    do(op_st(acc(), frame));
    do(op_slot_addr(frame));
    do(op_call("_bit_own_str"));
    do(OWNDEP >> ch(OWNDEP + 1));
    do(mset(VOWN, v, frame));
}

fn store_string(num v, bool fresh) {
    num frame = VOWN >> get(v, -1);
    if frame < 0 {
        do(store_var(acc(), v));
        return;
    }
    # Hold the new value before releasing the old one, including self-assignment.
    if not fresh {
        do(op_rt1("_bit_str_retain"));
    }
    do(push());
    do(load_var(pr(0), v));
    do(op_call("_bit_drop_str"));
    do(pop(acc()));
    do(store_var(acc(), v));
    do(op_st(acc(), frame));
}

fn drop_locals(num keep) {
    for i in keep + 1:OWNDEP {
        do(op_call("_bit_drop_owned"));
    }
}

fn block(num start, num cnt, bool newscope) {
    if newscope {
        do(sc_push());
    }
    bool ended = false;
    num keep = OWNDEP;
    for k in 0:cnt - 1 {
        num s = item(start, k);
        if ended {
            do(fail("этот код никогда не выполнится — он после return", ln(s)));
        }
        do(ended >> ch(stmt(s, start + k, cnt - k)));
    }
    if not ended {
        do(drop_locals(keep));
    }
    do(OWNDEP >> ch(keep));
    if newscope {
        do(sc_pop());
    }
    return ended;
}

fn stmt(num s, num rest, num count) {
    string k = kind(s);
    if k == "decl" {
        for j in 0:c1(s) - 1 {
            do(decl_item(item(l1(s), j), rest, count));
        }
        return false;
    }
    if k == "do" {
        return s_do(s);
    }
    if k == "print" {
        return s_print(s);
    }
    if k == "if" {
        return s_if(s);
    }
    if k == "pick" {
        return s_pick(s);
    }
    if k == "spawn" {
        return s_spawn(s);
    }
    if k == "while" {
        return s_while(s);
    }
    if k == "for" {
        return s_for(s);
    }
    if k == "return" {
        return s_return(s);
    }
    if k == "break" {
        return s_break(s);
    }
    if k == "next" {
        return s_next(s);
    }
    if k == "recover" {
        return s_recover(s);
    }
    do(fail("внутренняя ошибка: команда {k}", ln(s)));
    return false;
}

fn coerce(string t, string target, num line, string what) {
    if t == "?" or target == "?" or t == target {
        return;
    }
    if is_path(target) and is_path(t) {
        return;
    }
    if target == "dec" and t == "num" {
        do(num_to_dec());
        return;
    }
    do(fail("{what}: нужен {tn(target)}, а тут {tn(t)}", line));
}

fn int_div_check(num e, string target, num line) {
    if target != "dec" {
        return;
    }
    if kind(e) != "bin" or fs(e) != "/" {
        return;
    }
    do(fail("деление целых даёт целое — дробной части не будет. Сделай один операнд дробным, например 1.0 / 3", line));
}

fn decl_item(num it, num rest, num count) {
    string ty = ft(it);
    string name = fs(it);
    string mode = fm(it);
    num line = ln(it);
    if mode == "lock" {
        do(op_call("_bit_user_lock_new"));
        num v = declare(name, ty, line, -1, 0);
        do(op_st(acc(), vslot(v)));
        do(assigned(v, false, -1, false, -1));
        return;
    }
    if mode == "empty" {
        num v = declare(name, ty, line, -1, 0);
        do(op_stz(vslot(v)));
        if is_path(ty) and count > 0 {
            do(op_ld(acc(), vslot(v)));
            do(own_local(rest, count, v, false, false));
        }
        return;
    }
    if mode == "value" {
        do(expr(fa(it)));
        string t = RT;
        num src = RV;
        num rsz = RMSZ;
        bool lk = RLK;
        num l = RL;
        bool hk = RHK;
        num h = RH;
        bool fresh = RFRESH;
        bool owned = is_path(t) and count > 0;
        if t == "void" {
            do(fail("тут нет значения — функция ничего не возвращает", line));
        }
        if is_mas(t) and ty != "all" {
            do(fail("в {ty} {name} нельзя положить {tn(t)}", line));
        }
        string vt = ty;
        if t == "num" {
            do(int_div_check(fa(it), ty, line));
        }
        if ty == "all" {
            if t == "mas:?" {
                do(fail("в массиве ещё нет элементов — его тип неизвестен", line));
            }
            do(vt >> ch(t));
        } else {
            do(coerce(t, ty, line, "в {ty} {name}"));
        }
        num v = declare(name, vt, line, -1, 0);
        do(op_st(acc(), vslot(v)));
        if owned {
            do(own_local(rest, count, v, fresh, false));
        }
        do(assigned(v, lk, l, hk, h));
        if is_seq(vt) {
            do(sset(ST, v, 5, seq_min(src, rsz)));
        }
        return;
    }
    if mode == "mas" {
        do(decl_mas(it));
        return;
    }
    if mode == "map" {
        num init = fa(it);
        string t = "?";
        if kind(init) == "maslit" {
            if not plain(ft(init)) {
                do(fail("пустой словарь создаётся с типом значения, например map {name} = (num);", line));
            }
            do(t >> ch("map:" + ft(init)));
            do(op_imm(pr(0), -1));
            do(op_imm(pr(1), 0));
            do(op_call("_bit_mas_new"));
        } else {
            do(expr(init));
            do(t >> ch(RT));
            if t != "?" and not is_map(t) {
                do(fail("в map {name} нужен словарь, а тут {tn(t)}", line));
            }
        }
        num v = declare(name, t, line, -1, 0);
        do(op_st(acc(), vslot(v)));
        do(sset(ST, v, 0, 1));
        return;
    }
    if mode == "input" {
        num v = declare(name, ty, line, -1, 0);
        do(do_input(v, fa(it), line));
        if ty == "string" and count > 0 {
            do(own_local(rest, count, v, true, false));
        }
    }
}

fn decl_mas(num it) {
    string name = fs(it);
    num line = ln(it);
    num lim = fv(it);
    num init = fa(it);
    if init >= 0 and kind(init) != "maslit" {
        if lim >= 0 {
            do(fail("лимит можно задать только новому массиву: mas a(5) = (1, 2);", line));
        }
        do(expr(init));
        string t = RT;
        num src = RV;
        num min_size = seq_min(src, RMSZ);
        if t != "?" and not is_mas(t) {
            do(fail("в mas {name} нельзя положить {tn(t)}", line));
        }
        if t == "mas:?" {
            do(fail("в массиве ещё нет элементов — его тип неизвестен", line));
        }
        num v = declare(name, t, line, -1, 0);
        do(op_st(acc(), vslot(v)));
        do(sset(ST, v, 0, 1));
        do(sset(ST, v, 5, min_size));
        return;
    }
    num es = 0;
    num ec = 0;
    if init >= 0 {
        do(es >> ch(l1(init)));
        do(ec >> ch(c1(init)));
    }
    if lim >= 0 and ec > lim {
        do(fail("в mas {name}({lim}) максимум {lim} элементов, а тут {ec}", line));
    }
    do(op_imm(pr(0), lim));
    do(op_imm(pr(1), ec));
    do(op_call("_bit_mas_new"));
    num v = declare(name, "mas:?", line, lim, 0);
    do(op_st(acc(), vslot(v)));
    do(sset(ST, v, 0, 1));
    do(sset(ST, v, 5, ec));
    if init >= 0 and ft(init) != "" {
        do(mset(VT, v, "mas:" + ft(init)));
    }
    if ec == 0 {
        return;
    }
    all so = OUT;
    all ss = STUBS;
    mas e1 = (string);
    mas e2 = (string);
    do(OUT >> ch(e1));
    do(STUBS >> ch(e2));
    mas types = (string);
    for k in 0:ec - 1 {
        do(expr(item(es, k)));
        do(types >> add(RT));
    }
    do(OUT >> ch(so));
    do(STUBS >> ch(ss));
    string el = "num";
    bool found = false;
    bool hasnum = false;
    bool hasdec = false;
    bool other = false;
    for t in types {
        if t != "?" {
            if not found {
                do(el >> ch(t));
                do(found >> ch(true));
            }
            if t == "num" {
                do(hasnum >> ch(true));
            } else if t == "dec" {
                do(hasdec >> ch(true));
            } else {
                do(other >> ch(true));
            }
        }
    }
    if hasnum and hasdec and not other {
        do(el >> ch("dec"));
    }
    for k in 0:ec - 1 {
        string t = types >> get(k, "?");
        num e = item(es, k);
        if not (t == "?" or t == el or (el == "dec" and t == "num")) {
            if not array_element(t) {
                do(fail("в массиве можно хранить num, dec, string, bool или структуры, а тут {tn(t)}", ln(e)));
            }
            do(fail("в массиве все элементы одного типа: первый {el}, а этот {t}", ln(e)));
        }
    }
    do(mset(VT, v, "mas:" + el));
    for k in 0:ec - 1 {
        num e = item(es, k);
        do(expr(e));
        do(coerce(RT, el, ln(e), "элемент массива"));
        do(op_ld(cr("x1"), vslot(v)));
        do(op_field(cr("x1"), cr("x1"), 0));
        if IS_ARM {
            do(em("str x0, [x1, #{8 * k}]"));
        } else {
            do(em("mov [rcx + {8 * k}], rax"));
        }
    }
}

fn const_kind(num n) {
    if kind(n) == "num" {
        do(CVAL >> ch(fv(n)));
        do(CTEXT >> ch(fs(n)));
        return "num";
    }
    if kind(n) == "dec" {
        do(CTEXT >> ch(fs(n)));
        return "dec";
    }
    if kind(n) == "un" and fs(n) == "-" {
        num e = fa(n);
        if kind(e) == "num" {
            do(CVAL >> ch(0 - fv(e)));
            do(CTEXT >> ch("-" + fs(e)));
            return "num";
        }
        if kind(e) == "dec" {
            do(CTEXT >> ch("-" + fs(e)));
            return "dec";
        }
    }
    return "";
}

fn lexcmp(string a, string b) {
    mas x = a >> bytes;
    mas y = b >> bytes;
    num n = x >> sz;
    if y >> sz < n {
        do(n >> ch(y >> sz));
    }
    for k in 0:n - 1 {
        num c = x >> get(k, 0);
        num d = y >> get(k, 0);
        if c != d {
            if c < d {
                return -1;
            }
            return 1;
        }
    }
    if x >> sz < y >> sz {
        return -1;
    }
    if x >> sz > y >> sz {
        return 1;
    }
    return 0;
}

# сравнение неотрицательных десятичных записей вида 12.50
fn mag_cmp(string a, string b) {
    mas x = a >> bytes;
    mas y = b >> bytes;
    num dx = x >> sz;
    num dy = y >> sz;
    for k in 0:(x >> sz) - 1 {
        if x >> get(k, 0) == 46 and dx == x >> sz {
            do(dx >> ch(k));
        }
    }
    for k in 0:(y >> sz) - 1 {
        if y >> get(k, 0) == 46 and dy == y >> sz {
            do(dy >> ch(k));
        }
    }
    num i = 0;
    while i < dx - 1 and x >> get(i, 0) == 48 {
        do(i >> ch(i + 1));
    }
    num j = 0;
    while j < dy - 1 and y >> get(j, 0) == 48 {
        do(j >> ch(j + 1));
    }
    string ix = x >> text(i, dx);
    string iy = y >> text(j, dy);
    if ix >> bytes >> sz != iy >> bytes >> sz {
        if ix >> bytes >> sz < iy >> bytes >> sz {
            return -1;
        }
        return 1;
    }
    num c = lexcmp(ix, iy);
    if c != 0 {
        return c;
    }
    num ex = x >> sz;
    while ex > dx + 1 and x >> get(ex - 1, 0) == 48 {
        do(ex >> ch(ex - 1));
    }
    num ey = y >> sz;
    while ey > dy + 1 and y >> get(ey - 1, 0) == 48 {
        do(ey >> ch(ey - 1));
    }
    return lexcmp(x >> text(dx + 1, ex), y >> text(dy + 1, ey));
}

fn is_zero_text(string a) {
    for c in a >> bytes {
        if c >= 49 and c <= 57 {
            return false;
        }
    }
    return true;
}

fn dec_cmp(string a, string b) {
    bool na = starts(a, "-") and not is_zero_text(a);
    bool nb = starts(b, "-") and not is_zero_text(b);
    string ma = a;
    if starts(a, "-") {
        do(ma >> ch(a >> bytes >> text(1, 1000)));
    }
    string mb = b;
    if starts(b, "-") {
        do(mb >> ch(b >> bytes >> text(1, 1000)));
    }
    if na != nb {
        if na {
            return -1;
        }
        return 1;
    }
    num c = mag_cmp(ma, mb);
    if na {
        return 0 - c;
    }
    return c;
}

fn do_input(num v, num m, num line) {
    if VLOOP >> get(v, 0) == 1 {
        do(fail("переменную цикла менять нельзя", line));
    }
    string ty = vty(v);
    num ac = c1(m);
    if ty == "string" or ty == "bool" {
        if ac > 0 {
            do(fail("у input для {ty} границ не бывает", line));
        }
        do(op_imm(pr(0), source_line(line)));
        if ty == "string" {
            do(op_call("_bit_input_str"));
            do(op_rt1("_bit_str_adopt"));
            do(store_string(v, true));
        } else {
            do(op_call("_bit_input_bool"));
            do(store_var(acc(), v));
        }
        do(assigned(v, false, 0, false, 0));
        return;
    }
    if not is_numt(ty) {
        do(fail("input не умеет читать {tn(ty)}", line));
    }
    bool lk = false;
    num lo = 0;
    bool hk = false;
    num hi = 0;
    if ac > 0 {
        num a = arg(m, 0);
        if ac != 1 or kind(a) != "range" {
            do(fail("границы input пишутся так: input(0:4)", line));
        }
        string k1 = const_kind(fa(a));
        num v1 = CVAL;
        string t1 = CTEXT;
        string k2 = const_kind(fb(a));
        num v2 = CVAL;
        string t2 = CTEXT;
        if k1 == "" or k2 == "" {
            do(fail("границы input должны быть числами, например input(0:4)", line));
        }
        if ty == "num" and (k1 == "dec" or k2 == "dec") {
            do(fail("у num границы — целые числа", line));
        }
        if dec_cmp(t1, t2) > 0 {
            do(fail("в input({t1}:{t2}) начало больше конца", line));
        }
        do(op_imm(pr(0), 1));
        if ty == "num" {
            do(op_imm(pr(1), v1));
            do(op_imm(pr(2), v2));
            do(lk >> ch(true));
            do(lo >> ch(v1));
            do(hk >> ch(true));
            do(hi >> ch(v2));
        } else {
            do(op_ldmem(pr(1), declab(t1)));
            do(op_ldmem(pr(2), declab(t2)));
        }
    } else {
        do(op_imm(pr(0), 0));
        do(op_imm(pr(1), 0));
        do(op_imm(pr(2), 0));
    }
    do(op_imm(pr(3), source_line(line)));
    do(op_call("_bit_input_{ty}"));
    do(store_var(acc(), v));
    do(assigned(v, lk, lo, hk, hi));
}

fn is_valfn(string mn) {
    return mn == "get" or mn == "sz" or mn == "keep" or mn == "each" or mn == "find" or mn == "has" or mn == "sum";
}

fn s_do(num s) {
    num e = fa(s);
    string k = kind(e);
    if k == "call" {
        do(expr(e));
        if is_path(RT) and RFRESH {
            do(op_rt1("_bit_drop_str"));
        }
        return false;
    }
    if k != "pipe" {
        do(fail("в do(...) должно быть действие (ch, add, write, delete...) или вызов функции", ln(s)));
        return false;
    }
    string mn = fs(e);
    num line = ln(e);
    if mn == "ch" or mn == "input" {
        do(action(e));
        return false;
    }
    num obj = fa(e);
    if is_builtin(obj) {
        do(term_action(e));
        return false;
    }
    do(pipe_receiver(obj, true));
    string t = RT;
    num ov = RV;
    if t == "?" {
        return false;
    }
    if record_by_name(t) < 0 {
        do(need_linux(t, mn, line));
    }
    if act_on(e, t, ov, true) {
        return false;
    }
    if vm(t, mn) or is_valfn(mn) {
        do(fail("{mn} — не действие, его результат надо сохранить: all x = ... >> {mn};", line));
    }
    string acts = acts_of(t);
    string have = "";
    if acts != "" {
        do(have >> ch(" Есть: " + acts));
    }
    do(fail("у {tn(t)} нет действия {mn}.{have}", line));
    return false;
}

# ch и input: меняют переменную; результат — её новое значение
fn action(num e) {
    string mn = fs(e);
    num line = ln(e);
    num obj = fa(e);
    num ac = c1(e);
    if kind(obj) != "var" {
        do(fail("{mn} меняет переменную: do(x >> {mn}(...));", line));
    }
    num v = lookup(fs(obj), line);
    if mn == "input" {
        do(do_input(v, e, line));
        do(resv(vty(v), v));
        if vty(v) == "num" {
            do(rng(sget(ST, v, 1) == 1, sget(ST, v, 2), sget(ST, v, 3) == 1, sget(ST, v, 4)));
        }
        return;
    }
    if VLOOP >> get(v, 0) == 1 {
        do(fail("переменную цикла менять нельзя", line));
    }
    if ac != 1 {
        do(fail("ch(значение) — одно значение, например ch(5)", line));
    }
    do(expr(arg(e, 0)));
    string t = RT;
    num src = RV;
    bool lk = RLK;
    num l = RL;
    bool hk = RHK;
    num h = RH;
    if is_seq(vty(v)) {
        do(ch_mas(v, t, src, RMSZ, line));
        do(resv(vty(v), v));
        return;
    }
    do(coerce(t, vty(v), line, "в {vty(v)} {VN >> get(v, '')}"));
    if is_path(vty(v)) {
        do(store_string(v, RFRESH));
    } else {
        do(store_var(acc(), v));
    }
    do(assigned(v, lk, l, hk, h));
    do(resv(vty(v), v));
    if vty(v) == "num" {
        do(rng(lk, l, hk, h));
    }
}

# add: массив уже в x0 / rax
fn add_item(string ot, num ov, num e, num line) {
    if c1(e) != 1 or kind(arg(e, 0)) == "range" {
        do(fail("add(значение) — одно значение, например add(10)", line));
    }
    if ot == "bytes" {
        do(push());
        do(expr(arg(e, 0)));
        do(coerce(RT, "num", line, "в bytes"));
        do(op_acc_to(1));
        do(pop(pr(0)));
        do(op_call("_bit_bytes_add"));
        if ov >= 0 {
            do(sset(ST, ov, 5, msz_of(ov) + 1));
        }
        return;
    }
    if not is_mas(ot) {
        do(fail("add добавляет в массив, а тут {tn(ot)}", line));
    }
    do(push());
    do(expr(arg(e, 0)));
    string t = RT;
    if ot == "mas:?" {
        if not array_element(t) and t != "?" {
            do(fail("в массиве можно хранить num, dec, string, bool или структуры, а тут {tn(t)}", line));
        }
        if ov >= 0 and t != "?" {
            do(mset(VT, ov, "mas:" + t));
        }
    } else {
        string el = elem(ot);
        do(coerce(t, el, line, "в массив из " + el));
    }
    do(op_acc_to(1));
    do(pop(pr(0)));
    do(op_imm(pr(2), source_line(line)));
    do(op_call("_bit_mas_add"));
    if ov >= 0 {
        num n = msz_of(ov) + 1;
        num lim = VLIM >> get(ov, -1);
        if lim >= 0 and n > lim {
            do(fail("в {VN >> get(ov, '')} уже точно {lim} элементов — лимит {lim}, больше не влезет", line));
        }
        do(sset(ST, ov, 5, n));
    }
}

fn ch_mas(num v, string t, num src, num known, num line) {
    if t == "?" {
        return;
    }
    string vt = vty(v);
    if not is_seq(t) {
        do(fail("в {tn(vt)} {VN >> get(v, '')} нельзя положить {tn(t)}", line));
    }
    if t == "mas:?" {
        if vt == "mas:?" {
            do(fail("у обоих массивов ещё неизвестен тип элементов", line));
        }
        if src >= 0 {
            do(mset(VT, src, vt));
        }
    } else if vt == "mas:?" {
        do(mset(VT, v, t));
    } else if t != vt {
        do(fail("в {tn(vt)} {VN >> get(v, '')} нельзя положить {tn(t)}", line));
    }
    do(store_var(acc(), v));
    do(mset(VLIM, v, -1));
    if VGLOB >> get(v, 0) == 0 {
        do(sset(ST, v, 5, seq_min(src, known)));
        do(facts_drop_mas(ST, v));
    }
}

fn s_print(num s) {
    do(expr(fa(s)));
    if RT == "void" {
        do(fail("тут нет значения — функция ничего не возвращает", ln(s)));
    }
    do(to_str(RT, ln(s)));
    bool fresh = RFRESH;
    if fresh {
        num sl = slot();
        do(op_st(acc(), sl));
        do(op_rt1("_bit_print"));
        do(op_ld(pr(0), sl));
        do(op_call("_bit_drop_str"));
    } else {
        do(op_rt1("_bit_print"));
    }
    return false;
}

fn cond_jump(num e, string label) {
    if OPTIMIZE and kind(e) == "bin" and is_cmp(fs(e)) {
        do(e_bin(e, label));
        return;
    }
    do(expr(e));
    if RT != "bool" and RT != "?" {
        do(fail("условие должно быть bool (true/false), а тут {tn(RT)} — например x > 0", ln(e)));
    }
    do(op_jz(label));
}

fn s_spawn(num s) {
    num line = ln(s);
    num f = fa(s);
    num inst = instance(f, "");
    string lbl = ILAB >> get(inst, "");
    if IS_ARM {
        do(em("adrp x0, {lbl}@PAGE"));
        do(em("add x0, x0, {lbl}@PAGEOFF"));
    } else {
        do(em("lea rax, [rip + {lbl}]"));
    }
    do(op_acc_to(0));
    do(op_call("_bit_thread_start"));
    num v = declare(fs(s), "thread", line, -1, 0);
    do(op_st(acc(), vslot(v)));
    do(assigned(v, false, -1, false, -1));
    return false;
}

fn s_pick(num s) {
    num line = ln(s);
    do(expr(fa(s)));
    string ty = RT;
    if ty != "num" and ty != "string" {
        do(fail("pick работает с num и string, а тут {tn(ty)}", line));
    }
    num sv = slot();
    do(op_st(acc(), sv));
    string lend = newlab("swend");
    bool has_else = fm(s) == "else";
    string lelse = lend;
    if has_else {
        do(lelse >> ch(newlab("swelse")));
    }
    mas labels = (string);
    num ncases = c1(s);
    if ncases > 0 {
        for j in 0:ncases - 1 {
            num c = item(l1(s), j);
            string lj = newlab("case");
            do(labels >> add(lj));
            num nv = c1(c);
            if nv > 0 {
                for vi in 0:nv - 1 {
                    num v = item(l1(c), vi);
                    do(op_ld(acc(), sv));
                    do(push());
                    do(expr(v));
                    if RT != ty {
                        do(fail("значение pick типа {tn(RT)}, а выбираем по {tn(ty)}", ln(c)));
                    }
                    if ty == "string" {
                        do(op_mov(pr(1), acc()));
                        do(pop(pr(0)));
                        do(op_call("_bit_str_eq"));
                        if IS_ARM {
                            do(em("cbnz x0, {lj}"));
                        } else {
                            do(em("test rax, rax"));
                            do(em("jnz {lj}"));
                        }
                    } else {
                        do(op_mov(pr(1), acc()));
                        do(pop(pr(0)));
                        do(op_cmpj(pr(0), pr(1), "eq", lj));
                    }
                }
            }
        }
    }
    do(op_jmp(lelse));
    all base = ST;
    bool all_end = has_else;
    if ncases > 0 {
        for j in 0:ncases - 1 {
            num c = item(l1(s), j);
            do(ST >> ch(scopy(base)));
            do(emlab(labels >> get(j, "")));
            bool t = block(l2(c), c2(c), true);
            if not t {
                do(op_jmp(lend));
                do(all_end >> ch(false));
            }
        }
    }
    if has_else {
        do(ST >> ch(scopy(base)));
        do(emlab(lelse));
        bool t2 = block(l2(s), c2(s), true);
        if not t2 {
            do(op_jmp(lend));
            do(all_end >> ch(false));
        }
    }
    do(emlab(lend));
    do(ST >> ch(base));
    return all_end;
}

fn s_if(num s) {
    string le = newlab("else");
    do(cond_jump(fa(s), le));
    all base = ST;
    mas s1 = scopy(base);
    do(narrow(fa(s), true, s1));
    mas s2 = scopy(base);
    do(narrow(fa(s), false, s2));
    string lf = newlab("fi");
    do(ST >> ch(s1));
    bool t1 = block(l1(s), c1(s), true);
    all end1 = ST;
    do(op_jmp(lf));
    do(emlab(le));
    bool t2 = false;
    mas end2 = s2;
    if fm(s) == "else" {
        do(ST >> ch(s2));
        do(t2 >> ch(block(l2(s), c2(s), true)));
        do(end2 >> ch(ST));
    }
    do(emlab(lf));
    if not t1 and not t2 {
        do(ST >> ch(merge2(end1, end2)));
    } else if not t1 {
        do(ST >> ch(end1));
    } else if not t2 {
        do(ST >> ch(end2));
    } else {
        do(ST >> ch(end1));
    }
    return t1 and t2;
}

fn widen_list(num start, num cnt) {
    for k in 0:cnt - 1 {
        do(widen_node(item(start, k)));
    }
}

fn widen_node(num n) {
    if n < 0 {
        return;
    }
    num o = fa(n);
    if kind(n) == "pipe" and (fs(n) == "ch" or fs(n) == "input") and o >= 0 and kind(o) == "var" {
        num v = find(fs(o));
        if v >= 0 {
            do(sset(ST, v, 1, 0));
            do(sset(ST, v, 3, 0));
            do(sset(ST, v, 5, 0));
            do(facts_drop_idx(ST, v));
            do(facts_drop_mas(ST, v));
        }
    }
    do(widen_node(o));
    do(widen_node(fb(n)));
    do(widen_list(l1(n), c1(n)));
    do(widen_list(l2(n), c2(n)));
}

# recover { ... } else { ... } — сбой внутри не завершает программу, а уходит в else
fn op_slot_addr(num frame) {
    if IS_ARM {
        do(op_imm("x0", frame));
        do(em("add x0, x28, x0"));
    } else {
        do(em("lea rdi, [rbx + {frame}]"));
    }
}

fn s_recover(num s) {
    mas entry = scopy(ST);
    do(widen_list(l1(s), c1(s)));
    mas widened = scopy(ST);
    do(ST >> ch(entry));
    string lf = newlab("recf");
    string le = newlab("rece");
    num frame = slot();
    # 168 bytes for saved registers, then the previous handler and string cleanup pointer.
    do(NSLOTS >> ch(NSLOTS + 22));
    do(op_slot_addr(frame));
    do(op_call("_bit_recover_enter"));
    do(op_acc_to(0));
    do(op_call("_bit_setjmp"));
    do(op_jnz(lf));
    do(RECDEP >> ch(RECDEP + 1));
    bool body_ended = block(l1(s), c1(s), true);
    do(RECDEP >> ch(RECDEP - 1));
    if not body_ended {
        do(op_call("_bit_recover_leave"));
        do(op_jmp(le));
    }
    mas bodyend = scopy(ST);
    do(emlab(lf));
    do(ST >> ch(widened));
    bool fail_ended = block(l2(s), c2(s), true);
    mas failend = scopy(ST);
    do(emlab(le));
    if body_ended {
        do(ST >> ch(failend));
    } else if fail_ended {
        do(ST >> ch(bodyend));
    } else {
        do(ST >> ch(merge2(bodyend, failend)));
    }
    return body_ended and fail_ended;
}

fn recover_unwind(num target) {
    for i in target + 1:RECDEP {
        do(op_call("_bit_recover_leave"));
    }
}

# стек меток циклов для break / next
fn loop_push(string brk, string cnt) {
    if LDEP < LBRK >> sz {
        do(mset(LBRK, LDEP, brk));
        do(mset(LCNT, LDEP, cnt));
        do(mset(LREC, LDEP, RECDEP));
        do(mset(LOWN, LDEP, OWNDEP));
    } else {
        do(LBRK >> add(brk));
        do(LCNT >> add(cnt));
        do(LREC >> add(RECDEP));
        do(LOWN >> add(OWNDEP));
    }
    do(LDEP >> ch(LDEP + 1));
}

fn loop_pop() {
    do(LDEP >> ch(LDEP - 1));
}

fn s_break(num s) {
    if LDEP == 0 {
        do(fail("break — только внутри цикла", ln(s)));
    }
    do(drop_locals(LOWN >> get(LDEP - 1, 0)));
    do(recover_unwind(LREC >> get(LDEP - 1, 0)));
    do(op_jmp(LBRK >> get(LDEP - 1, "")));
    return true;
}

fn s_next(num s) {
    if LDEP == 0 {
        do(fail("next — только внутри цикла", ln(s)));
    }
    do(drop_locals(LOWN >> get(LDEP - 1, 0)));
    do(recover_unwind(LREC >> get(LDEP - 1, 0)));
    do(op_jmp(LCNT >> get(LDEP - 1, "")));
    return true;
}

fn s_while(num s) {
    do(ST >> ch(scopy(ST)));
    do(widen_list(l1(s), c1(s)));
    do(widen_node(fa(s)));
    all entry = ST;
    string lt = newlab("wh");
    string le = newlab("wend");
    do(emlab(lt));
    do(cond_jump(fa(s), le));
    mas body = scopy(ST);
    do(narrow(fa(s), true, body));
    do(ST >> ch(body));
    do(loop_push(le, lt));
    do(block(l1(s), c1(s), true));
    do(loop_pop());
    all fin = ST;
    do(op_jmp(lt));
    do(emlab(le));
    do(ST >> ch(merge2(entry, fin)));
    do(narrow(fa(s), false, ST));
    return false;
}

fn s_for(num s) {
    do(ST >> ch(scopy(ST)));
    do(widen_list(l1(s), c1(s)));
    do(widen_node(fa(s)));
    do(widen_node(fb(s)));
    all entry = ST;
    do(sc_push());
    string lt = newlab("for");
    string le = newlab("fend");
    num line = ln(s);
    string vname = fs(s);
    if fb(s) < 0 {
        do(expr(fa(s)));
        if is_map(RT) {
            do(op_acc_to(0));
            do(op_imm(pr(1), source_line(line)));
            do(op_call("_bit_map_keys"));
            do(RT >> ch("mas:string"));
            do(RLK >> ch(false));
        }
        string aty = RT;
        if aty != "?" and not is_seq(aty) {
            do(fail("for v in ... — справа нужен массив или диапазон, например 0:4", line));
        }
        if aty == "mas:?" {
            do(fail("в массиве ещё нет элементов — его тип неизвестен", line));
        }
        string el = "?";
        if aty != "?" {
            do(el >> ch(elem(aty)));
        }
        num sm = slot();
        num sl = slot();
        num si = slot();
        do(op_st(acc(), sm));
        do(op_field(cr("x1"), acc(), 8));
        do(op_st(cr("x1"), sl));
        do(op_stz(si));
        num v = declare(vname, el, line, -1, 1);
        do(emlab(lt));
        do(op_ld(acc(), si));
        do(op_ld(cr("x1"), sl));
        do(op_cmpj(acc(), cr("x1"), "ge", le));
        do(op_ld(cr("x2"), sm));
        do(op_field(cr("x1"), cr("x2"), 8));
        do(op_cmpj(acc(), cr("x1"), "ge", le));
        do(op_field(cr("x2"), cr("x2"), 0));
        if aty == "bytes" {
            if IS_ARM {
                do(em("ldrb w0, [x2, x0]"));
            } else {
                do(em("movzx eax, byte ptr [rdx + rax]"));
            }
        } else if IS_ARM {
            do(em("ldr x0, [x2, x0, lsl #3]"));
        } else {
            do(em("mov rax, [rdx + rax*8]"));
        }
        do(op_st(acc(), vslot(v)));
        mas body = scopy(entry);
        do(sset(body, v, 0, 1));
        if aty == "bytes" {
            do(sset(body, v, 1, 1));
            do(sset(body, v, 2, 0));
            do(sset(body, v, 3, 1));
            do(sset(body, v, 4, 255));
        }
        string lc = newlab("fnext");
        do(ST >> ch(body));
        do(loop_push(le, lc));
        do(block(l1(s), c1(s), true));
        do(loop_pop());
        do(emlab(lc));
        do(op_ld(acc(), si));
        do(op_inc(acc()));
        do(op_st(acc(), si));
        do(op_jmp(lt));
    } else {
        do(expr(fa(s)));
        string aty = RT;
        bool alk = RLK;
        num al = RL;
        if aty != "num" and aty != "?" {
            do(fail("в for i in a:b границы — num", line));
        }
        num sv = slot();
        do(op_st(acc(), sv));
        do(expr(fb(s)));
        string bt = RT;
        bool bhk = RHK;
        num bh = RH;
        if bt != "num" and bt != "?" {
            do(fail("в for i in a:b границы — num", line));
        }
        num se = slot();
        do(op_st(acc(), se));
        num v = declare(vname, "num", line, -1, 1);
        do(op_ld(acc(), sv));
        do(op_st(acc(), vslot(v)));
        do(op_ld(cr("x1"), se));
        do(op_cmpj(acc(), cr("x1"), "gt", le));
        do(emlab(lt));
        mas body = scopy(entry);
        do(sset(body, v, 0, 1));
        if alk and aty == "num" {
            do(sset(body, v, 1, 1));
            do(sset(body, v, 2, al));
        }
        if bhk and bt == "num" {
            do(sset(body, v, 3, 1));
            do(sset(body, v, 4, bh));
        }
        string lc = newlab("fnext");
        do(ST >> ch(body));
        do(loop_push(le, lc));
        do(block(l1(s), c1(s), true));
        do(loop_pop());
        do(emlab(lc));
        do(op_ld(acc(), vslot(v)));
        do(op_ld(cr("x1"), se));
        do(op_cmpj(acc(), cr("x1"), "eq", le));
        do(op_inc(acc()));
        do(op_st(acc(), vslot(v)));
        do(op_jmp(lt));
    }
    all fin = ST;
    do(emlab(le));
    do(sc_pop());
    do(ST >> ch(merge2(entry, fin)));
    return false;
}

fn s_return(num s) {
    string ret = IRET >> get(CUR, "void");
    num e = fa(s);
    num line = ln(s);
    if e < 0 {
        if DRY {
            do(RETS >> add("void"));
        } else if ret != "void" {
            do(fail("функция должна вернуть {tn(ret)}", line));
        }
        do(drop_locals(0));
        do(recover_unwind(0));
        do(op_jmp(RETLAB));
        return true;
    }
    do(expr(e));
    string t = RT;
    if t == "void" {
        do(fail("тут нет значения — функция ничего не возвращает", line));
    }
    if t == "mas:?" {
        do(fail("в массиве ещё нет элементов — его тип неизвестен", line));
    }
    if DRY {
        if t == "?" {
            do(UNKRET >> ch(true));
        } else {
            do(RETS >> add(t));
        }
    } else {
        if ret == "void" {
            do(fail("в этой функции return без значения", line));
        }
        do(coerce(t, ret, line, "функция возвращает " + tn(ret)));
    }
    if is_path(t) and not RFRESH {
        do(op_rt1("_bit_str_retain"));
    }
    if RECDEP > 0 or OWNDEP > 0 {
        do(push());
        do(drop_locals(0));
        do(recover_unwind(0));
        do(pop(acc()));
    }
    do(op_jmp(RETLAB));
    return true;
}

# ── сужение диапазонов по условиям ──

fn range_of(num e) {
    all so = OUT;
    all ss = STUBS;
    mas e1 = (string);
    mas e2 = (string);
    do(OUT >> ch(e1));
    do(STUBS >> ch(e2));
    do(expr(e));
    do(OUT >> ch(so));
    do(STUBS >> ch(ss));
    if RT != "num" {
        do(rng(false, 0, false, 0));
    }
}

fn neg_op(string op) {
    if op == "<" {
        return ">=";
    }
    if op == ">" {
        return "<=";
    }
    if op == "<=" {
        return ">";
    }
    if op == ">=" {
        return "<";
    }
    if op == "==" {
        return "!=";
    }
    return "==";
}

fn flip_op(string op) {
    if op == "<" {
        return ">";
    }
    if op == ">" {
        return "<";
    }
    if op == "<=" {
        return ">=";
    }
    if op == ">=" {
        return "<=";
    }
    return op;
}

fn narrow(num e, bool pos, mas st) {
    string k = kind(e);
    string op = fs(e);
    if k == "un" and op == "not" {
        do(narrow(fa(e), not pos, st));
        return;
    }
    if k == "bin" and (op == "and" or op == "or") {
        if (op == "and") == pos {
            do(narrow(fa(e), pos, st));
            do(narrow(fb(e), pos, st));
        }
        return;
    }
    if k == "bin" and is_cmp(op) {
        string o = op;
        if not pos {
            do(o >> ch(neg_op(op)));
        }
        do(narrow_cmp(fa(e), o, fb(e), st));
        do(narrow_cmp(fb(e), flip_op(o), fa(e), st));
    }
}

fn narrow_cmp(num l, string op, num r, mas st) {
    # условие вида  a >> sz > N  (или >=, ==): в этой ветке в a точно есть хотя бы столько-то
    if kind(l) == "pipe" and fs(l) == "sz" and c1(l) == 0 and kind(fa(l)) == "var" {
        num a = find(fs(fa(l)));
        if a >= 0 and is_seq(vty(a)) and VGLOB >> get(a, 0) == 0 {
            do(range_of(r));
            if RLK and RHK and RL == RH {
                num least = -1;
                if op == ">" {
                    do(least >> ch(RL + 1));
                } else if op == ">=" or op == "==" {
                    do(least >> ch(RL));
                }
                if least > sget(st, a, 5) {
                    do(sset(st, a, 5, least));
                }
            }
        }
    }
    if kind(l) != "var" {
        return;
    }
    num v = find(fs(l));
    if v < 0 or vty(v) != "num" or VGLOB >> get(v, 0) == 1 {
        return;
    }
    num ro = fa(r);
    if op == "<" and kind(r) == "pipe" and fs(r) == "sz" and ro >= 0 and kind(ro) == "var" {
        num a = find(fs(ro));
        if a >= 0 and is_seq(vty(a)) and VGLOB >> get(a, 0) == 0 {
            do(fact_add(st, v, a));
        }
    }
    do(range_of(r));
    bool lk = RLK;
    num lo = RL;
    bool hk = RHK;
    num hi = RH;
    bool nlk = false;
    num nl = 0;
    bool nhk = false;
    num nh = 0;
    if op == "<" and hk and hi > MINV {
        do(nhk >> ch(true));
        do(nh >> ch(hi - 1));
    } else if op == "<=" and hk {
        do(nhk >> ch(true));
        do(nh >> ch(hi));
    } else if op == ">" and lk and lo < MAXV {
        do(nlk >> ch(true));
        do(nl >> ch(lo + 1));
    } else if op == ">=" and lk {
        do(nlk >> ch(true));
        do(nl >> ch(lo));
    } else if op == "==" {
        do(nlk >> ch(lk));
        do(nl >> ch(lo));
        do(nhk >> ch(hk));
        do(nh >> ch(hi));
    } else {
        return;
    }
    bool clk = sget(st, v, 1) == 1;
    num cl = sget(st, v, 2);
    bool chk = sget(st, v, 3) == 1;
    num chv = sget(st, v, 4);
    if nlk {
        if not clk or nl > cl {
            do(sset(st, v, 1, 1));
            do(sset(st, v, 2, nl));
        }
    }
    if nhk {
        if not chk or nh < chv {
            do(sset(st, v, 3, 1));
            do(sset(st, v, 4, nh));
        }
    }
}

# ═══════════════════════ выражения: результат в x0 / rax ═══════════════════════

fn to_str(string t, num line) {
    if record_by_name(t) >= 0 or (is_mas(t) and record_by_name(elem(t)) >= 0) {
        do(fail("у структуры или массива структур выводи нужные поля", line));
    }
    if is_path(t) {
        return;
    }
    if t == "?" {
        do(RFRESH >> ch(false));
        return;
    }
    if t == "void" {
        do(fail("тут нет значения — функция ничего не возвращает", line));
    }
    if record_by_name(t) >= 0 {
        do(fail("у структуры {t} выводи нужные поля, например p >> имя_поля", line));
    }
    if is_map(t) {
        do(fail("у словаря выводи нужное значение через get(ключ)", line));
    }
    if is_fn_value(t) {
        do(fail("функцию можно вызвать, например f(значение)", line));
    }
    if t == "mas:?" {
        do(op_lstr(acc(), "()"));
        do(RFRESH >> ch(false));
        return;
    }
    if t == "bytes" {
        do(op_rt1("_bit_bytes_str"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if t == "proc" {
        do(op_rt1("_bit_num_str"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if is_mas(t) {
        do(op_acc_to(0));
        do(op_imm(pr(1), kind_of(elem(t))));
        do(op_call("_bit_mas_str"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if t == "bool" {
        do(op_rt1("_bit_bool_str"));
        do(RFRESH >> ch(false));
        return;
    }
    if t == "string" {
        do(op_rt1("_bit_string_str"));
        return;
    }
    do(op_rt1("_bit_{t}_str"));
    do(op_rt1("_bit_str_adopt"));
    do(RFRESH >> ch(true));
}

fn expr(num n) {
    string k = kind(n);
    if k == "num" {
        do(op_imm(acc(), fv(n)));
        do(res("num"));
        do(rng(true, fv(n), true, fv(n)));
    } else if k == "dec" {
        do(op_ldmem(acc(), declab(fs(n))));
        do(res("dec"));
    } else if k == "bool" {
        do(op_imm(acc(), fv(n)));
        do(res("bool"));
    } else if k == "str" {
        do(e_str(n));
    } else if k == "var" {
        do(e_var(n));
    } else if k == "un" {
        do(e_un(n));
    } else if k == "bin" {
        do(e_bin(n, ""));
    } else if k == "call" {
        do(e_call(n));
    } else if k == "pipe" {
        do(e_pipe(n, false));
    } else if k == "range" {
        do(fail("диапазон a:b можно писать только в input(...) и for", ln(n)));
    } else if k == "maslit" {
        do(fail("список (1, 2, 3) можно писать только при создании mas", ln(n)));
    } else {
        do(fail("внутренняя ошибка: выражение {k}", ln(n)));
    }
}

fn e_str(num n) {
    bool afresh = false;
    for k in 0:c1(n) - 1 {
        num p = arg(n, k);
        mas parts = (num);
        if k > 0 {
            # Keep the accumulated text alive while the next expression runs.
            num previous = arg(n, k - 1);
            if afresh or kind(previous) != "lit" {
                do(RFRESH >> ch(afresh));
                do(hold_call_string(n, "string", parts));
            }
            do(push());
        }
        bool pfresh = false;
        if kind(p) == "lit" {
            do(op_lstr(acc(), fs(p)));
        } else {
            do(expr(p));
            do(to_str(RT, ln(n)));
            do(pfresh >> ch(RFRESH));
        }
        if k > 0 {
            if pfresh {
                do(hold_call_string(p, "string", parts));
            }
            num ps = slot();
            do(op_st(acc(), ps));               # сохранить часть
            do(pop(pr(0)));                      # прежняя строка -> pr(0)
            do(op_ld(pr(1), ps));              # часть -> pr(1)
            do(op_call("_bit_cat"));            # pr(0) + pr(1)
            do(op_rt1("_bit_str_adopt"));
            do(drop_call_strings(parts));
            do(afresh >> ch(true));
        } else {
            do(afresh >> ch(pfresh));
        }
    }
    do(res("string"));
    do(RFRESH >> ch(afresh));
}

fn fn_value_type(string args, string result) {
    num i = 0;
    for key in FN_VALUE_ARGS {
        if key == args and (FN_VALUE_RET >> get(i, "")) == result {
            return "fn:{i}";
        }
        do(i >> ch(i + 1));
    }
    do(FN_VALUE_ARGS >> add(args));
    do(FN_VALUE_RET >> add(result));
    return "fn:{i}";
}

fn fn_value_ref(num f, num line) {
    mas args = (string);
    for i in 0:c1(f) - 1 {
        string ty = ft(item(l1(f), i));
        if not plain(ty) {
            do(fail("для значения функции {fs(f)} нужны точные типы параметров", line));
        }
        do(args >> add(ty));
    }
    string key = args >> join(",");
    num inst = instance(f, key);
    string result = IRET >> get(inst, "");
    if result == "" {
        do(fail("не удаётся определить тип значения рекурсивной функции {fs(f)}", line));
    }
    do(op_addr(acc(), ILAB >> get(inst, "")));
    do(res(fn_value_type(key, result)));
}

fn e_var(num n) {
    string name = fs(n);
    num line = ln(n);
    if (name == "term" or name == "mem" or name == "net" or name == "os") and find(name) < 0 {
        string ex = "mem >> used";
        if name == "term" {
            do(ex >> ch("term >> args"));
        }
        if name == "net" {
            do(ex >> ch("net >> listen(9100)"));
        }
        if name == "os" {
            do(ex >> ch("os >> host"));
        }
        do(fail("{name} сам по себе не значение — пиши так: {ex}", line));
    }
    num v = find(name);
    if v < 0 {
        num f = fn_by_name(name);
        if f >= 0 {
            do(fn_value_ref(f, line));
            return;
        }
        do(v >> ch(lookup(name, line)));
    }
    bool glob = VGLOB >> get(v, 0) == 1;
    if not glob and sget(ST, v, 0) == 0 {
        do(fail("переменная {name} пустая — сначала положи в неё значение: do({name} >> ch(...));", line));
    }
    do(load_var(acc(), v));
    do(resv(vty(v), v));
    if vty(v) == "num" and not glob {
        do(rng(sget(ST, v, 1) == 1, sget(ST, v, 2), sget(ST, v, 3) == 1, sget(ST, v, 4)));
    }
}

fn e_un(num n) {
    string op = fs(n);
    num line = ln(n);
    do(expr(fa(n)));
    string t = RT;
    bool lk = RLK;
    num lo = RL;
    bool hk = RHK;
    num hi = RH;
    if t == "?" {
        do(res("?"));
        return;
    }
    if op == "not" {
        if t != "bool" {
            do(fail("not работает только с bool, а тут {tn(t)}", line));
        }
        if IS_ARM {
            do(em("eor x0, x0, #1"));
        } else {
            do(em("xor rax, 1"));
        }
        do(res("bool"));
        return;
    }
    if t == "dec" {
        if IS_ARM {
            do(em("fmov d0, x0"));
            do(em("fneg d0, d0"));
            do(em("fmov x0, d0"));
        } else {
            do(em("btc rax, 63"));
        }
        do(res("dec"));
        return;
    }
    if t != "num" {
        do(fail("минус бывает только у чисел, а тут {tn(t)}", line));
    }
    bool nlk = hk and hi != MINV;
    num nl = 0;
    if nlk {
        do(nl >> ch(0 - hi));
    }
    bool nhk = lk;
    num nh = MAXV;
    if lk and lo != MINV {
        do(nh >> ch(0 - lo));
    }
    if lk and lo > MINV {
        if IS_ARM {
            do(em("neg x0, x0"));
        } else {
            do(em("neg rax"));
        }
    } else {
        if lk and hk and lo == MINV and hi == MINV {
            do(fail("переполнение num: результат точно не влезет", line));
        }
        string l = ovf_stub(line);
        if IS_ARM {
            do(em("negs x0, x0"));
            do(em("b.vs {l}"));
        } else {
            do(em("neg rax"));
            do(em("jo {l}"));
        }
    }
    do(res("num"));
    do(rng(nlk, nl, nhk, nh));
}

fn simple_x1(num n) {
    if kind(n) == "num" {
        do(op_imm(cr("x1"), fv(n)));
        do(res("num"));
        do(rng(true, fv(n), true, fv(n)));
        return true;
    }
    if kind(n) == "var" {
        string name = fs(n);
        if (name == "term" or name == "mem") and find(name) < 0 {
            return false;
        }
        num v = lookup(name, ln(n));
        bool glob = VGLOB >> get(v, 0) == 1;
        if not glob and sget(ST, v, 0) == 0 {
            return false;
        }
        do(load_var(cr("x1"), v));
        do(resv(vty(v), v));
        if vty(v) == "num" and not glob {
            do(rng(sget(ST, v, 1) == 1, sget(ST, v, 2), sget(ST, v, 3) == 1, sget(ST, v, 4)));
        }
        return true;
    }
    return false;
}

fn load_d(string lt, string rt) {
    if IS_ARM {
        if lt == "num" {
            do(em("scvtf d0, x0"));
        } else {
            do(em("fmov d0, x0"));
        }
        if rt == "num" {
            do(em("scvtf d1, x1"));
        } else {
            do(em("fmov d1, x1"));
        }
    } else {
        if lt == "num" {
            do(em("cvtsi2sd xmm0, rax"));
        } else {
            do(em("movq xmm0, rax"));
        }
        if rt == "num" {
            do(em("cvtsi2sd xmm1, rcx"));
        } else {
            do(em("movq xmm1, rcx"));
        }
    }
}

fn icond(string op) {
    if op == "<" {
        return "lt";
    }
    if op == "<=" {
        return "le";
    }
    if op == ">" {
        return "gt";
    }
    if op == ">=" {
        return "ge";
    }
    if op == "==" {
        return "eq";
    }
    return "ne";
}

fn x86cond(string op) {
    if op == "<" {
        return "l";
    }
    if op == "<=" {
        return "le";
    }
    if op == ">" {
        return "g";
    }
    if op == ">=" {
        return "ge";
    }
    if op == "==" {
        return "e";
    }
    return "ne";
}

fn fcond(string op) {
    if op == "<" {
        return "mi";
    }
    if op == "<=" {
        return "ls";
    }
    if op == ">" {
        return "gt";
    }
    if op == ">=" {
        return "ge";
    }
    if op == "==" {
        return "eq";
    }
    return "ne";
}

fn x86fcond(string op) {
    if op == "<" {
        return "b";
    }
    if op == "<=" {
        return "be";
    }
    if op == ">" {
        return "a";
    }
    if op == ">=" {
        return "ae";
    }
    if op == "==" {
        return "e";
    }
    return "ne";
}

fn x86_fcmp(string op) {
    if op == "<" {
        do(em("ucomisd xmm1, xmm0"));
        do(em("seta al"));
    } else if op == "<=" {
        do(em("ucomisd xmm1, xmm0"));
        do(em("setae al"));
    } else if op == ">" {
        do(em("ucomisd xmm0, xmm1"));
        do(em("seta al"));
    } else if op == ">=" {
        do(em("ucomisd xmm0, xmm1"));
        do(em("setae al"));
    } else if op == "==" {
        do(em("ucomisd xmm0, xmm1"));
        do(em("sete al"));
        do(em("setnp dl"));
        do(em("and al, dl"));
    } else {
        do(em("ucomisd xmm0, xmm1"));
        do(em("setne al"));
        do(em("setp dl"));
        do(em("or al, dl"));
    }
    do(em("movzx eax, al"));
}

fn jump_cmp_false(string op, string label) {
    string inverse = neg_op(op);
    if IS_ARM {
        do(em("b.{icond(inverse)} {label}"));
    } else {
        do(em("j{x86cond(inverse)} {label}"));
    }
}

fn icmp(string op, string label) {
    do(em("cmp {acc()}, {cr('x1')}"));
    if label != "" {
        do(jump_cmp_false(op, label));
        return;
    }
    if IS_ARM {
        do(em("cset x0, {icond(op)}"));
    } else {
        do(em("set{x86cond(op)} al"));
        do(em("movzx eax, al"));
    }
}

fn immediate_rhs(string left_type, num right) {
    if not OPTIMIZE or left_type != "num" or kind(right) != "num" {
        return -1;
    }
    num value = fv(right);
    if value >= 0 and (value <= 4095 or (not IS_ARM and value <= 2147483647)) {
        return value;
    }
    return -1;
}

fn e_bin(num n, string false_label) {
    string op = fs(n);
    num line = ln(n);
    if op == "and" or op == "or" {
        string lend = newlab("sc");
        do(expr(fa(n)));
        string lt = RT;
        if op == "and" {
            do(op_jz(lend));
        } else {
            do(op_jnz(lend));
        }
        all saved = ST;
        mas inner = scopy(ST);
        do(narrow(fa(n), op == "and", inner));
        do(ST >> ch(inner));
        do(expr(fb(n)));
        all after = ST;
        do(ST >> ch(merge2(saved, after)));
        string rt = RT;
        do(emlab(lend));
        if lt != "bool" and lt != "?" {
            do(fail("{op} работает только с bool, а тут {tn(lt)}", line));
        }
        if rt != "bool" and rt != "?" {
            do(fail("{op} работает только с bool, а тут {tn(rt)}", line));
        }
        do(res("bool"));
        return;
    }
    do(expr(fa(n)));
    string lt = RT;
    num rhs = fb(n);
    mas string_operands = (num);
    bool string_operation = lt == "string" and (op == "+" or is_cmp(op));
    if string_operation {
        bool simple_rhs = kind(rhs) == "var";
        if kind(rhs) == "str" and c1(rhs) == 1 {
            do(simple_rhs >> ch(kind(arg(rhs, 0)) == "lit"));
        }
        if RFRESH or not simple_rhs {
            do(hold_call_string(fa(n), lt, string_operands));
        }
    }
    num immediate = -1;
    if false_label != "" or op == "+" or op == "-" {
        do(immediate >> ch(immediate_rhs(lt, rhs)));
    }
    if false_label != "" and immediate >= 0 {
        if IS_ARM {
            do(em("cmp x0, #{immediate}"));
        } else {
            do(em("cmp rax, {immediate}"));
        }
        do(jump_cmp_false(op, false_label));
        do(res("bool"));
        return;
    }
    do(ALK >> ch(RLK));
    do(AL >> ch(RL));
    do(AHK >> ch(RHK));
    do(AH >> ch(RH));
    bool alk = RLK;
    num al = RL;
    bool ahk = RHK;
    num ah = RH;
    if immediate >= 0 {
        do(res("num"));
        do(rng(true, immediate, true, immediate));
    } else if string_operation {
        do(push());
        do(expr(rhs));
        if RFRESH {
            do(hold_call_string(rhs, RT, string_operands));
        }
        do(op_mov(cr("x1"), acc()));
        do(pop(acc()));
    } else if not simple_x1(rhs) {
        do(push());
        do(expr(rhs));
        do(op_mov(cr("x1"), acc()));
        do(pop(acc()));
    }
    string rt = RT;
    do(ALK >> ch(alk));
    do(AL >> ch(al));
    do(AHK >> ch(ahk));
    do(AH >> ch(ah));
    do(BLK >> ch(RLK));
    do(BL >> ch(RL));
    do(BHK >> ch(RHK));
    do(BH >> ch(RH));
    if lt == "?" or rt == "?" {
        do(drop_call_strings(string_operands));
        do(res("?"));
        return;
    }
    if is_cmp(op) {
        if is_numt(lt) and is_numt(rt) {
            if lt == "dec" or rt == "dec" {
                do(load_d(lt, rt));
                if IS_ARM {
                    do(em("fcmp d0, d1"));
                    do(em("cset x0, {fcond(op)}"));
                } else {
                    do(x86_fcmp(op));
                }
                if false_label != "" {
                    do(op_jz(false_label));
                }
            } else {
                do(icmp(op, false_label));
            }
            do(res("bool"));
            return;
        }
        if op != "==" and op != "!=" {
            do(fail("{op} работает только с числами, а тут {tn(lt)} и {tn(rt)}", line));
        }
        if lt != rt {
            do(fail("нельзя сравнить {tn(lt)} и {tn(rt)}", line));
        }
        if lt == "string" {
            do(op_mov(pr(0), acc()));
            do(op_mov(pr(1), cr("x1")));
            do(op_call("_bit_str_eq"));
            do(drop_call_strings(string_operands));
            if op == "!=" {
                if IS_ARM {
                    do(em("eor x0, x0, #1"));
                } else {
                    do(em("xor rax, 1"));
                }
            }
            if false_label != "" {
                do(op_jz(false_label));
            }
        } else if lt == "bool" {
            do(icmp(op, false_label));
        } else {
            do(fail("массивы пока сравнивать нельзя", line));
        }
        do(res("bool"));
        return;
    }
    if op == "+" and lt == "string" and rt == "string" {
        do(op_mov(pr(0), acc()));
        do(op_mov(pr(1), cr("x1")));
        do(op_call("_bit_cat"));
        do(drop_call_strings(string_operands));
        do(res("string"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if op == "+" and (lt == "string" or rt == "string") {
        do(fail("нельзя сложить {tn(lt)} и {tn(rt)} — для текста с числом пиши \"текст {{x}}\"", line));
    }
    if not is_numt(lt) or not is_numt(rt) {
        do(fail("{op} работает только с числами, а тут {tn(lt)} и {tn(rt)}", line));
    }
    if lt == "dec" or rt == "dec" {
        if op == "%" {
            do(fail("% (остаток) только для num", line));
        }
        do(load_d(lt, rt));
        string ins = "add";
        if op == "-" {
            do(ins >> ch("sub"));
        } else if op == "*" {
            do(ins >> ch("mul"));
        } else if op == "/" {
            do(ins >> ch("div"));
        }
        if IS_ARM {
            do(em("f{ins} d0, d0, d1"));
            do(em("fmov x0, d0"));
        } else {
            do(em("{ins}sd xmm0, xmm1"));
            do(em("movq rax, xmm0"));
        }
        do(res("dec"));
        return;
    }
    do(int_op(op, line, immediate));
}

fn power_remainder(num divisor, bool nonnegative) {
    if divisor == 1 {
        do(op_imm(acc(), 0));
        return;
    }
    if IS_ARM {
        if not nonnegative {
            do(em("asr x2, x0, #63"));
            do(em("eor x0, x0, x2"));
            do(em("sub x0, x0, x2"));
        }
        do(em("and x0, x0, #{divisor - 1}"));
        if not nonnegative {
            do(em("eor x0, x0, x2"));
            do(em("sub x0, x0, x2"));
        }
    } else {
        if not nonnegative {
            do(em("mov rdx, rax"));
            do(em("sar rdx, 63"));
            do(em("xor rax, rdx"));
            do(em("sub rax, rdx"));
        }
        do(em("lea rcx, [rcx - 1]"));
        do(em("and rax, rcx"));
        if not nonnegative {
            do(em("xor rax, rdx"));
            do(em("sub rax, rdx"));
        }
    }
}

fn int_op(string op, num line, num immediate) {
    bool aknown = ALK and AHK;
    bool bknown = BLK and BHK;
    if op == "+" or op == "-" or op == "*" {
        bool clk = false;
        num clf = 0;
        num cl = 0;
        bool chk = false;
        num chf = 0;
        num chv = 0;
        if aknown and bknown and op == "*" {
            do(xmul(AL, BL));
            num f1 = XF;
            num v1 = XV;
            do(xmul(AL, BH));
            num f2 = XF;
            num v2 = XV;
            do(xmul(AH, BL));
            num f3 = XF;
            num v3 = XV;
            do(xmul(AH, BH));
            num f4 = XF;
            num v4 = XV;
            do(clf >> ch(f1));
            do(cl >> ch(v1));
            do(chf >> ch(f1));
            do(chv >> ch(v1));
            if xless(f2, v2, clf, cl) {
                do(clf >> ch(f2));
                do(cl >> ch(v2));
            }
            if xless(f3, v3, clf, cl) {
                do(clf >> ch(f3));
                do(cl >> ch(v3));
            }
            if xless(f4, v4, clf, cl) {
                do(clf >> ch(f4));
                do(cl >> ch(v4));
            }
            if xless(chf, chv, f2, v2) {
                do(chf >> ch(f2));
                do(chv >> ch(v2));
            }
            if xless(chf, chv, f3, v3) {
                do(chf >> ch(f3));
                do(chv >> ch(v3));
            }
            if xless(chf, chv, f4, v4) {
                do(chf >> ch(f4));
                do(chv >> ch(v4));
            }
            do(clk >> ch(true));
            do(chk >> ch(true));
        } else if op == "+" {
            if ALK and BLK {
                do(xadd(AL, BL));
                do(clk >> ch(true));
                do(clf >> ch(XF));
                do(cl >> ch(XV));
            }
            if AHK and BHK {
                do(xadd(AH, BH));
                do(chk >> ch(true));
                do(chf >> ch(XF));
                do(chv >> ch(XV));
            }
        } else if op == "-" {
            if ALK and BHK {
                do(xsub(AL, BH));
                do(clk >> ch(true));
                do(clf >> ch(XF));
                do(cl >> ch(XV));
            }
            if AHK and BLK {
                do(xsub(AH, BL));
                do(chk >> ch(true));
                do(chf >> ch(XF));
                do(chv >> ch(XV));
            }
        }
        if (clk and clf == 1) or (chk and chf == -1) {
            do(fail("переполнение num: результат точно не влезет в число", line));
        }
        bool safe = clk and chk and clf == 0 and chf == 0;
        if op == "+" or op == "-" {
            string ins = "add";
            if op == "-" {
                do(ins >> ch("sub"));
            }
            if IS_ARM {
                if not safe {
                    do(ins >> ch(ins + "s"));
                }
                string operand = "x1";
                if immediate >= 0 {
                    do(operand >> ch("#{immediate}"));
                }
                do(em("{ins} x0, x0, {operand}"));
            } else {
                string operand = "rcx";
                if immediate >= 0 {
                    do(operand >> ch("{immediate}"));
                }
                do(em("{ins} rax, {operand}"));
            }
        } else {
            if IS_ARM {
                if safe {
                    do(em("mul x0, x0, x1"));
                } else {
                    do(em("mul x2, x0, x1"));
                    do(em("smulh x3, x0, x1"));
                    do(em("cmp x3, x2, asr #63"));
                    do(em("b.ne {ovf_stub(line)}"));
                    do(em("mov x0, x2"));
                }
            } else {
                do(em("imul rax, rcx"));
                if not safe {
                    do(em("jo {ovf_stub(line)}"));
                }
            }
        }
        if not safe and op != "*" {
            if IS_ARM {
                do(em("b.vs {ovf_stub(line)}"));
            } else {
                do(em("jo {ovf_stub(line)}"));
            }
        }
        num rl = cl;
        if clf == -1 {
            do(rl >> ch(MINV));
        }
        num rh = chv;
        if chf == 1 {
            do(rh >> ch(MAXV));
        }
        do(res("num"));
        do(rng(clk, rl, chk, rh));
        return;
    }
    if BLK and BHK and BL == 0 and BH == 0 {
        do(fail("деление на ноль", line));
    }
    bool pos = BLK and BL > 0;
    if not pos {
        string lok = newlab("dok");
        string dz = die_stub("деление на ноль", line);
        string ov = ovf_stub(line);
        if IS_ARM {
            do(em("cbz x1, {dz}"));
            do(em("cmn x1, #1"));
            do(em("b.ne {lok}"));
            do(op_imm("x2", MINV));
            do(em("cmp x0, x2"));
            do(em("b.eq {ov}"));
        } else {
            do(em("test rcx, rcx"));
            do(em("jz {dz}"));
            do(em("cmp rcx, -1"));
            do(em("jne {lok}"));
            do(em("mov rdx, {MINV}"));
            do(em("cmp rax, rdx"));
            do(em("je {ov}"));
        }
        do(emlab(lok));
    }
    if OPTIMIZE and op == "%" and pos and BHK and BL == BH and (BL >> bit_and(BL - 1)) == 0 {
        do(power_remainder(BL, ALK and AL >= 0));
    } else if IS_ARM {
        do(em("sdiv x2, x0, x1"));
        if op == "/" {
            do(em("mov x0, x2"));
        } else {
            do(em("msub x0, x2, x1, x0"));
        }
    } else {
        do(em("cqo"));
        do(em("idiv rcx"));
        if op == "%" {
            do(em("mov rax, rdx"));
        }
    }
    do(res("num"));
    if pos {
        if op == "%" and BHK {
            num m = BH - 1;
            if ALK and AL >= 0 {
                do(rng(true, 0, true, m));
            } else {
                do(rng(true, 0 - m, true, m));
            }
        } else if op == "/" and aknown and bknown {
            num q1 = AL / BL;
            num q2 = AL / BH;
            num q3 = AH / BL;
            num q4 = AH / BH;
            num lo = q1;
            num hi = q1;
            if q2 < lo {
                do(lo >> ch(q2));
            }
            if q3 < lo {
                do(lo >> ch(q3));
            }
            if q4 < lo {
                do(lo >> ch(q4));
            }
            if q2 > hi {
                do(hi >> ch(q2));
            }
            if q3 > hi {
                do(hi >> ch(q3));
            }
            if q4 > hi {
                do(hi >> ch(q4));
            }
            do(rng(true, lo, true, hi));
        }
    }
}

fn hint_for(string name) {
    if name == "input" {
        return "input пишется через >>: num x >> input();";
    }
    if name == "len" or name == "size" {
        return "размер массива: a >> sz";
    }
    if name == "get" {
        return "пишется через >>: a >> get(0)";
    }
    if name == "add" {
        return "пишется через >>: do(a >> add(1));";
    }
    if name == "ch" {
        return "пишется через >>: do(x >> ch(5));";
    }
    if name == "sz" {
        return "пишется через >>: a >> sz";
    }
    return "";
}

fn record_store(num offset) {
    if IS_ARM {
        if offset <= 32760 {
            do(em("str x0, [x1, #{offset}]"));
        } else {
            do(op_imm("x16", offset));
            do(em("str x0, [x1, x16]"));
        }
    } else {
        do(em("mov [rcx + {offset}], rax"));
    }
}

fn record_new(num r, num n) {
    num count = c1(r);
    if c1(n) != count {
        do(fail("{fs(r)} ждёт {count} значений по порядку полей, а дали {c1(n)}", ln(n)));
    }
    num saved = slot();
    do(op_imm(pr(0), count * 8));
    do(op_call("_bit_alloc"));
    do(op_st(acc(), saved));
    for i in 0:count - 1 {
        num field = item(l1(r), i);
        do(expr(arg(n, i)));
        do(coerce(RT, ft(field), ln(n), "поле {fs(field)}"));
        do(op_ld(cr("x1"), saved));
        do(record_store(i * 8));
    }
    do(op_ld(acc(), saved));
    do(res(fs(r)));
}

fn record_pipe(num r, num ov, num e, bool writing) {
    string field = fs(e);
    num i = 0;
    while i < c1(r) {
        num f = item(l1(r), i);
        if fs(f) == field {
            num offset = i * 8;
            if c1(e) == 0 and not writing {
                if IS_ARM and offset > 32760 {
                    do(op_imm("x16", offset));
                    do(em("ldr x0, [x0, x16]"));
                } else {
                    do(op_field(acc(), acc(), offset));
                }
                do(res(ft(f)));
                return;
            }
            if not writing or c1(e) != 1 {
                do(fail("прочитать поле: p >> {field}; изменить: do(p >> {field}(значение));", ln(e)));
            }
            do(push());
            do(expr(arg(e, 0)));
            do(coerce(RT, ft(f), ln(e), "поле {field}"));
            do(pop(cr("x1")));
            do(record_store(offset));
            do(op_mov(acc(), cr("x1")));
            do(resv(fs(r), ov));
            return;
        }
        do(i >> ch(i + 1));
    }
    do(fail("в структуре {fs(r)} нет поля {field}", ln(e)));
}

fn hold_call_string(num argument, string ty, mas strings) {
    if is_path(ty) {
        if kind(argument) == "str" and c1(argument) == 1 {
            if kind(arg(argument, 0)) == "lit" {
                return;
            }
        }
        if not RFRESH {
            do(op_rt1("_bit_str_retain"));
        }
        num saved = slot();
        do(NSLOTS >> ch(NSLOTS + 1));
        do(op_st(acc(), saved));
        do(op_slot_addr(saved));
        do(op_call("_bit_own_str"));
        do(op_ld(acc(), saved));
        do(OWNDEP >> ch(OWNDEP + 1));
        do(strings >> add(saved));
    }
}

fn drop_call_strings(mas strings) {
    num count = strings >> sz;
    if count > 0 {
        do(push());
        for saved in strings {
            do(op_call("_bit_drop_owned"));
        }
        do(OWNDEP >> ch(OWNDEP - count));
        do(pop(acc()));
    }
}

fn split_args(num ac) {
    num argregs = 6;
    if IS_ARM {
        do(argregs >> ch(8));
    }
    num extra = ac - argregs;
    if extra < 0 {
        do(extra >> ch(0));
    }
    while ARGS_SLOTS >> sz > 0 {
        do(ARGS_SLOTS >> pop);
    }
    do(ARGS_ARG0 >> ch(-1));
    if extra > 0 {
        for j in 0:extra - 1 {
            num s = slot();
            do(pop(pr(0)));
            do(op_st(pr(0), s));
            do(ARGS_SLOTS >> add(s));
        }
    }
    num k = argregs - 1;
    if k > ac - 1 {
        do(k >> ch(ac - 1));
    }
    while k >= 1 {
        do(pop(pr(k)));
        do(k >> ch(k - 1));
    }
    if ac > 0 {
        num a0 = slot();
        do(ARGS_ARG0 >> ch(a0));
        do(pop(pr(0)));
        do(op_st(pr(0), a0));
    }
    return extra;
}

fn push_extra_args(num extra) {
    if extra > 0 {
        for s in ARGS_SLOTS {
            do(op_ld(acc(), s));
            do(push());
        }
    }
    if ARGS_ARG0 >= 0 {
        do(op_ld(pr(0), ARGS_ARG0));
    }
}

fn fn_value_call(num n, string ty) {
    num sig = ty >> bytes >> text(3, 1000) >> num;
    mas args = split(FN_VALUE_ARGS >> get(sig, ""), 44);
    num count = args >> sz;
    num line = ln(n);
    if c1(n) != count {
        do(fail("{fs(n)} ждёт {count} значений, а дали {c1(n)}", line));
    }
    mas strings = (num);
    do(e_var(n));
    do(push());
    for i in 0:count - 1 {
        do(expr(arg(n, i)));
        do(coerce(RT, args >> get(i, ""), line, "аргумент {fs(n)}"));
        do(hold_call_string(arg(n, i), args >> get(i, ""), strings));
        do(push());
    }
    num extra = split_args(count);
    if IS_ARM {
        do(pop("x16"));
    } else {
        do(pop("r11"));
    }
    do(push_extra_args(extra));
    if IS_ARM {
        do(em("blr x16"));
    } else {
        do(em("call r11"));
    }
    do(drop_extra_args(extra));
    do(drop_call_strings(strings));
    do(res(FN_VALUE_RET >> get(sig, "")));
    do(RFRESH >> ch(is_path(RT)));
}

fn drop_extra_args(num extra) {
    if extra > 0 {
        if IS_ARM {
            do(em("add sp, sp, #{extra * 16}"));
        } else {
            do(em("add rsp, {extra * 16}"));
        }
    }
}

fn e_call(num n) {
    string name = fs(n);
    num line = ln(n);
    num binding = find(name);
    if binding >= 0 and is_fn_value(vty(binding)) {
        do(fn_value_call(n, vty(binding)));
        return;
    }
    num record_id = record_by_name(name);
    if record_id >= 0 {
        do(record_new(record_id, n));
        return;
    }
    num f = fn_by_name(name);
    # Internal constants describe the platform of the generated program.
    # A user-defined function of the same name keeps normal precedence.
    if f < 0 and binding < 0 and (name == "_bitc_host_arch" or name == "_bitc_host_os") {
        if c1(n) != 0 { do(fail("internal host constant expects no arguments", line)); }
        string value = "macos";
        if name == "_bitc_host_arch" {
            do(value >> ch("x86_64"));
            if IS_ARM { do(value >> ch("arm64")); }
        } else if IS_LINUX { do(value >> ch("linux")); }
        else if IS_WINDOWS { do(value >> ch("windows")); }
        do(op_lstr(acc(), value));
        do(res("string"));
        return;
    }
    if f < 0 and binding < 0 and name == "_bitc_mkdtemp" {
        if c1(n) != 1 { do(fail("internal temp directory expects one path", line)); }
        num a = arg(n, 0);
        do(expr(a));
        do(coerce(RT, "string", ln(a), "internal temp directory"));
        mas strings = (num);
        do(hold_call_string(a, "string", strings));
        do(op_acc_to(0));
        do(op_imm(pr(1), source_line(line)));
        do(op_call("_bit_mkdtemp"));
        do(drop_call_strings(strings));
        do(res("string"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if f < 0 and binding < 0 and name == "_bitc_run_direct" {
        if c1(n) != 1 { do(fail("internal direct run expects one array", line)); }
        num a = arg(n, 0);
        do(expr(a));
        if RT != "mas:string" { do(fail("internal direct run expects string arguments", line)); }
        do(op_acc_to(0));
        do(op_imm(pr(1), source_line(line)));
        do(op_call("_bit_compiler_run_direct"));
        do(res("num"));
        return;
    }
    if f < 0 {
        string h = hint_for(name);
        if h != "" {
            do(fail(h, line));
        }
        if find(name) >= 0 {
            do(fail("{name} — переменная, а не функция", line));
        }
        do(fail("функции {name} нет", line));
    }
    num pc = c1(f);
    num ac = c1(n);
    if ac != pc {
        do(fail("{name} ждёт {pc} значений, а дали {ac}", line));
    }
    mas key = (string);
    mas strings = (num);
    bool unk = false;
    for k in 0:ac - 1 {
        num a = arg(n, k);
        num p = item(l1(f), k);
        string pty = ft(p);
        string pname = fs(p);
        do(expr(a));
        string t = RT;
        if t == "void" {
            do(fail("тут нет значения — функция ничего не возвращает", ln(a)));
        }
        string pt = pty;
        if t == "?" {
            do(unk >> ch(true));
            do(pt >> ch("?"));
        } else if pty == "all" or pty == "mas" or pty == "map" {
            if pty == "mas" and not is_mas(t) {
                do(fail("параметр {pname} — mas, а тут {tn(t)}", ln(a)));
            }
            if pty == "map" and not is_map(t) {
                do(fail("параметр {pname} — map, а тут {tn(t)}", ln(a)));
            }
            if t == "mas:?" {
                do(fail("в массиве ещё нет элементов — его тип неизвестен", ln(a)));
            }
            do(pt >> ch(t));
        } else {
            do(coerce(t, pty, ln(a), "параметр {pname}"));
        }
        do(key >> add(pt));
        do(hold_call_string(a, pt, strings));
        do(push());
    }
    num extra = split_args(ac);
    if unk {
        do(drop_call_strings(strings));
        do(res("?"));
        return;
    }
    num inst = instance(f, key >> join(","));
    string r = IRET >> get(inst, "");
    if r == "" {
        if DRY {
            do(drop_call_strings(strings));
            do(res("?"));
            return;
        }
        do(fail("не могу понять, что возвращает {name} — функции вызывают друг друга по кругу", line));
    }
    do(push_extra_args(extra));
    do(op_call(ILAB >> get(inst, "")));
    do(drop_extra_args(extra));
    do(drop_call_strings(strings));
    do(res(r));
    do(RFRESH >> ch(is_path(r)));
}

# ── действия через >> ──

fn vset(string f, string a, string r, bool lf) {
    do(MF >> ch(f));
    do(MA >> ch(a));
    do(MR >> ch(r));
    do(MLF >> ch(lf));
    return true;
}

fn vm(string t, string m) {
    if t == "file" or t == "dir" {
        if m == "permissions" {
            return vset("_bit_permissions_get", "", "string", true);
        }
        if m == "read_only" {
            return vset("_bit_read_only_get", "", "bool", true);
        }
    }
    if t == "file" {
        if m == "read" {
            return vset("_bit_file_read", "", "string", true);
        }
        if m == "lines" {
            return vset("_bit_file_lines", "", "mas:string", true);
        }
        if m == "exists" {
            return vset("_bit_file_exists", "", "bool", false);
        }
        if m == "modified" {
            return vset("_bit_file_mtime", "", "num", true);
        }
        if m == "sz" {
            return vset("_bit_file_size", "", "num", true);
        }
        if m == "name" {
            return vset("_bit_basename", "", "string", false);
        }
        if m == "path" {
            return vset("", "", "string", false);
        }
    }
    if (t == "string" or t == "num") and m == "proc" {
        if t == "num" {
            return vset("", "", "proc", false);
        }
        return vset("_bit_proc_find", "", "proc", true);
    }
    if t == "string" and m == "start" {
        return vset("_bit_proc_start", "", "proc", true);
    }
    if t == "string" and m == "connect" {
        return vset("_bit_tcp_connect", "", "conn", true);
    }
    if t == "string" and m == "udp" {
        return vset("_bit_udp_connect", "", "conn", true);
    }
    if t == "string" and m == "ip" {
        return vset("_bit_resolve", "", "string", true);
    }
    if t == "string" and m == "num" {
        return vset("_bit_str_num_checked", "", "num", true);
    }
    if t == "string" and m == "lines" {
        return vset("_bit_str_lines", "", "mas:string", false);
    }
    if t == "string" and m == "ping" {
        return vset("_bit_ping", "", "bool", false);
    }
    if t == "string" and m == "fetch" {
        return vset("_bit_fetch", "", "string", true);
    }
    if t == "string" and m == "post" {
        return vset("_bit_http_post", "string", "string", true);
    }
    if t == "server" and m == "accept" {
        return vset("_bit_tcp_accept", "", "conn", true);
    }
    if t == "conn" and m == "peer" {
        return vset("_bit_sock_peer", "", "string", true);
    }
    if t == "conn" and m == "recv" {
        return vset("_bit_sock_recv", "", "string", true);
    }
    if t == "conn" and m == "recv_bytes" {
        return vset("_bit_sock_recv_bytes", "num,num", "bytes", true);
    }
    if t == "string" and m == "hex" {
        return vset("_bit_str_hex", "", "num", false);
    }
    if t == "string" and m == "find" {
        return vset("_bit_str_index", "string", "num", false);
    }
    if t == "string" and m == "contains" {
        return vset("_bit_str_contains", "string", "bool", false);
    }
    if t == "string" and m == "upper" {
        return vset("_bit_str_upper", "", "string", false);
    }
    if t == "string" and m == "lower" {
        return vset("_bit_str_lower", "", "string", false);
    }
    if t == "string" and m == "code" {
        return vset("_bit_str_code", "", "num", true);
    }
    if t == "string" and m == "repeat" {
        return vset("_bit_str_repeat", "num", "string", true);
    }
    if t == "num" and m == "char" {
        return vset("_bit_num_char", "", "string", true);
    }
    if t == "proc" {
        if m == "pid" {
            return vset("", "", "num", false);
        }
        if m == "name" {
            return vset("_bit_proc_name", "", "string", false);
        }
        if m == "alive" {
            return vset("_bit_proc_alive", "", "bool", false);
        }
        if m == "wait" {
            return vset("_bit_proc_wait", "", "num", false);
        }
    }
    if (IS_LINUX or IS_WINDOWS) and t == "proc" {
        if m == "maps" {
            return vset("_bit_proc_maps", "", "mas:string", true);
        }
        if m == "read" {
            return vset("_bit_proc_read_num", "num", "num", true);
        }
        if m == "grab" {
            return vset("_bit_proc_read", "num,num", "bytes", true);
        }
        if m == "scan" {
            return vset("_bit_proc_scan", "num", "mas:num", true);
        }
    }
    if t == "bytes" and m == "read" {
        return vset("_bit_bytes_num", "num", "num", true);
    }
    if t == "file" and m == "load" {
        return vset("_bit_file_load", "", "bytes", true);
    }
    if t == "bytes" and m == "text" {
        return vset("_bit_bytes_text", "", "string", false);
    }
    if t == "bytes" and m == "addr" {
        return vset("_bit_bytes_addr", "", "num", false);
    }
    if t == "dir" {
        if m == "exists" {
            return vset("_bit_dir_exists", "", "bool", false);
        }
        if m == "list" {
            return vset("_bit_dir_list", "", "mas:string", true);
        }
        if m == "walk" {
            return vset("_bit_dir_walk", "", "mas:string", true);
        }
        if m == "name" {
            return vset("_bit_basename", "", "string", false);
        }
        if m == "path" {
            return vset("", "", "string", false);
        }
        if m == "file" {
            return vset("join", "string", "file", false);
        }
        if m == "dir" {
            return vset("join", "string", "dir", false);
        }
    }
    if t == "string" {
        if m == "open" {
            return vset("", "", "file", false);
        }
        if m == "folder" {
            return vset("", "", "dir", false);
        }
        if m == "run" {
            return vset("_bit_run", "", "string", true);
        }
        if m == "bytes" {
            return vset("_bit_str_bytes", "", "mas:num", false);
        }
    }
    if t == "mas:num" and m == "text" {
        return vset("_bit_mas_text", "num,num", "string", false);
    }
    if t == "mas:string" and m == "join" {
        return vset("_bit_mas_join", "string", "string", false);
    }
    return false;
}

fn aset(string f, string a, bool lf, string mode) {
    do(MF >> ch(f));
    do(MA >> ch(a));
    do(MLF >> ch(lf));
    do(MMODE >> ch(mode));
    return true;
}

fn am(string t, string m) {
    if t == "file" or t == "dir" {
        if m == "permissions" {
            return aset("_bit_permissions_set", "string", true, "");
        }
        if m == "read_only" {
            return aset("_bit_read_only_set", "bool", true, "");
        }
    }
    if t == "file" {
        if m == "write" {
            return aset("_bit_file_write", "string", true, "Lrt_w");
        }
        if m == "append" {
            return aset("_bit_file_write", "string", true, "Lrt_a");
        }
        if m == "remove" or m == "delete" {
            return aset("_bit_file_remove", "", true, "");
        }
        if m == "copy" {
            return aset("_bit_copy", "string", true, "");
        }
        if m == "save" {
            return aset("_bit_file_save", "bytes", true, "");
        }
    }
    if t == "bytes" and m == "write" {
        return aset("_bit_bytes_put", "num,num", true, "");
    }
    if t == "thread" and m == "wait" {
        return aset("_bit_thread_wait", "", false, "");
    }
    if t == "lock" and m == "enter" {
        return aset("_bit_user_lock_enter", "", true, "");
    }
    if t == "lock" and m == "leave" {
        return aset("_bit_user_lock_leave", "", true, "");
    }
    if t == "bytes" and m == "free" {
        return aset("_bit_bytes_free", "", false, "");
    }
    if t == "proc" and m == "kill" {
        return aset("_bit_proc_kill", "", true, "");
    }
    if (IS_LINUX or IS_WINDOWS) and t == "proc" {
        if m == "write" {
            return aset("_bit_proc_write_num", "num,num", true, "");
        }
        if m == "paste" {
            return aset("_bit_proc_write", "num,bytes", true, "");
        }
    }
    if t == "dir" {
        if m == "make" {
            return aset("_bit_dir_make", "", true, "");
        }
        if m == "remove_all" {
            return aset("_bit_dir_remove_all", "", true, "");
        }
        if m == "remove" or m == "delete" {
            return aset("_bit_dir_remove", "", true, "");
        }
    }
    if t == "string" and m == "run" {
        return aset("_bit_run_live", "", false, "");
    }
    if t == "conn" and m == "send" {
        return aset("_bit_sock_send", "string", true, "");
    }
    if t == "string" and m == "download" {
        return aset("_bit_download", "string", true, "");
    }
    if (t == "conn" or t == "server") and m == "close" {
        return aset("_bit_sock_close", "", false, "");
    }
    return false;
}

fn acts_of(string t) {
    if t == "file" {
        return "write, append, save, delete, copy, move, read_only, permissions";
    }
    if t == "dir" {
        return "make, delete, remove_all, read_only, permissions";
    }
    if is_mas(t) {
        return "add, set, sort";
    }
    if t == "bytes" {
        return "add, set, write, free";
    }
    if t == "proc" {
        return "write, paste, kill";
    }
    if t == "conn" {
        return "send, close";
    }
    if t == "server" {
        return "close";
    }
    if t == "string" {
        return "run";
    }
    return "";
}

fn is_builtin(num n) {
    if n < 0 or kind(n) != "var" {
        return false;
    }
    return (fs(n) == "term" or fs(n) == "mem" or fs(n) == "net" or fs(n) == "os"
        or fs(n) == "random") and find(fs(n)) < 0;
}

fn rt_call(string f, bool has_obj, num m, string argstr, bool lf, string mode) {
    mas ats = split(argstr, 44);
    mas string_args = (num);
    num na = ats >> sz;
    num ac = c1(m);
    string mn = fs(m);
    if ac != na {
        if na > 0 {
            do(fail("{mn} ждёт {na} значение: {mn}(...)", ln(m)));
        }
        do(fail("{mn} пишется без скобок и значений", ln(m)));
    }
    num n0 = 0;
    if has_obj {
        do(n0 >> ch(1));
    }
    if has_obj and na > 0 {
        do(push());
    }
    for k in 0:na - 1 {
        num a = arg(m, k);
        if kind(a) == "range" {
            do(fail("в {mn} диапазон не нужен", ln(a)));
        }
        do(expr(a));
        do(coerce(RT, ats >> get(k, ""), ln(a), "{mn}(...)"));
        # Map insertion captures keys and values; it needs container ownership first.
        if f != "_bit_map_set" {
            do(hold_call_string(a, ats >> get(k, ""), string_args));
        }
        do(push());
    }
    num total = n0 + na;
    num k = total - 1;
    while k >= n0 {
        do(pop(pr(k)));
        do(k >> ch(k - 1));
    }
    if has_obj {
        if na > 0 {
            do(pop(pr(0)));
        } else {
            do(op_acc_to(0));
        }
    }
    num reg = total;
    if lf {
        do(op_imm(pr(reg), source_line(ln(m))));
        do(reg >> ch(reg + 1));
    }
    if mode != "" {
        do(op_addr(pr(reg), mode));
    }
    do(op_call(f));
    do(drop_call_strings(string_args));
}

fn term_action(num e) {
    string mn = fs(e);
    num line = ln(e);
    if fs(fa(e)) == "random" {
        if mn != "seed" {
            do(fail("у random действие одно: do(random >> seed(\"слово\"));", line));
        }
        do(rt_call("_bit_random_seed", false, e, "string", false, ""));
        return;
    }
    if fs(fa(e)) == "term" {
        if mn == "go" {
            if c1(e) != 1 or kind(arg(e, 0)) == "range" {
                do(fail("go ждёт путь: do(term >> go(путь));", line));
            }
            do(expr(arg(e, 0)));
            if RT != "?" and RT != "string" and RT != "dir" {
                do(fail("go ждёт string или dir, а тут {tn(RT)}", line));
            }
            do(op_acc_to(0));
            do(op_imm(pr(1), source_line(line)));
            do(op_call("_bit_term_go"));
            return;
        }
        if mn == "env" {
            do(rt_call("_bit_env_set", false, e, "string,string", true, ""));
            return;
        }
        if mn == "clear" {
            do(rt_call("_bit_clear", false, e, "", false, ""));
            return;
        }
        if mn == "wait" {
            do(rt_call("_bit_wait", false, e, "num", false, ""));
            return;
        }
        if mn == "raw" {
            if c1(e) != 1 or kind(arg(e, 0)) == "range" {
                do(fail("raw ждёт режим: do(term >> raw(true));", line));
            }
            do(expr(arg(e, 0)));
            do(coerce(RT, "bool", line, "режим raw"));
            do(op_acc_to(0));
            do(op_imm(pr(1), 0));
            do(op_call("_bit_term_raw"));
            return;
        }
        if mn == "exit" {
            do(rt_call("_bit_exit", false, e, "num", false, ""));
            return;
        }
        do(fail("у term нет действия {mn}. Есть: clear, wait, exit, go, env, raw", line));
    }
    do(fail("у mem нет действий — только значения: mem >> used, mem >> total", line));
}

# действие над объектом в x0 / rax; результат — тот же объект, чтобы цепочка шла дальше
# f >> move(куда) — системное переименование.
fn file_move(num e, num line) {
    if c1(e) != 1 or kind(arg(e, 0)) == "range" {
        do(fail("move(куда), например f >> move(\"/новый/путь\")", line));
    }
    num srcsl = slot();
    do(op_st(acc(), srcsl));
    do(expr(arg(e, 0)));
    do(coerce(RT, "string", line, "move(куда)"));
    do(op_acc_to(1));
    do(op_ld(pr(0), srcsl));
    do(op_imm(pr(2), source_line(line)));
    do(op_call("_bit_move"));
}

# insert(i, v) / remove(i) / pop — меняют массив; объект уже в acc
fn mas_mut(string ot, num ov, num known, num e, string mn, num line) {
    if ot == "mas:?" {
        do(fail("в массиве ещё нет элементов — {mn} нечего менять", line));
    }
    string el = elem(ot);
    if mn == "pop" {
        if c1(e) > 0 {
            do(fail("pop пишется без скобок: do(a >> pop)", line));
        }
        string ls = newlab("pop");
        if IS_ARM {
            do(em("ldr x1, [x0, #8]"));
            do(em("cbz x1, {ls}"));
            do(em("sub x1, x1, #1"));
            do(em("str x1, [x0, #8]"));
        } else {
            do(em("mov rcx, [rax + 8]"));
            do(em("test rcx, rcx"));
            do(em("jz {ls}"));
            do(em("dec rcx"));
            do(em("mov [rax + 8], rcx"));
        }
        do(emlab(ls));
        if ov >= 0 and msz_of(ov) > 0 {
            do(sset(ST, ov, 5, msz_of(ov) - 1));
        }
        return;
    }
    if mn == "remove" {
        if c1(e) != 1 or kind(arg(e, 0)) == "range" {
            do(fail("remove(номер) — один номер, например remove(0)", line));
        }
        do(push());
        do(expr(arg(e, 0)));
        if RT != "num" and RT != "?" {
            do(fail("номер в remove должен быть num, а тут {tn(RT)}", line));
        }
        if RT == "num" {
            do(prove_index(ov, known, arg(e, 0), line));
        }
        do(op_acc_to(1));
        do(pop(pr(0)));
        do(seq_check(pr(0), pr(1), line));
        do(op_call("_bit_mas_remove"));
        if ov >= 0 and msz_of(ov) > 0 {
            do(sset(ST, ov, 5, msz_of(ov) - 1));
        }
        return;
    }
    if c1(e) != 2 {
        do(fail("insert(номер, значение), например insert(0, 5)", line));
    }
    do(push());
    do(expr(arg(e, 0)));
    if RT != "num" and RT != "?" {
        do(fail("номер в insert должен быть num, а тут {tn(RT)}", line));
    }
    if RT == "num" {
        do(prove_index(ov, known, arg(e, 0), line));
    }
    do(push());
    do(expr(arg(e, 1)));
    do(coerce(RT, el, line, "значение в insert"));
    do(op_acc_to(2));
    do(pop(pr(1)));
    do(pop(pr(0)));
    do(seq_check(pr(0), pr(1), line));
    do(op_imm(pr(3), source_line(line)));
    do(op_call("_bit_mas_insert"));
    if ov >= 0 {
        num nn = msz_of(ov) + 1;
        num lim = VLIM >> get(ov, -1);
        if lim >= 0 and nn > lim {
            do(fail("в {VN >> get(ov, '')} уже {lim} элементов — лимит {lim}, больше не влезет", line));
        }
        do(sset(ST, ov, 5, nn));
    }
}

# first / last — первый и последний элемент; с запасом безопасны на пустом
fn mas_end(string ot, num ov, num known, num n, string mn, num line) {
    if ot == "mas:?" {
        do(fail("в массиве ещё нет элементов — {mn} нечего взять", line));
    }
    string el = elem(ot);
    if c1(n) == 0 {
        do(prove_nonempty(ov, known, mn, line));
        do(op_imm(cr("x1"), 0));
        do(seq_check(acc(), cr("x1"), line));
        if mn == "first" {
            if IS_ARM {
                do(em("ldr x0, [x0]"));
                do(em("ldr x0, [x0]"));
            } else {
                do(em("mov rax, [rax]"));
                do(em("mov rax, [rax]"));
            }
        } else {
            if IS_ARM {
                do(em("ldr x1, [x0, #8]"));
                do(em("sub x1, x1, #1"));
                do(em("ldr x0, [x0]"));
                do(em("ldr x0, [x0, x1, lsl #3]"));
            } else {
                do(em("mov rcx, [rax + 8]"));
                do(em("dec rcx"));
                do(em("mov rax, [rax]"));
                do(em("mov rax, [rax + rcx*8]"));
            }
        }
        do(res(el));
        return;
    }
    if c1(n) != 1 or kind(arg(n, 0)) == "range" {
        do(fail("{mn} или {mn}(запас), например {mn}(0)", line));
    }
    string ld = newlab("fd");
    string le = newlab("fe");
    if mn == "first" {
        if IS_ARM {
            do(em("mov x1, #0"));
        } else {
            do(em("xor ecx, ecx"));
        }
    } else {
        if IS_ARM {
            do(em("ldr x1, [x0, #8]"));
            do(em("sub x1, x1, #1"));
        } else {
            do(em("mov rcx, [rax + 8]"));
            do(em("dec rcx"));
        }
    }
    if IS_ARM {
        do(em("ldr x4, [x0, #8]"));
        do(em("cmp x1, x4"));
        do(em("b.hs {ld}"));
        do(em("ldr x2, [x0]"));
        do(em("ldr x0, [x2, x1, lsl #3]"));
    } else {
        do(em("mov rdi, [rax + 8]"));
        do(em("cmp rcx, rdi"));
        do(em("jae {ld}"));
        do(em("mov rdx, [rax]"));
        do(em("mov rax, [rdx + rcx*8]"));
    }
    do(op_jmp(le));
    do(emlab(ld));
    all before = ST;
    mas alt = scopy(ST);
    do(ST >> ch(alt));
    do(expr(arg(n, 0)));
    do(coerce(RT, el, line, "запас в {mn}"));
    all after = ST;
    do(ST >> ch(merge2(before, after)));
    do(emlab(le));
    do(res(el));
}

fn prove_nonempty(num ov, num known, string mn, num line) {
    num msz = seq_min(ov, known);
    if msz < 1 {
        string name = "массив";
        if ov >= 0 {
            do(name >> ch(VN >> get(ov, "")));
        }
        do(fail("{name} может быть пуст — дай запас ({mn}(запас)) или проверь a >> sz", line));
    }
}

fn sort_by(num e, string ot, bool in_do, num line, bool down) {
    num keyexpr = arg(e, 0);
    if not in_do {
        do(op_acc_to(0));
        do(op_imm(pr(1), 0));
        do(op_imm(pr(2), MAXV));
        do(op_call("_bit_mas_slice"));
    }
    num sm = slot();
    num sr = slot();
    num si = slot();
    do(op_st(acc(), sm));
    do(op_imm(pr(0), -1));
    do(op_imm(pr(1), 0));
    do(op_call("_bit_mas_new"));
    do(op_st(acc(), sr));
    do(op_stz(si));
    do(ST >> ch(scopy(ST)));
    all entry = ST;
    do(sc_push());
    string el = elem(ot);
    num itv = declare("it", el, line, -1, 1);
    string lt = newlab("sk");
    string le = newlab("skend");
    do(emlab(lt));
    do(op_ld(acc(), si));
    do(op_ld(cr("x1"), sm));
    do(op_field(cr("x1"), cr("x1"), 8));
    do(op_cmpj(acc(), cr("x1"), "ge", le));
    do(op_ld(cr("x2"), sm));
    do(op_field(cr("x2"), cr("x2"), 0));
    if IS_ARM {
        do(em("ldr x0, [x2, x0, lsl #3]"));
    } else {
        do(em("mov rax, [rdx + rax*8]"));
    }
    mas body = scopy(entry);
    do(ST >> ch(body));
    do(op_st(acc(), vslot(itv)));
    do(sset(ST, itv, 0, 1));
    do(expr(keyexpr));
    string kt = RT;
    if kt != "num" and kt != "string" {
        do(fail("sort(it >> ...) должен давать num или string, а тут {tn(kt)}", line));
    }
    do(op_acc_to(1));
    do(op_ld(pr(0), sr));
    do(op_imm(pr(2), source_line(line)));
    do(op_call("_bit_mas_add"));
    do(op_ld(acc(), si));
    do(op_inc(acc()));
    do(op_st(acc(), si));
    do(op_jmp(lt));
    do(emlab(le));
    all fin = ST;
    do(sc_pop());
    do(ST >> ch(merge2(entry, fin)));
    do(op_ld(pr(0), sm));
    do(op_ld(pr(1), sr));
    do(op_imm(pr(2), kind_of(kt)));
    if down {
        do(op_imm(pr(3), 1));
    } else {
        do(op_imm(pr(3), 0));
    }
    do(op_imm(pr(4), source_line(line)));
    do(op_call("_bit_mas_sort_by"));
    do(op_ld(acc(), sm));
    do(res(ot));
    do(RMSZ >> ch(-1));
}

fn sort_pipe(string ot, num ov, num e, bool in_do) {
    num line = ln(e);
    if ot == "mas:?" {
        do(fail("в массиве ещё нет элементов — sort нечего сортировать", line));
    }
    if c1(e) > 0 {
        if c1(e) > 2 {
            do(fail("sort(it >> поле) и необязательное \"down\"", line));
        }
        bool down = false;
        if c1(e) == 2 {
            num a1 = arg(e, 1);
            bool ok = false;
            if kind(a1) == "str" and c1(a1) == 1 {
                num part = item(l1(a1), 0);
                do(ok >> ch(kind(part) == "lit" and fs(part) == "down"));
            }
            if not ok {
                do(fail("второй аргумент sort — \"down\" для убывания", line));
            }
            do(down >> ch(true));
        }
        do(sort_by(e, ot, in_do, line, down));
        return;
    }
    if record_by_name(elem(ot)) >= 0 {
        do(fail("sort не задаёт порядок для структур; укажи поле: sort(it >> поле)", line));
    }
    num known = RMSZ;
    if not in_do {
        do(known >> ch(seq_min(ov, known)));
        # The slice clamps its end to the actual length, including empty arrays.
        do(op_acc_to(0));
        do(op_imm(pr(1), 0));
        do(op_imm(pr(2), MAXV));
        do(op_call("_bit_mas_slice"));
        do(ov >> ch(-1));
    }
    do(push());
    do(op_acc_to(0));
    do(op_imm(pr(1), kind_of(elem(ot))));
    do(op_call("_bit_mas_sort"));
    do(pop(acc()));
    do(resv(ot, ov));
    do(RMSZ >> ch(known));
}

fn valid_permissions(string value) {
    mas chars = value >> bytes;
    mas pattern = "rwxrwxrwx" >> bytes;
    if chars >> sz != 9 {
        return false;
    }
    for i in 0:8 {
        num c = chars >> get(i, 0);
        if c != 45 and c != pattern >> get(i, 0) {
            return false;
        }
    }
    return true;
}

fn permission_literal(num e) {
    if c1(e) == 1 {
        num a = arg(e, 0);
        if kind(a) == "str" and c1(a) == 1 {
            num part = item(l1(a), 0);
            if kind(part) == "lit" and not valid_permissions(fs(part)) {
                do(fail("permissions: нужны ровно 9 символов rwx на своих местах или -, например \"rw-r-----\"", ln(e)));
            }
        }
    }
}

fn act_on(num e, string ot, num ov, bool top) {
    string mn = fs(e);
    num line = ln(e);
    if (ot == "file" or ot == "dir") and (mn == "permissions" or mn == "read_only") {
        if c1(e) == 0 and not top {
            return false;
        }
        if mn == "permissions" {
            do(permission_literal(e));
        }
    }
    if top {
        if is_map(ot) {
            do(map_action(ot, ov, e));
            return true;
        }
        num record_id = record_by_name(ot);
        if record_id >= 0 {
            do(record_pipe(record_id, ov, e, true));
            return true;
        }
    }
    if top and is_mas(ot) and mn == "sort" {
        do(sort_pipe(ot, ov, e, true));
        return true;
    }
    bool masact = is_seq(ot) and mn == "set";
    bool masmut = is_mas(ot) and (mn == "insert" or mn == "remove" or mn == "pop");
    bool filemv = ot == "file" and mn == "move";
    bool masrun = is_mas(ot) and mn == "run" and top;
    bool found = false;
    if mn == "add" or masact or masmut or filemv or masrun {
        do(found >> ch(true));
    } else if not (ot == "string" and mn == "run" and not top) {
        do(found >> ch(am(ot, mn)));
    }
    if not found {
        return false;
    }
    string f = MF;
    string a = MA;
    bool lf = MLF;
    string mode = MMODE;
    num known = RMSZ;
    num tmp = slot();
    do(op_st(acc(), tmp));
    if mn == "add" {
        do(add_item(ot, ov, e, line));
    } else if filemv {
        do(file_move(e, line));
    } else if masrun {
        do(mas_run_live(ot, e, line));
    } else if masmut {
        do(mas_mut(ot, ov, known, e, mn, line));
    } else if mn == "set" {
        do(set_item(ot, ov, known, e, line));
    } else if ot == "bytes" and mn == "write" and c1(e) == 4 {
        do(bytes_number(e, true));
    } else if ot == "file" and mn == "save" and c1(e) == 2 {
        do(rt_call("_bit_file_save_at", true, e, "bytes,num", true, ""));
    } else if ot == "conn" and mn == "send" {
        if c1(e) != 1 or kind(arg(e, 0)) == "range" {
            do(fail("send ждёт одну строку или bytes", line));
        }
        do(push());
        num value = arg(e, 0);
        do(expr(value));
        string ty = RT;
        if not is_path(ty) and ty != "bytes" and ty != "?" {
            do(fail("send ждёт строку или bytes", line));
        }
        mas held = (num);
        if is_path(ty) { do(hold_call_string(value, "string", held)); }
        do(op_acc_to(1));
        do(pop(pr(0)));
        do(op_imm(pr(2), source_line(line)));
        if ty == "bytes" { do(op_call("_bit_sock_send_bytes")); }
        else { do(op_call("_bit_sock_send")); }
        do(drop_call_strings(held));
    } else {
        do(rt_call(f, true, e, a, lf, mode));
    }
    do(op_ld(acc(), tmp));
    string nt = ot;
    if ov >= 0 and is_mas(ot) {
        do(nt >> ch(vty(ov)));
    }
    do(resv(nt, ov));
    if is_mas(nt) and ov < 0 and known >= 0 {
        if mn == "add" or mn == "insert" {
            do(known >> ch(known + 1));
        } else if (mn == "remove" or mn == "pop") and known > 0 {
            do(known >> ch(known - 1));
        }
        do(RMSZ >> ch(known));
    }
    return true;
}

# объект в x0 / rax, аргумент — диапазон a:b → f(объект, a, b [, строка])
fn range_call(string f, num n, bool lf) {
    num r = arg(n, 0);
    do(push());
    do(expr(fa(r)));
    do(coerce(RT, "num", ln(n), "начало диапазона"));
    do(push());
    do(expr(fb(r)));
    do(coerce(RT, "num", ln(n), "конец диапазона"));
    do(op_mov(pr(2), acc()));
    do(pop(pr(1)));
    do(pop(pr(0)));
    if lf {
        do(op_imm(pr(3), source_line(ln(n))));
    }
    do(op_call(f));
}

# keep, each, find, has: перебор массива; в keep и each текущий элемент зовётся it
fn it_loop(num n, string ot, string mn) {
    num line = ln(n);
    if not is_mas(ot) {
        do(fail("{mn} работает с массивом, а тут {tn(ot)}", line));
    }
    if ot == "mas:?" {
        do(fail("в массиве ещё нет элементов — {mn} нечего перебирать", line));
    }
    if c1(n) != 1 or kind(arg(n, 0)) == "range" {
        do(fail("{mn}(...) — одно значение, например {mn}(it > 0)", line));
    }
    bool withit = mn == "keep" or mn == "each";
    string el = elem(ot);
    num a0 = arg(n, 0);
    num sm = slot();
    num sr = slot();
    num si = slot();
    num sv = slot();
    do(op_st(acc(), sm));
    if withit {
        do(op_imm(pr(0), -1));
        do(op_imm(pr(1), 0));
        do(op_call("_bit_mas_new"));
        do(op_st(acc(), sr));
    } else {
        do(expr(a0));
        do(coerce(RT, el, line, "{mn}(...)"));
        do(op_st(acc(), sv));
        do(op_imm(acc(), -1));
        do(op_st(acc(), sr));
    }
    do(op_stz(si));
    do(ST >> ch(scopy(ST)));
    if withit {
        do(widen_node(a0));
    }
    all entry = ST;
    do(sc_push());
    num itv = -1;
    if withit {
        do(itv >> ch(declare("it", el, line, -1, 1)));
    }
    string lt = newlab("it");
    string le = newlab("itend");
    string lnext = newlab("itnext");
    do(emlab(lt));
    do(op_ld(acc(), si));
    do(op_ld(cr("x1"), sm));
    do(op_field(cr("x1"), cr("x1"), 8));
    do(op_cmpj(acc(), cr("x1"), "ge", le));
    do(op_ld(cr("x2"), sm));
    do(op_field(cr("x2"), cr("x2"), 0));
    if IS_ARM {
        do(em("ldr x0, [x2, x0, lsl #3]"));
    } else {
        do(em("mov rax, [rdx + rax*8]"));
    }
    mas body = scopy(entry);
    do(ST >> ch(body));
    string rtype = ot;
    if withit {
        do(op_st(acc(), vslot(itv)));
        do(sset(ST, itv, 0, 1));
        do(expr(a0));
        string t = RT;
        if mn == "keep" {
            if t != "bool" and t != "?" {
                do(fail("в keep нужно условие, например keep(it > 0), а тут {tn(t)}", line));
            }
            do(op_jz(lnext));
            do(op_ld(pr(1), vslot(itv)));
        } else {
            if not array_element(t) and t != "?" {
                do(fail("each должен давать num, dec, string, bool или структуру, а тут {tn(t)}", line));
            }
            if t != "?" {
                do(rtype >> ch("mas:" + t));
            }
            do(op_acc_to(1));
        }
        do(op_ld(pr(0), sr));
        do(op_imm(pr(2), source_line(line)));
        do(op_call("_bit_mas_add"));
    } else {
        do(op_ld(cr("x1"), sv));
        if el == "string" {
            do(op_mov(pr(1), cr("x1")));
            do(op_mov(pr(0), acc()));
            do(op_call("_bit_str_eq"));
            do(op_jz(lnext));
        } else if el == "dec" {
            do(load_d("dec", "dec"));
            if IS_ARM {
                do(em("fcmp d0, d1"));
                do(em("b.ne {lnext}"));
            } else {
                do(em("ucomisd xmm0, xmm1"));
                do(em("jne {lnext}"));
                do(em("jp {lnext}"));
            }
        } else {
            do(em("cmp {acc()}, {cr('x1')}"));
            if IS_ARM {
                do(em("b.ne {lnext}"));
            } else {
                do(em("jne {lnext}"));
            }
        }
        do(op_ld(acc(), si));
        do(op_st(acc(), sr));
        do(op_jmp(le));
    }
    do(emlab(lnext));
    do(op_ld(acc(), si));
    do(op_inc(acc()));
    do(op_st(acc(), si));
    do(op_jmp(lt));
    do(emlab(le));
    all fin = ST;
    do(sc_pop());
    do(ST >> ch(merge2(entry, fin)));
    do(op_ld(acc(), sr));
    if mn == "find" {
        do(res("num"));
        do(rng(true, -1, false, 0));
    } else if mn == "has" {
        if IS_ARM {
            do(em("cmp x0, #0"));
            do(em("cset x0, ge"));
        } else {
            do(em("cmp rax, 0"));
            do(em("setge al"));
            do(em("movzx eax, al"));
        }
        do(res("bool"));
    } else {
        do(res(rtype));
    }
}

fn builtin_value(num e) {
    if fs(fa(e)) == "random" {
        if fs(e) != "get" {
            do(fail("случайное число: random >> get(от, до)", ln(e)));
        }
        do(rt_call("_bit_random_range", false, e, "num,num", true, ""));
        do(res("num"));
        return;
    }
    string name = fs(fa(e));
    string mn = fs(e);
    num line = ln(e);
    if name == "net" {
        if mn == "listen" {
            if c1(e) == 2 {
                do(rt_call("_bit_tcp_listen_at", false, e, "num,string", true, ""));
            } else {
                do(rt_call("_bit_tcp_listen", false, e, "num", true, ""));
            }
            do(res("server"));
            return;
        }
        do(fail("у net нет {mn}. Есть: listen", line));
    }
    if name == "os" {
        if mn == "host" {
            do(rt_call("_bit_os_host", false, e, "", true, ""));
            do(res("string"));
            return;
        }
        if mn == "user" {
            do(rt_call("_bit_os_user", false, e, "", false, ""));
            do(res("string"));
            return;
        }
        if mn == "clock" {
            do(rt_call("_bit_os_clock", false, e, "", true, ""));
            do(res("num"));
            do(rng(true, 0, false, 0));
            return;
        }
        if mn == "now" {
            do(rt_call("_bit_os_now", false, e, "", false, ""));
            do(res("num"));
            do(rng(true, 0, false, 0));
            return;
        }
        if mn == "cpus" {
            do(rt_call("_bit_os_cpus", false, e, "", true, ""));
            do(res("num"));
            do(rng(true, 1, false, 0));
            return;
        }
        if mn == "procs" {
            do(rt_call("_bit_os_procs", false, e, "", true, ""));
            do(res("string"));
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
            return;
        }
        do(fail("у os нет {mn}. Есть: host, user, now, clock, cpus, procs", line));
    }
    if name == "term" {
        if mn == "args" {
            do(rt_call("_bit_args", false, e, "", false, ""));
            do(res("mas:string"));
            return;
        }
        if mn == "env" {
            if c1(e) == 2 {
                do(fail("изменение env — это действие: do(term >> env(имя, значение));", line));
            }
            do(rt_call("_bit_env", false, e, "string", false, ""));
            do(res("string"));
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
            return;
        }
        if mn == "folder" {
            do(rt_call("_bit_term_folder", false, e, "", true, ""));
            do(res("dir"));
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
            return;
        }
        if mn == "status" {
            do(rt_call("_bit_status", false, e, "", false, ""));
            do(res("num"));
            do(rng(true, 0, true, 255));
            return;
        }
        if mn == "signalled" {
            do(SIGNALS_USED >> ch(true));
            do(rt_call("_bit_signalled", false, e, "", false, ""));
            do(res("bool"));
            return;
        }
        if mn == "error" {
            do(rt_call("_bit_term_error", false, e, "", false, ""));
            do(res("string"));
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
            return;
        }
        if mn == "error_code" {
            do(rt_call("_bit_term_errcode", false, e, "", false, ""));
            do(res("num"));
            do(rng(true, 0, false, 0));
            return;
        }
        if mn == "stderr" {
            do(rt_call("_bit_term_stderr", false, e, "", false, ""));
            do(res("string"));
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
            return;
        }
        if mn == "key" {
            if c1(e) > 0 {
                do(fail("key пишется без скобок: term >> key", line));
            }
            do(rt_call("_bit_term_key", false, e, "", false, ""));
            do(res("string"));
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
            return;
        }
        if mn == "pid" {
            do(rt_call("_bit_self_pid", false, e, "", false, ""));
            do(res("num"));
            do(rng(true, 0, false, 0));
            return;
        }
        if mn == "end" {
            do(rt_call("_bit_eof", false, e, "", false, ""));
            do(res("bool"));
            return;
        }
        if mn == "clear" or mn == "wait" or mn == "exit" or mn == "go" {
            do(fail("{mn} — это действие: do(term >> {mn}...);", line));
        }
        do(fail("у term нет {mn}. Есть: args, env, folder, status, signalled, error, error_code, stderr, end, pid, key", line));
    }
    if mn == "take" {
        num a0 = arg(e, 0);
        num known = -1;
        if c1(e) == 1 and const_kind(a0) == "num" and CVAL >= 0 {
            do(known >> ch(CVAL));
        }
        do(rt_call("_bit_bytes_new", false, e, "num", false, ""));
        do(res("bytes"));
        do(RMSZ >> ch(known));
        return;
    }
    if mn == "free" {
        do(rt_call("_bit_mem_free", false, e, "", false, ""));
        do(res("num"));
        do(rng(true, 0, false, 0));
        return;
    }
    if mn == "used" {
        do(rt_call("_bit_mem_used", false, e, "", false, ""));
        do(res("num"));
        return;
    }
    if mn == "total" {
        do(rt_call("_bit_mem_total", false, e, "", false, ""));
        do(res("num"));
        return;
    }
    do(fail("у mem нет {mn}. Есть: take, free, used, total", line));
}

fn need_linux(string ot, string mn, num line) {
    if IS_WINDOWS and (ot == "file" or ot == "dir") and mn == "permissions" {
        do(fail("permissions доступны на macOS и Linux; на Windows используй read_only (ACL пока не поддерживается)", line));
    }
    if IS_LINUX or IS_WINDOWS {
        return;
    }
    if ot == "proc" and (mn == "read" or mn == "grab" or mn == "scan" or mn == "maps" or mn == "write" or mn == "paste") {
        do(fail("память чужого процесса ({mn}) на macOS закрыта системой: нужны права отладчика. Собери с --os linux или --os windows", line));
    }
}

# битовые операции как методы цепочки: n >> shift_left(3), a >> bit_and(x), n >> bit_not
fn bit_method(num n, string mn, num line) {
    # obj (число) уже в acc
    if mn == "bit_not" {
        if c1(n) > 0 {
            do(fail("bit_not пишется без скобок: n >> bit_not", line));
        }
        if IS_ARM {
            do(em("mvn x0, x0"));
        } else {
            do(em("not rax"));
        }
        do(res("num"));
        return;
    }
    if c1(n) != 1 or kind(arg(n, 0)) == "range" {
        do(fail("{mn}(значение) — одно число, например {mn}(3)", line));
    }
    do(push());                              # сохранить obj
    do(expr(arg(n, 0)));
    do(coerce(RT, "num", line, "{mn}(...)"));
    do(op_mov(cr("x1"), acc()));             # аргумент -> x1 / rcx
    do(pop(acc()));                          # obj -> acc
    if IS_ARM {
        if mn == "shift_left" {
            do(em("lsl x0, x0, x1"));
        } else if mn == "shift_right" {
            do(em("lsr x0, x0, x1"));
        } else if mn == "bit_and" {
            do(em("and x0, x0, x1"));
        } else if mn == "bit_or" {
            do(em("orr x0, x0, x1"));
        } else {
            do(em("eor x0, x0, x1"));
        }
    } else {
        if mn == "shift_left" {
            do(em("shl rax, cl"));
        } else if mn == "shift_right" {
            do(em("shr rax, cl"));
        } else if mn == "bit_and" {
            do(em("and rax, rcx"));
        } else if mn == "bit_or" {
            do(em("or rax, rcx"));
        } else {
            do(em("xor rax, rcx"));
        }
    }
    do(res("num"));
}

# Convert the value in acc between binary32 bits and the language's dec.
fn bytes_float32(bool writing) {
    if IS_ARM {
        if writing {
            do(em("fmov d0, x0"));
            do(em("fcvt s0, d0"));
            do(em("fmov w0, s0"));
        } else {
            do(em("fmov s0, w0"));
            do(em("fcvt d0, s0"));
            do(em("fmov x0, d0"));
        }
    } else if writing {
        do(em("movq xmm0, rax"));
        do(em("cvtsd2ss xmm0, xmm0"));
        do(em("movd eax, xmm0"));
    } else {
        do(em("movd xmm0, eax"));
        do(em("cvtss2sd xmm0, xmm0"));
        do(em("movq rax, xmm0"));
    }
}

fn bytes_reverse(num width) {
    if IS_ARM {
        if width == 2 {
            do(em("rev16 w0, w0"));
        } else if width == 4 {
            do(em("rev w0, w0"));
        } else {
            do(em("rev x0, x0"));
        }
    } else if width == 2 {
        do(em("ror ax, 8"));
    } else if width == 4 {
        do(em("bswap eax"));
    } else {
        do(em("bswap rax"));
    }
}

# Receiver is in x3 / rdi, offset in x1 / rsi, value (for a write) in acc.
# Return an address in x2 / rdx. Subtract from the length to avoid offset overflow.
fn bytes_address(num width, num line) {
    string err = die_stub("число не помещается в bytes по этому смещению", line);
    if IS_ARM {
        # The caller supplies the receiver in x3 so acc can hold the value.
        do(em("ldr x2, [x3, #8]"));
        do(em("subs x2, x2, #{width}"));
        do(em("b.lo {err}"));
        do(em("cmp x1, x2"));
        do(em("b.hi {err}"));
        do(em("ldr x2, [x3]"));
        do(em("add x2, x2, x1"));
    } else {
        do(em("mov rdx, [rdi + 8]"));
        do(em("sub rdx, {width}"));
        do(em("jb {err}"));
        do(em("cmp rsi, rdx"));
        do(em("ja {err}"));
        do(em("mov rdx, [rdi]"));
        do(em("add rdx, rsi"));
    }
}

fn bytes_literal(num n, num line) {
    if kind(n) == "str" and c1(n) == 1 {
        num part = item(l1(n), 0);
        if kind(part) == "lit" {
            return fs(part);
        }
    }
    do(fail("формат и порядок байтов нужно указать строковыми литералами", line));
    return "";
}

fn bytes_number(num e, bool writing) {
    num line = ln(e);
    num format_index = 1;
    if writing {
        do(format_index >> ch(2));
    }
    string format = bytes_literal(arg(e, format_index), line);
    string order = bytes_literal(arg(e, format_index + 1), line);
    num width = 8;
    if format == "u16" {
        do(width >> ch(2));
    } else if format == "u32" or format == "f32" {
        do(width >> ch(4));
    } else if format != "i64" and format != "f64" {
        do(fail("формат bytes: u16, u32, i64, f32 или f64", line));
    }
    if order != "little" and order != "big" {
        do(fail("порядок байтов: little или big", line));
    }
    string ty = "num";
    if format == "f32" or format == "f64" {
        do(ty >> ch("dec"));
    }
    do(push());
    do(expr(arg(e, 0)));
    do(coerce(RT, "num", line, "смещение в bytes"));
    if writing {
        do(push());
        do(expr(arg(e, 1)));
        do(coerce(RT, ty, line, "значение для записи в bytes"));
        do(pop(pr(1)));
    } else {
        do(op_acc_to(1));
    }
    string receiver = pr(0);
    if IS_ARM {
        do(receiver >> ch("x3"));
    }
    do(pop(receiver));
    do(bytes_address(width, line));
    if writing {
        if ty == "num" and width < 8 {
            string err = die_stub("значение не помещается в {format}", line);
            if IS_ARM {
                do(em("lsr x4, x0, #{width * 8}"));
                do(em("cbnz x4, {err}"));
            } else {
                do(em("mov rcx, rax"));
                do(em("shr rcx, {width * 8}"));
                do(em("jnz {err}"));
            }
        }
        if format == "f32" {
            do(bytes_float32(true));
        }
        if order == "big" {
            do(bytes_reverse(width));
        }
        if IS_ARM {
            if width == 2 {
                do(em("strh w0, [x2]"));
            } else if width == 4 {
                do(em("str w0, [x2]"));
            } else {
                do(em("str x0, [x2]"));
            }
        } else if width == 2 {
            do(em("mov [rdx], ax"));
        } else if width == 4 {
            do(em("mov [rdx], eax"));
        } else {
            do(em("mov [rdx], rax"));
        }
        return;
    }
    if IS_ARM {
        if width == 2 {
            do(em("ldrh w0, [x2]"));
        } else if width == 4 {
            do(em("ldr w0, [x2]"));
        } else {
            do(em("ldr x0, [x2]"));
        }
    } else if width == 2 {
        do(em("movzx eax, word ptr [rdx]"));
    } else if width == 4 {
        do(em("mov eax, [rdx]"));
    } else {
        do(em("mov rax, [rdx]"));
    }
    if order == "big" {
        do(bytes_reverse(width));
    }
    if format == "f32" {
        do(bytes_float32(false));
    }
    do(res(ty));
    if format == "u16" {
        do(rng(true, 0, true, 65535));
    } else if format == "u32" {
        do(rng(true, 0, true, 4294967295));
    }
}

# ("программа", "аргумент", ...) >> run [("вход")] — запуск напрямую, без оболочки → stdout
fn mas_run(num n, string ot, num line) {
    if ot != "mas:string" {
        do(fail("run запускает массив строк: (\"программа\", \"аргумент\") >> run, а тут {tn(ot)}", line));
    }
    if c1(n) > 1 or (c1(n) == 1 and kind(arg(n, 0)) == "range") {
        do(fail("run или run(\"вход\") — на вход программе одна строка", line));
    }
    mas string_args = (num);
    if c1(n) == 1 {
        do(push());
        do(expr(arg(n, 0)));
        do(coerce(RT, "string", line, "run(вход)"));
        do(hold_call_string(arg(n, 0), "string", string_args));
        do(op_acc_to(1));
        do(pop(pr(0)));
    } else {
        do(op_acc_to(0));
        do(op_imm(pr(1), 0));
    }
    do(op_imm(pr(2), source_line(line)));
    do(op_call("_bit_exec"));
    do(drop_call_strings(string_args));
    do(res("string"));
    do(op_rt1("_bit_str_adopt"));
    do(RFRESH >> ch(true));
}

# do(cmd >> run) — запуск напрямую, вывод сразу в терминал; код в term >> status
fn mas_run_live(string ot, num e, num line) {
    if ot != "mas:string" {
        do(fail("run запускает массив строк: (\"программа\", \"аргумент\") >> run, а тут {tn(ot)}", line));
    }
    if c1(e) > 0 {
        do(fail("в do(...) run показывает вывод сразу; чтобы дать вход, сохрани результат: string out = cmd >> run(\"вход\")", line));
    }
    string lok = newlab("runok");
    if IS_ARM {
        do(em("ldr x1, [x0, #8]"));
        do(em("cbnz x1, {lok}"));
    } else {
        do(em("cmp qword ptr [rax + 8], 0"));
        do(em("jne {lok}"));
    }
    do(op_addr(pr(0), "Lrt_erun"));
    do(op_imm(pr(1), source_line(line)));
    do(op_call("_bit_die"));
    do(emlab(lok));
    do(op_acc_to(0));
    do(op_call("_bit_mas_argv"));
    do(op_acc_to(0));
    do(op_imm(pr(1), 0));
    do(op_imm(pr(2), source_line(line)));
    do(op_call("_bit_spawn_status"));
}

# строки: s >> trim, s >> starts("..."), s >> ends("...")
fn pad_method(num receiver, string ot, num n, string mn, num line) {
    if c1(n) < 1 or c1(n) > 2 {
        do(fail("{mn}(ширина) или {mn}(ширина, \"символ\")", line));
    }
    string f = "_bit_str_pad";
    if mn == "pad_left" {
        do(f >> ch("_bit_str_pad_left"));
    }
    mas receiver_refs = (num);
    mas fill_refs = (num);
    if ot == "string" {
        if RFRESH {
            do(hold_call_string(receiver, ot, receiver_refs));
        }
        do(push());
    } else {
        do(op_acc_to(0));
        do(op_imm(pr(1), kind_of(ot)));
        do(op_call("_bit_to_str"));
        # Numeric formatting allocates a temporary string too.
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        do(hold_call_string(receiver, "string", receiver_refs));
        do(push());
    }
    do(expr(arg(n, 0)));
    do(coerce(RT, "num", line, "{mn}(...)"));
    do(push());
    if c1(n) == 2 {
        do(expr(arg(n, 1)));
        do(coerce(RT, "string", line, "{mn}(...)"));
        do(hold_call_string(arg(n, 1), "string", fill_refs));
        do(push());
    } else {
        do(op_lstr(acc(), ""));
        do(push());
    }
    do(pop(pr(2)));
    do(pop(pr(1)));
    do(pop(pr(0)));
    do(op_imm(pr(3), source_line(line)));
    do(op_call(f));
    do(drop_call_strings(fill_refs));
    do(drop_call_strings(receiver_refs));
    do(res("string"));
    do(op_rt1("_bit_str_adopt"));
    do(RFRESH >> ch(true));
}

fn hex_method(num n, num line) {
    if c1(n) > 1 {
        do(fail("hex ждёт одну ширину: n >> hex(4)", line));
    }
    do(push());
    if c1(n) == 1 {
        do(expr(arg(n, 0)));
        do(coerce(RT, "num", line, "hex(...)"));
    } else {
        do(op_imm(acc(), 0));
    }
    do(push());
    do(pop(pr(1)));
    do(pop(pr(0)));
    do(op_imm(pr(2), source_line(line)));
    do(op_call("_bit_num_hex"));
    do(res("string"));
    do(op_rt1("_bit_str_adopt"));
    do(RFRESH >> ch(true));
}

fn fixed_method(num n, num line) {
    if c1(n) != 1 {
        do(fail("fixed ждёт число знаков: d >> fixed(2)", line));
    }
    do(push());
    do(expr(arg(n, 0)));
    do(coerce(RT, "num", line, "fixed(...)"));
    do(push());
    do(pop(pr(1)));
    do(pop(pr(0)));
    do(op_imm(pr(2), source_line(line)));
    do(op_call("_bit_dec_fixed"));
    do(res("string"));
    do(op_rt1("_bit_str_adopt"));
    do(RFRESH >> ch(true));
}

fn str_method(num n, string mn, num line) {
    if mn == "trim" {
        if c1(n) > 0 {
            do(fail("trim пишется без скобок: s >> trim", line));
        }
        do(op_rt1("_bit_str_trim"));
        do(res("string"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if mn == "replace" {
        if c1(n) != 2 {
            do(fail("replace(что, на что), например s >> replace(\"a\", \"b\")", line));
        }
        mas string_args = (num);
        do(push());
        do(expr(arg(n, 0)));
        do(coerce(RT, "string", line, "replace(...)"));
        do(hold_call_string(arg(n, 0), "string", string_args));
        do(push());
        do(expr(arg(n, 1)));
        do(coerce(RT, "string", line, "replace(...)"));
        do(hold_call_string(arg(n, 1), "string", string_args));
        do(op_acc_to(2));
        do(pop(pr(1)));
        do(pop(pr(0)));
        do(op_call("_bit_str_replace"));
        do(drop_call_strings(string_args));
        do(res("string"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if c1(n) != 1 or kind(arg(n, 0)) == "range" {
        do(fail("{mn}(строка), например s >> {mn}(\"привет\")", line));
    }
    mas string_args = (num);
    do(push());
    do(expr(arg(n, 0)));
    do(coerce(RT, "string", line, "{mn}(...)"));
    do(hold_call_string(arg(n, 0), "string", string_args));
    do(op_mov(cr("x1"), acc()));
    do(pop(acc()));
    do(op_acc_to(0));
    do(op_mov(pr(1), cr("x1")));
    do(op_call("_bit_str_{mn}"));
    do(drop_call_strings(string_args));
    if mn == "split" {
        do(res("mas:string"));
    } else {
        do(res("bool"));
    }
}

# математика: n >> abs, n >> sqrt, n >> pow(k), a >> min(b), a >> max(b)
fn math_method(num n, string ot, string mn, num line) {
    if mn == "abs" {
        if c1(n) > 0 {
            do(fail("abs пишется без скобок: n >> abs", line));
        }
        if ot == "num" {
            string overflow = ovf_stub(line);
            if IS_ARM {
                do(em("asr x1, x0, #63"));
                do(em("eor x0, x0, x1"));
                do(em("subs x0, x0, x1"));
                do(em("b.vs {overflow}"));
            } else {
                do(em("mov rcx, rax"));
                do(em("sar rcx, 63"));
                do(em("xor rax, rcx"));
                do(em("sub rax, rcx"));
                do(em("jo {overflow}"));
            }
            do(res("num"));
            do(rng(true, 0, false, 0));
        } else {
            if IS_ARM {
                do(em("fmov d0, x0"));
                do(em("fabs d0, d0"));
                do(em("fmov x0, d0"));
            } else {
                do(em("mov rcx, 0x7fffffffffffffff"));
                do(em("and rax, rcx"));
            }
            do(res("dec"));
        }
        return;
    }
    if mn == "sqrt" {
        if c1(n) > 0 {
            do(fail("sqrt пишется без скобок: n >> sqrt", line));
        }
        if IS_ARM {
            if ot == "num" {
                do(em("scvtf d0, x0"));
            } else {
                do(em("fmov d0, x0"));
            }
            do(em("fsqrt d0, d0"));
            do(em("fmov x0, d0"));
        } else {
            if ot == "num" {
                do(em("cvtsi2sd xmm0, rax"));
            } else {
                do(em("movq xmm0, rax"));
            }
            do(em("sqrtsd xmm0, xmm0"));
            do(em("movq rax, xmm0"));
        }
        do(res("dec"));
        return;
    }
    if mn == "pow" {
        if ot != "num" {
            do(fail("pow пока только для целых (num)", line));
        }
        if c1(n) != 1 or kind(arg(n, 0)) == "range" {
            do(fail("pow(степень), например n >> pow(2)", line));
        }
        do(push());
        do(expr(arg(n, 0)));
        do(coerce(RT, "num", line, "степень в pow"));
        do(op_acc_to(1));
        do(pop(pr(0)));
        do(op_call("_bit_ipow"));
        do(res("num"));
        return;
    }
    if c1(n) != 1 or kind(arg(n, 0)) == "range" {
        do(fail("{mn}(значение), например a >> {mn}(b)", line));
    }
    do(push());
    do(expr(arg(n, 0)));
    do(coerce(RT, ot, line, "{mn}(...)"));
    do(op_mov(cr("x1"), acc()));
    do(pop(acc()));
    if ot == "num" {
        if IS_ARM {
            do(em("cmp x0, x1"));
            if mn == "min" {
                do(em("csel x0, x0, x1, lt"));
            } else {
                do(em("csel x0, x0, x1, gt"));
            }
        } else {
            do(em("cmp rax, rcx"));
            if mn == "min" {
                do(em("cmovg rax, rcx"));
            } else {
                do(em("cmovl rax, rcx"));
            }
        }
    } else {
        do(load_d(ot, ot));
        if IS_ARM {
            if mn == "min" {
                do(em("fmin d0, d0, d1"));
            } else {
                do(em("fmax d0, d0, d1"));
            }
            do(em("fmov x0, d0"));
        } else {
            string nan = newlab("minmaxnan");
            string different = newlab("minmaxdiff");
            string done = newlab("minmaxdone");
            do(em("ucomisd xmm0, xmm1"));
            do(em("jp {nan}"));
            do(em("jne {different}"));
            do(em("movq rax, xmm0"));
            do(em("movq rcx, xmm1"));
            if mn == "min" {
                do(em("or rax, rcx"));
            } else {
                do(em("and rax, rcx"));
            }
            do(op_jmp(done));
            do(emlab(different));
            if mn == "min" {
                do(em("minsd xmm0, xmm1"));
            } else {
                do(em("maxsd xmm0, xmm1"));
            }
            do(em("movq rax, xmm0"));
            do(op_jmp(done));
            do(emlab(nan));
            do(em("mov rax, 0x7ff8000000000000"));
            do(emlab(done));
        }
    }
    do(res(ot));
}

fn pipe_receiver(num n, bool in_do) {
    if in_do and kind(n) == "pipe" {
        do(e_pipe(n, true));
    } else {
        do(expr(n));
    }
}

fn map_action(string ot, num ov, num e) {
    string name = fs(e);
    do(push());
    if name == "set" {
        do(rt_call("_bit_map_set", true, e, "string," + elem(ot), true, ""));
    } else if name == "remove" {
        do(rt_call("_bit_map_remove", true, e, "string", false, ""));
    } else {
        do(fail("у map действия set(ключ, значение) и remove(ключ)", ln(e)));
    }
    do(pop(acc()));
    do(resv(ot, ov));
}

fn map_value(string ot, num n) {
    string name = fs(n);
    num line = ln(n);
    if name == "sz" and c1(n) == 0 {
        do(op_field(acc(), acc(), 8));
        do(res("num"));
        do(rng(true, 0, false, 0));
        return;
    }
    if not ((name == "has" and c1(n) == 1) or (name == "get" and (c1(n) == 1 or c1(n) == 2))) {
        do(fail("у map значения: sz, has(ключ), get(ключ) и get(ключ, запас)", line));
    }
    do(push());
    do(expr(arg(n, 0)));
    do(coerce(RT, "string", line, "ключ словаря"));
    do(op_acc_to(1));
    do(pop(pr(0)));
    string receiver = cr("x2");
    do(op_mov(acc(), pr(0)));
    do(push());
    do(op_call("_bit_map_find"));
    do(pop(receiver));
    if name == "has" {
        if IS_ARM {
            do(em("cmp x0, #0"));
            do(em("cset x0, ge"));
        } else {
            do(em("test rax, rax"));
            do(em("setns al"));
            do(em("movzx eax, al"));
        }
        do(res("bool"));
        return;
    }
    string absent = "";
    if c1(n) == 1 {
        do(absent >> ch(die_stub("ключ не найден в словаре", line)));
    } else {
        do(absent >> ch(newlab("mapmiss")));
    }
    if IS_ARM {
        do(em("tbnz x0, #63, {absent}"));
        do(em("ldr x2, [x2]"));
        do(em("ldr x2, [x2, x0, lsl #3]"));
        do(em("ldr x0, [x2, #8]"));
    } else {
        do(em("test rax, rax"));
        do(em("js {absent}"));
        do(em("mov rdx, [rdx]"));
        do(em("mov rdx, [rdx + rax*8]"));
        do(em("mov rax, [rdx + 8]"));
    }
    if c1(n) == 2 {
        string end = newlab("mapend");
        do(op_jmp(end));
        do(emlab(absent));
        all before = ST;
        do(ST >> ch(scopy(before)));
        do(expr(arg(n, 1)));
        do(coerce(RT, elem(ot), line, "запасное значение словаря"));
        do(ST >> ch(merge2(before, ST)));
        do(emlab(end));
    }
    do(res(elem(ot)));
}

fn e_pipe(num n, bool in_do) {
    string mn = fs(n);
    num obj = fa(n);
    num line = ln(n);
    if is_builtin(obj) {
        do(builtin_value(n));
        return;
    }
    if mn == "ch" or mn == "input" {
        do(action(n));
        return;
    }
    do(pipe_receiver(obj, in_do));
    string ot = RT;
    num ov = RV;
    num known = RMSZ;
    if ot == "?" {
        do(res("?"));
        return;
    }
    num record_id = record_by_name(ot);
    if record_id >= 0 {
        do(record_pipe(record_id, ov, n, in_do and c1(n) > 0));
        return;
    }
    if is_map(ot) and (mn == "keys" or mn == "values") {
        if c1(n) > 0 {
            do(fail("{mn} пишется без скобок: m >> {mn}", line));
        }
        string vt = elem(ot);
        do(op_acc_to(0));
        if mn == "keys" {
            do(op_imm(pr(1), source_line(line)));
            do(op_call("_bit_map_keys"));
            do(res("mas:string"));
        } else {
            do(op_imm(pr(1), kind_of(vt)));
            do(op_imm(pr(2), source_line(line)));
            do(op_call("_bit_map_values"));
            do(res("mas:{vt}"));
        }
        return;
    }
    if is_map(ot) {
        if in_do and (mn == "set" or mn == "remove") {
            do(map_action(ot, ov, n));
        } else {
            do(map_value(ot, n));
        }
        return;
    }
    do(need_linux(ot, mn, line));
    if ot == "dir" and mn == "walk" and c1(n) > 0 {
        num a = arg(n, 0);
        bool valid = false;
        if c1(n) == 1 and kind(a) == "str" and c1(a) == 1 {
            num part = item(l1(a), 0);
            do(valid >> ch(kind(part) == "lit" and fs(part) == "info"));
        }
        if not valid {
            do(fail("walk с метаданными: d >> walk(\"info\"); аргумент — литерал info", line));
        }
        do(op_acc_to(0));
        do(op_imm(pr(1), source_line(line)));
        do(op_call("_bit_dir_walk_info"));
        do(res("mas:FileInfo"));
        return;
    }

    if not in_do and (ot == "file" or ot == "dir") and
        (mn == "remove_all" or ((mn == "permissions" or mn == "read_only") and c1(n) > 0)) {
        do(fail("{mn} меняет файловую систему: оберни действие в do(...)", line));
    }
    if is_mas(ot) and mn == "sort" {
        do(sort_pipe(ot, ov, n, in_do));
        return;
    }
    if act_on(n, ot, ov, false) {
        return;
    }
    if ot == "bytes" and mn == "read" and c1(n) == 3 {
        do(bytes_number(n, false));
        return;
    }
    if ot == "file" and mn == "load" and c1(n) == 2 {
        do(rt_call("_bit_file_load_at", true, n, "num,num", true, ""));
        do(res("bytes"));
        return;
    }
    if ot == "conn" and mn == "recv" and c1(n) == 2 {
        do(rt_call("_bit_sock_recv_timed", true, n, "num,num", true, ""));
        do(res("string"));
        do(op_rt1("_bit_str_adopt"));
        do(RFRESH >> ch(true));
        return;
    }
    if ot == "string" and mn == "connect" and c1(n) > 0 {
        if c1(n) > 1 {
            do(fail("connect ждёт один таймаут в мс: \"адрес:порт\" >> connect(мс)", line));
        }
        mas receiver_refs = (num);
        if RFRESH {
            do(hold_call_string(obj, ot, receiver_refs));
        }
        do(rt_call("_bit_tcp_connect_timed", true, n, "num", true, ""));
        do(res("conn"));
        do(drop_call_strings(receiver_refs));
        return;
    }
    if ot == "num" and (mn == "shift_left" or mn == "shift_right" or mn == "bit_and" or mn == "bit_or" or mn == "bit_xor" or mn == "bit_not") {
        do(bit_method(n, mn, line));
        return;
    }
    if is_numt(ot) and (mn == "abs" or mn == "sqrt" or mn == "pow" or mn == "min" or mn == "max") {
        do(math_method(n, ot, mn, line));
        return;
    }
    if ot == "string" and (mn == "trim" or mn == "starts" or mn == "ends" or mn == "split" or mn == "replace") {
        mas receiver_refs = (num);
        if RFRESH {
            do(hold_call_string(obj, ot, receiver_refs));
        }
        do(str_method(n, mn, line));
        do(drop_call_strings(receiver_refs));
        return;
    }
    if is_mas(ot) and mn == "run" {
        do(mas_run(n, ot, line));
        return;
    }
    if mn == "keep" or mn == "each" or (mn == "find" and is_mas(ot)) or mn == "has" {
        do(it_loop(n, ot, mn));
        return;
    }
    if mn == "sum" {
        if ot != "mas:num" and ot != "mas:dec" {
            do(fail("sum складывает массив чисел, а тут {tn(ot)}", line));
        }
        if c1(n) > 0 {
            do(fail("sum пишется без скобок: a >> sum", line));
        }
        do(op_acc_to(0));
        do(op_imm(pr(1), kind_of(elem(ot))));
        do(op_imm(pr(2), source_line(line)));
        do(op_call("_bit_mas_sum"));
        do(res(elem(ot)));
        return;
    }
    if is_mas(ot) and (mn == "first" or mn == "last") {
        do(mas_end(ot, ov, known, n, mn, line));
        return;
    }
    if (mn == "pad" or mn == "pad_left") and (ot == "string" or is_numt(ot)) {
        do(pad_method(obj, ot, n, mn, line));
        return;
    }
    if ot == "num" and mn == "hex" {
        do(hex_method(n, line));
        return;
    }
    if ot == "dec" and mn == "fixed" {
        do(fixed_method(n, line));
        return;
    }
    if vm(ot, mn) {
        string f = MF;
        string a = MA;
        string r = MR;
        bool lf = MLF;
        mas receiver_refs = (num);
        if is_path(ot) and RFRESH and f != "" and f != "join" {
            do(hold_call_string(obj, ot, receiver_refs));
        }
        if f == "" {
            if c1(n) > 0 {
                do(fail("{mn} пишется без скобок", line));
            }
        } else if f == "join" {
            if c1(n) != 1 {
                do(fail("{mn}(\"имя\") — одно имя", line));
            }
            do(push());
            do(expr(arg(n, 0)));
            do(coerce(RT, "string", line, "{mn}(...)"));
            do(push());
            if IS_ARM {
                do(em("ldr x0, [sp, #16]"));
                do(op_lstr("x1", "/"));
                do(em("bl _bit_cat"));
                do(pop("x1"));
                do(em("bl _bit_cat"));
                do(em("add sp, sp, #16"));
            } else {
                do(em("mov rdi, [rsp + 16]"));
                do(op_lstr("rsi", "/"));
                do(em("call _bit_cat"));
                do(pop("rsi"));
                do(em("mov rdi, rax"));
                do(em("call _bit_cat"));
                do(em("add rsp, 16"));
            }
        } else {
            do(rt_call(f, true, n, a, lf, ""));
        }
        do(res(r));
        # basename is an interior pointer: return an independently owned copy.
        if f == "_bit_basename" {
            do(op_acc_to(0));
            do(op_lstr(pr(1), ""));
            do(op_call("_bit_cat"));
        }
        do(drop_call_strings(receiver_refs));
        if f == "_bit_basename" or f == "_bit_file_read" or f == "_bit_bytes_text" or
           f == "_bit_mas_text" or f == "_bit_mas_join" or f == "_bit_sock_recv" or
           f == "_bit_resolve" or f == "_bit_run" or f == "_bit_fetch" or
           f == "_bit_http_post" or f == "_bit_permissions_get" or f == "_bit_sock_peer" or
           f == "_bit_str_upper" or f == "_bit_str_lower" or f == "_bit_str_repeat" or
           f == "_bit_num_char" {
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
        }
        return;
    }
    if mn == "sz" {
        if c1(n) > 0 {
            do(fail("sz пишется без скобок: a >> sz", line));
        }
        if ot == "string" {
            mas receiver_refs = (num);
            if RFRESH {
                do(hold_call_string(obj, ot, receiver_refs));
            }
            do(op_rt1("_bit_str_sz"));
            do(drop_call_strings(receiver_refs));
            do(res("num"));
            do(rng(true, 0, false, 0));
            return;
        }
        if is_seq(ot) {
            do(op_field(acc(), acc(), 8));
            num m = seq_min(ov, known);
            do(res("num"));
            do(rng(true, m, false, 0));
            return;
        }
        do(fail("sz есть только у mas и string, а тут {tn(ot)}", line));
    }
    if mn == "get" {
        bool isrange = c1(n) == 1 and kind(arg(n, 0)) == "range";
        if ot == "string" or ot == "file" {
            if c1(n) != 1 {
                do(fail("get(номер) или get(от:до), например get(0) или get(0:4)", line));
            }
            mas receiver_refs = (num);
            if RFRESH {
                do(hold_call_string(obj, ot, receiver_refs));
            }
            if ot == "string" and isrange {
                do(range_call("_bit_str_slice", n, false));
                do(drop_call_strings(receiver_refs));
                do(res("string"));
                do(op_rt1("_bit_str_adopt"));
                do(RFRESH >> ch(true));
                return;
            }
            if ot == "file" and isrange {
                do(range_call("_bit_file_slice", n, true));
                do(drop_call_strings(receiver_refs));
                do(res("mas:string"));
                return;
            }
            if ot == "file" {
                do(rt_call("_bit_file_line", true, n, "num", true, ""));
                do(drop_call_strings(receiver_refs));
                do(res("string"));
                do(op_rt1("_bit_str_adopt"));
                do(RFRESH >> ch(true));
                return;
            }
            do(push());
            do(expr(arg(n, 0)));
            do(coerce(RT, "num", line, "номер в get"));
            do(op_mov(pr(1), acc()));
            do(op_mov(pr(2), acc()));
            do(pop(pr(0)));
            do(op_call("_bit_str_slice"));
            do(drop_call_strings(receiver_refs));
            do(res("string"));
            do(op_rt1("_bit_str_adopt"));
            do(RFRESH >> ch(true));
            return;
        }
        if not is_seq(ot) {
            do(fail("get берёт элемент из массива, строки или файла, а тут {tn(ot)}", line));
        }
        if isrange and ot == "bytes" {
            do(range_call("_bit_bytes_slice", n, false));
            do(res(ot));
            return;
        }
        if isrange and ot != "mas:?" {
            do(range_call("_bit_mas_slice", n, false));
            do(res(ot));
            return;
        }
        if ot == "mas:?" {
            do(fail("в массиве ещё нет элементов — get нечего взять", line));
        }
        if c1(n) == 2 {
            do(get_or(ot, n, line));
            return;
        }
        if c1(n) != 1 or kind(arg(n, 0)) == "range" {
            do(fail("get(номер) — один номер, например get(0)", line));
        }
        do(push());
        do(expr(arg(n, 0)));
        do(op_mov(cr("x1"), acc()));
        do(pop(acc()));
        if RT == "?" {
            do(res(elem(ot)));
            return;
        }
        if RT != "num" {
            do(fail("номер в get должен быть num, а тут {tn(RT)}", line));
        }
        do(prove_index(ov, known, arg(n, 0), line));
        do(seq_check(acc(), cr("x1"), line));
        if ot == "bytes" {
            if IS_ARM {
                do(em("ldr x0, [x0]"));
                do(em("ldrb w0, [x0, x1]"));
            } else {
                do(em("mov rax, [rax]"));
                do(em("movzx eax, byte ptr [rax + rcx]"));
            }
            do(res("num"));
            do(rng(true, 0, true, 255));
            return;
        }
        if IS_ARM {
            do(em("ldr x0, [x0]"));
            do(em("ldr x0, [x0, x1, lsl #3]"));
        } else {
            do(em("mov rax, [rax]"));
            do(em("mov rax, [rax + rcx*8]"));
        }
        do(res(elem(ot)));
        return;
    }
    do(fail("не знаю действие {mn}. Есть: get, add, set, ch, sz, input, keep, each, find, has, sum, sort", line));
}

fn get_or(string ot, num m, num line) {
    string el = elem(ot);
    do(push());
    do(expr(arg(m, 0)));
    if RT != "num" and RT != "?" {
        do(fail("номер в get должен быть num, а тут {tn(RT)}", line));
    }
    string ld = newlab("gd");
    string le = newlab("ge");
    if IS_ARM {
        do(em("mov x1, x0"));
        do(pop("x2"));
        do(em("ldr x4, [x2, #8]"));
        do(em("cmp x1, x4"));
        do(em("b.hs {ld}"));
        do(em("ldr x2, [x2]"));
        if ot == "bytes" {
            do(em("ldrb w0, [x2, x1]"));
        } else {
            do(em("ldr x0, [x2, x1, lsl #3]"));
        }
    } else {
        do(em("mov rcx, rax"));
        do(pop("rdx"));
        do(em("mov rdi, [rdx + 8]"));
        do(em("cmp rcx, rdi"));
        do(em("jae {ld}"));
        do(em("mov rdx, [rdx]"));
        if ot == "bytes" {
            do(em("movzx eax, byte ptr [rdx + rcx]"));
        } else {
            do(em("mov rax, [rdx + rcx*8]"));
        }
    }
    do(op_jmp(le));
    do(emlab(ld));
    all before = ST;
    mas alt = scopy(ST);
    do(ST >> ch(alt));
    do(expr(arg(m, 1)));
    do(coerce(RT, el, line, "запасное значение в get"));
    all after = ST;
    do(ST >> ch(merge2(before, after)));
    do(emlab(le));
    do(res(el));
}

fn set_item(string ot, num ov, num known, num m, num line) {
    if ot == "mas:?" {
        do(fail("в массиве ещё нет элементов — set нечего менять", line));
    }
    if c1(m) != 2 {
        do(fail("set(номер, значение), например set(0, 5)", line));
    }
    string el = elem(ot);
    do(push());
    do(expr(arg(m, 0)));
    if RT != "num" and RT != "?" {
        do(fail("номер в set должен быть num, а тут {tn(RT)}", line));
    }
    if RT == "num" {
        do(prove_index(ov, known, arg(m, 0), line));
    }
    do(push());
    do(expr(arg(m, 1)));
    do(coerce(RT, el, line, "значение в set"));
    if IS_ARM {
        do(pop("x1"));
        do(pop("x2"));
        do(seq_check("x2", "x1", line));
        do(em("ldr x2, [x2]"));
        if ot == "bytes" {
            do(em("strb w0, [x2, x1]"));
        } else {
            do(em("str x0, [x2, x1, lsl #3]"));
        }
    } else {
        do(pop("rcx"));
        do(pop("rdx"));
        do(seq_check("rdx", "rcx", line));
        do(em("mov rdx, [rdx]"));
        if ot == "bytes" {
            do(em("mov [rdx + rcx], al"));
        } else {
            do(em("mov [rdx + rcx*8], rax"));
        }
    }
}

# An alias can change the length after the static checks.
fn seq_check(string seq, string idx, num line) {
    string err = die_stub("номер за пределами последовательности", line);
    if IS_ARM {
        do(em("ldr x4, [{seq}, #8]"));
        do(em("cmp {idx}, x4"));
        do(em("b.hs {err}"));
    } else {
        do(em("cmp {idx}, [{seq} + 8]"));
        do(em("jae {err}"));
    }
}

# The static check explains how to express the expected index range.
fn prove_index(num ov, num known, num inode, num line) {
    bool lk = RLK;
    num lo = RL;
    bool hk = RHK;
    num hi = RH;
    num a = -1;
    if ov >= 0 and VGLOB >> get(ov, 0) == 0 {
        do(a >> ch(ov));
    }
    string name = "массив";
    if ov >= 0 {
        do(name >> ch(VN >> get(ov, "")));
    }
    num msz = seq_min(a, known);
    bool fact = false;
    if kind(inode) == "var" and a >= 0 {
        num iv = find(fs(inode));
        do(fact >> ch(iv >= 0 and fact_has(ST, iv, a)));
    }
    if lk and hk and lo == hi {
        if lo < 0 {
            do(fail("номер {lo} меньше нуля — элементы считаются с 0", line));
        }
        if lo < msz or fact {
            return;
        }
        num lim = -1;
        if a >= 0 {
            do(lim >> ch(VLIM >> get(a, -1)));
        }
        if lim >= 0 and lo >= lim {
            do(fail("в {name} максимум {lim} элементов (номера 0..{lim - 1}), а ты берёшь {lo}", line));
        }
        string have = "может не быть ни одного элемента";
        if msz > 0 {
            do(have >> ch("точно есть {msz} элементов (номера 0..{msz - 1})"));
        }
        do(fail("в {name} {have}, а ты берёшь номер {lo}", line));
    }
    bool ok_lo = lk and lo >= 0;
    bool ok_hi = (hk and hi < msz) or fact;
    if ok_lo and ok_hi {
        return;
    }
    string idx = "номер";
    if kind(inode) == "var" {
        do(idx >> ch(fs(inode)));
    }
    string have = "может не быть ни одного элемента";
    string hint = "if {idx} < {name} >> sz {{ ... }}";
    if msz > 0 {
        do(have >> ch("точно есть {msz} элементов (0..{msz - 1})"));
        do(hint >> ch("input(0:{msz - 1})"));
    }
    do(fail("не могу доказать, что {idx} попадает в {name}: в {name} {have}, а {idx} может быть от {fbound(lk, lo, true)} до {fbound(hk, hi, false)}.\n  Ограничь его: {hint} или if {idx} >= 0 and {idx} < {name} >> sz {{ ... }}", line));
}

# ═══════════════════════ программа целиком ═══════════════════════

fn fresh_gen() {
    mas o = (string);
    mas s = (string);
    mas st = (num);
    mas r = (string);
    mas br = (string);
    mas ct = (string);
    mas lr = (num);
    mas lo = (num);
    do(LOWN >> ch(lo));
    do(OWNDEP >> ch(0));
    do(LBRK >> ch(br));
    do(LCNT >> ch(ct));
    do(LREC >> ch(lr));
    do(LDEP >> ch(0));
    do(RECDEP >> ch(0));
    do(OUT >> ch(o));
    do(STUBS >> ch(s));
    do(ST >> ch(st));
    do(RETS >> ch(r));
    do(VBASE >> ch(VN >> sz));
    do(NSLOTS >> ch(0));
    do(RETLAB >> ch(newlab("ret")));
    do(UNKRET >> ch(false));
    do(SCBASE >> ch(SCTOP));
}

fn gen(num id, bool dry) {
    num f = IFN >> get(id, -1);
    do(fresh_gen());
    do(DRY >> ch(dry));
    do(CUR >> ch(id));
    mas ats = split(IARGS >> get(id, ""), 44);
    num argregs = 6;
    if IS_ARM {
        do(argregs >> ch(8));
    }
    for k in 0:c1(f) - 1 {
        num p = item(l1(f), k);
        num v = declare(fs(p), ats >> get(k, "?"), ln(f), -1, 0);
        do(sset(ST, v, 0, 1));
        if k < argregs {
            do(op_st(pr(k), vslot(v)));
        } else {
            if IS_ARM {
                do(em("ldr x0, [x29, #{16 + (k - argregs) * 16}]"));
            } else {
                do(em("mov rax, [rbp + {16 + (k - argregs) * 16}]"));
            }
            do(op_st(acc(), vslot(v)));
        }
    }
    # Spill all arguments before any ownership call can clobber argument registers.
    for k in 0:c1(f) - 1 {
        num p = item(l1(f), k);
        num v = find(fs(p));
        if is_path(vty(v)) {
            do(load_var(acc(), v));
            do(own_local(l2(f), c2(f), v, false, true));
        }
    }
    bool ended = block(l2(f), c2(f), false);
    if not ended {
        do(drop_locals(0));
    }
    if not dry and IRET >> get(id, "") != "void" and not ended {
        do(fail("функция {fs(f)} может закончиться без return — добавь return в конце", ln(f)));
    }
}

fn instance(num f, string key) {
    string k = "{fs(f)}|{key}";
    num i = 0;
    for x in IKEY {
        if x == k {
            return i;
        }
        do(i >> ch(i + 1));
    }
    num id = IKEY >> sz;
    do(IKEY >> add(k));
    do(IFN >> add(f));
    do(ILAB >> add("_f_{mangle(fs(f))}_{id}"));
    do(IRET >> add(""));
    do(ICODE >> add(""));
    do(IARGS >> add(key));
    # сохраняем текущую функцию
    all s_out = OUT;
    all s_stubs = STUBS;
    all s_st = ST;
    all s_rets = RETS;
    num s_vbase = VBASE;
    num s_nslots = NSLOTS;
    string s_retlab = RETLAB;
    bool s_dry = DRY;
    num s_cur = CUR;
    bool s_unk = UNKRET;
    num s_sctop = SCTOP;
    num s_scbase = SCBASE;
    num s_smtop = SMTOP;
    all s_lbrk = LBRK;
    all s_lcnt = LCNT;
    all s_lrec = LREC;
    all s_lown = LOWN;
    num s_owndep = OWNDEP;
    num s_ldep = LDEP;
    num s_recdep = RECDEP;
    # 1-й проход: узнаём, что функция возвращает
    do(gen(id, true));
    mas ds = (string);
    for t in RETS {
        bool seen = false;
        for d in ds {
            if d == t {
                do(seen >> ch(true));
            }
        }
        if not seen {
            do(ds >> add(t));
        }
    }
    string ret = "void";
    if ds >> sz == 0 {
        if UNKRET {
            do(fail("не могу понять, что возвращает {fs(f)}: каждый return зависит от самой функции. Добавь простой return, например в if", ln(f)));
        }
    } else if ds >> sz == 1 {
        do(ret >> ch(ds >> get(0, "void")));
    } else if ds >> sz == 2 and ((ds >> get(0, "") == "num" and ds >> get(1, "") == "dec") or (ds >> get(0, "") == "dec" and ds >> get(1, "") == "num")) {
        do(ret >> ch("dec"));
    } else {
        mas names = (string);
        for d in ds {
            do(names >> add(tn(d)));
        }
        do(fail("функция {fs(f)} возвращает разные типы: {names >> join(', ')}", ln(f)));
    }
    do(mset(IRET, id, ret));
    do(QUEUE >> add(id));
    # возвращаем текущую функцию
    do(OUT >> ch(s_out));
    do(STUBS >> ch(s_stubs));
    do(ST >> ch(s_st));
    do(RETS >> ch(s_rets));
    do(VBASE >> ch(s_vbase));
    do(NSLOTS >> ch(s_nslots));
    do(RETLAB >> ch(s_retlab));
    do(DRY >> ch(s_dry));
    do(CUR >> ch(s_cur));
    do(UNKRET >> ch(s_unk));
    do(SCTOP >> ch(s_sctop));
    do(SCBASE >> ch(s_scbase));
    do(SMTOP >> ch(s_smtop));
    do(LBRK >> ch(s_lbrk));
    do(LCNT >> ch(s_lcnt));
    do(LREC >> ch(s_lrec));
    do(LOWN >> ch(s_lown));
    do(OWNDEP >> ch(s_owndep));
    do(LDEP >> ch(s_ldep));
    do(RECDEP >> ch(s_recdep));
    return id;
}

fn run_queue() {
    num qi = 0;
    while qi < QUEUE >> sz {
        num id = QUEUE >> get(qi, -1);
        do(SCTOP >> ch(0));
        do(SMTOP >> ch(0));
        do(gen(id, false));
        do(mset(ICODE, id, finish(ILAB >> get(id, ""))));
        do(qi >> ch(qi + 1));
    }
}

fn init_globals() {
    do(SCTOP >> ch(0));
    do(SMTOP >> ch(0));
    do(fresh_gen());
    do(DRY >> ch(false));
    do(CUR >> ch(-1));
    for d in GLOBS {
        for j in 0:c1(d) - 1 {
            num it = item(l1(d), j);
            string name = fs(it);
            if fn_by_name(name) >= 0 {
                do(fail("{name} — уже имя функции", ln(it)));
            }
            if fm(it) == "empty" or fm(it) == "input" {
                do(fail("глобальной переменной нужно значение сразу: num x = 0;", ln(it)));
            }
            do(decl_item(it, 0, 0));
            num v = find(name);
            if vty(v) == "mas:?" {
                do(fail("у глобального массива нужен тип: mas {name} = (string);", ln(it)));
            }
            num g = new_var(name, vty(v), ln(it), VLIM >> get(v, -1), 0);
            do(mset(VGLOB, g, 1));
            do(mset(VLAB, g, "_g_{mangle(name)}"));
            do(op_ld(acc(), vslot(v)));
            do(SCTOP >> ch(SCTOP - 1));
            do(GLIST >> add(g));
            do(store_var(acc(), g));
        }
    }
    do(GINIT >> ch(finish("_bit_ginit")));
}

fn check_fns() {
    mas seen = (string);
    for f in FNS {
        for s in seen {
            if s == fs(f) {
                do(fail("функция {fs(f)} объявлена дважды", ln(f)));
            }
        }
        do(seen >> add(fs(f)));
    }
    num m = fn_by_name("main");
    if m < 0 {
        do(fail("нет host {{ }} — с него начинается программа", 1));
    }
    if c1(m) > 0 {
        do(fail("у main не бывает параметров", ln(m)));
    }
}

fn plain(string t) {
    return is_base(t) or t == "file" or t == "dir" or t == "bytes" or t == "proc" or t == "conn"
        or t == "server" or record_by_name(t) >= 0;
}

fn assemble() {
    do(SIGNALS_USED >> ch(false));
    do(init_globals());
    num mf = fn_by_name("main");
    num mi = instance(mf, "");
    if IRET >> get(mi, "") != "void" {
        do(fail("main ничего не возвращает — убери значение из return", ln(mf)));
    }
    for f in FNS {
        bool ok = true;
        mas key = (string);
        for k in 0:c1(f) - 1 {
            string t = ft(item(l1(f), k));
            if not plain(t) {
                do(ok >> ch(false));
            }
            do(key >> add(t));
        }
        if ok {
            do(instance(f, key >> join(",")));
        }
    }
    do(run_queue());
    mas out = (string);
    string ml = ILAB >> get(mi, "");
    if IS_ARM {
        do(out >> add(".section __TEXT,__text,regular,pure_instructions"));
        do(out >> add(".globl _main"));
        do(out >> add(".p2align 2"));
        do(out >> add("_main:"));
        do(out >> add("    stp x29, x30, [sp, #-16]!"));
        do(out >> add("    mov x29, sp"));
        do(out >> add("    sxtw x0, w0"));
        do(out >> add("    adrp x2, Lrt_argc@PAGE"));
        do(out >> add("    str x0, [x2, Lrt_argc@PAGEOFF]"));
        do(out >> add("    adrp x2, Lrt_argv@PAGE"));
        do(out >> add("    str x1, [x2, Lrt_argv@PAGEOFF]"));
        if SIGNALS_USED { do(out >> add("    bl _bit_signal_init")); }
        do(out >> add("    bl _bit_ginit"));
        do(out >> add("    bl {ml}"));
        do(out >> add("    mov x0, #0"));
        do(out >> add("    ldp x29, x30, [sp], #16"));
        do(out >> add("    ret"));
    } else if IS_WINDOWS {
        do(out >> add(".intel_syntax noprefix"));
        do(out >> add(".text"));
        do(out >> add(".globl main"));
        do(out >> add(".p2align 4"));
        do(out >> add("main:"));
        do(out >> add("    push rbp"));
        do(out >> add("    mov rbp, rsp"));
        do(out >> add("    sub rsp, 32"));
        do(out >> add("    movsxd rax, ecx"));
        do(out >> add("    mov [rip + Lrt_argc], rax"));
        do(out >> add("    mov [rip + Lrt_argv], rdx"));
        do(out >> add("    call _bit_win_init"));
        if SIGNALS_USED { do(out >> add("    call _bit_signal_init")); }
        do(out >> add("    call _bit_ginit"));
        do(out >> add("    call {ml}"));
        do(out >> add("    xor eax, eax"));
        do(out >> add("    add rsp, 32"));
        do(out >> add("    pop rbp"));
        do(out >> add("    ret"));
    } else {
        string ms = "_main";
        if IS_LINUX {
            do(ms >> ch("main"));
        }
        do(out >> add(".intel_syntax noprefix"));
        do(out >> add(sec_text()));
        do(out >> add(".globl {ms}"));
        do(out >> add(".p2align 4"));
        do(out >> add("{ms}:"));
        do(out >> add("    push rbp"));
        do(out >> add("    mov rbp, rsp"));
        do(out >> add("    movsxd rdi, edi"));
        do(out >> add("    mov [rip + Lrt_argc], rdi"));
        do(out >> add("    mov [rip + Lrt_argv], rsi"));
        if SIGNALS_USED { do(out >> add("    call _bit_signal_init")); }
        do(out >> add("    call _bit_ginit"));
        do(out >> add("    call {ml}"));
        do(out >> add("    xor eax, eax"));
        do(out >> add("    pop rbp"));
        do(out >> add("    ret"));
    }
    do(out >> add(GINIT));
    for c in ICODE {
        do(out >> add(c));
    }
    do(out >> add(sec_data()));
    do(out >> add(".p2align 3"));
    for g in GLIST {
        do(out >> add("{VLAB >> get(g, '')}: .quad 0"));
    }
    num di = 0;
    for d in DECS {
        do(out >> add("Ldec{di}: .double {d}"));
        do(di >> ch(di + 1));
    }
    do(out >> add(sec_text()));
    if IS_ARM {
        do(rt_arm(out));
    } else if IS_LINUX {
        do(rt_x86_linux(out));
    } else if IS_WINDOWS {
        do(rt_x86_windows(out));
    } else {
        do(rt_x86(out));
    }
    if IS_LINUX {
        do(out >> add(".section .rodata"));
    } else if IS_WINDOWS {
        do(out >> add(".section .rdata"));
    } else {
        do(out >> add(".section __TEXT,__cstring,cstring_literals"));
    }
    num si = 0;
    for s in STRS {
        do(out >> add("Lstr{si}: .asciz {asm_str(s)}"));
        do(si >> ch(si + 1));
    }
    return out >> join("\n") + "\n";
}

# ═══════════════════════ сборка и запуск ═══════════════════════

fn sec_text() {
    if IS_LINUX or IS_WINDOWS {
        return ".text";
    }
    return ".section __TEXT,__text,regular,pure_instructions";
}

fn sec_data() {
    if IS_LINUX or IS_WINDOWS {
        return ".data";
    }
    return ".section __DATA,__data";
}

fn usage() {
    print("bitc — компилятор языка bit (написан на bit)");
    print("");
    print("  bitc run   файл.bit [флаги] [-- аргументы]   собрать и запустить");
    print("  bitc build файл.bit [-o имя] [флаги]       собрать в программу");
    print("  bitc asm   файл.bit [флаги]                показать машинные команды");
    print("");
    print("  --arch arm64|x86_64   процессор (по умолчанию — этот компьютер)");
    print("  --os macos|linux|windows  система (windows — нужен mingw-w64)");
    do(term >> exit(1));
}

fn stop(string msg) {
    print(msg);
    do(term >> exit(1));
}

fn make_tmp() {
    string base = term >> env("TMPDIR");
    if base == "" and _bitc_host_os() == "windows" {
        do(base >> ch(term >> env("TEMP")));
    }
    if base == "" {
        do(base >> ch("/tmp/"));
    }
    if not ends(base, "/") {
        do(base >> ch(base + "/"));
    }
    string tpl = base + "bitc.XXXXXX";
    string d = "";
    recover {
        do(d >> ch(_bitc_mkdtemp(tpl)));
    } else {
        do(stop("не могу создать временную папку в {base}"));
    }
    return d;
}

fn clean_tmp(dir d) {
    recover {
        if d >> exists { do(d >> remove_all); }
    } else { }
}

fn run_tool(mas command) {
    string out = command >> run;
    string err = term >> stderr;
    if out == "" { return err; }
    if err == "" { return out; }
    return out + "\n" + err;
}

fn link_linux(string s, string o, string exe, string d) {
    mas command = ("as", "--64", "-o", o, s);
    string r = run_tool(command);
    if term >> status != 0 {
        do(clean_tmp(d));
        do(stop("внутренняя ошибка bit (ассемблер):\n{r}"));
    }
    string lib = "";
    mas dirs = ("/usr/lib", "/usr/lib64", "/usr/lib/x86_64-linux-gnu", "/lib/x86_64-linux-gnu");
    for dd in dirs {
        file c1 = "{dd}/crt1.o";
        if lib == "" and c1 >> exists {
            do(lib >> ch(dd));
        }
    }
    if lib == "" {
        do(clean_tmp(d));
        do(stop("не нашёл crt1.o — нужен пакет glibc для сборки (обычно уже стоит вместе с binutils)"));
    }
    mas linker = ("ld", "-o", exe, "-dynamic-linker", "/lib64/ld-linux-x86-64.so.2", lib + "/crt1.o", lib + "/crti.o", o, "-lc", lib + "/crtn.o");
    string r2 = run_tool(linker);
    if term >> status != 0 {
        do(clean_tmp(d));
        do(stop("внутренняя ошибка bit (линковщик):\n{r2}"));
    }
}

fn link_windows(string s, string exe, string d) {
    mas command = ("x86_64-w64-mingw32-gcc", "-static", s, "-o", exe, "-lws2_32", "-lbcrypt");
    string r = run_tool(command);
    if term >> status != 0 {
        do(clean_tmp(d));
        do(stop("ошибка сборки Windows (mingw):\n{r}"));
    }
}

# Find the selected macOS SDK without invoking xcrun.
fn mac_sdk_in(string developer, string sdk_name) {
    dir xcode = developer + "/Platforms/MacOSX.platform/Developer/SDKs/" + sdk_name;
    if xcode >> exists { return xcode >> path; }
    dir command_line = developer + "/SDKs/" + sdk_name;
    if command_line >> exists { return command_line >> path; }
    return "";
}

fn mac_sdk() {
    string setting = term >> env("SDKROOT");
    if starts(setting, "/") { return setting; }
    string sdk_name = "MacOSX.sdk";
    if starts(setting, "macosx") and setting != "macosx" {
        mas letters = setting >> bytes;
        do(sdk_name >> ch("MacOSX" + (letters >> text(6, letters >> sz)) + ".sdk"));
    }
    string developer = term >> env("DEVELOPER_DIR");
    if ends(developer, ".app/") { do(developer >> ch(developer + "Contents/Developer")); }
    else if ends(developer, ".app") { do(developer >> ch(developer + "/Contents/Developer")); }
    string found = "";
    if developer != "" {
        do(found >> ch(mac_sdk_in(developer, sdk_name)));
        if found != "" { return found; }
    }
    do(found >> ch(mac_sdk_in("/var/db/xcode_select_link", sdk_name)));
    if found != "" { return found; }
    do(found >> ch(mac_sdk_in("/Library/Developer/CommandLineTools", sdk_name)));
    if found != "" { return found; }
    do(found >> ch(mac_sdk_in("/Applications/Xcode.app/Contents/Developer", sdk_name)));
    if found != "" { return found; }
    return "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk";
}

fn link(string asm, string exe, string arch, string d) {
    file s = "{d}/prog.s";
    do(s >> write(asm));
    string o = "{d}/prog.o";
    if IS_WINDOWS {
        do(link_windows(s >> path, exe, d));
        return;
    }
    if IS_LINUX {
        do(link_linux(s >> path, o, exe, d));
        return;
    }
    mas assembler = ("as", "-arch", arch, "-mmacosx-version-min=13.0", "-o", o, s >> path);
    string r = run_tool(assembler);
    if term >> status != 0 {
        do(clean_tmp(d));
        do(stop("внутренняя ошибка bit (ассемблер):\n{r}"));
    }
    string sdk = mac_sdk();
    mas linker = ("ld", "-arch", arch, "-platform_version", "macos", "13.0", "13.0", "-syslibroot", sdk, "-lSystem", "-e", "_main", "-o", exe, o);
    string r2 = run_tool(linker);
    if term >> status != 0 {
        do(clean_tmp(d));
        do(stop("внутренняя ошибка bit (линковщик):\n{r2}"));
    }
}

host {
    mas args = term >> args;
    string cmd = args >> get(0, "");
    if args >> sz < 2 or not (cmd == "run" or cmd == "build" or cmd == "asm") {
        do(usage());
    }
    do(PATH >> ch(args >> get(1, "")));
    string out = "";
    string arch = _bitc_host_arch();
    string os = _bitc_host_os();
    mas extra = (string);
    bool rest = false;
    num k = 2;
    while k < args >> sz {
        string a = args >> get(k, "");
        if rest {
            do(extra >> add(a));
            do(k >> ch(k + 1));
        } else if a == "--" {
            if cmd != "run" {
                do(stop("-- нужен только для run: после него идут аргументы программы"));
            }
            do(rest >> ch(true));
            do(k >> ch(k + 1));
        } else if a == "-o" {
            if cmd != "build" {
                do(stop("-o нужен только для build"));
            }
            if k + 1 >= args >> sz or args >> get(k + 1, "") == "" {
                do(stop("после -o нужно имя файла"));
            }
            do(out >> ch(args >> get(k + 1, "")));
            do(k >> ch(k + 2));
        } else if a == "--os" {
            if k + 1 >= args >> sz {
                do(stop("после --os нужна система: macos или linux"));
            }
            do(os >> ch(args >> get(k + 1, "")));
            do(k >> ch(k + 2));
        } else if a == "--arch" {
            if k + 1 >= args >> sz {
                do(stop("после --arch нужна архитектура: arm64 или x86_64"));
            }
            do(arch >> ch(args >> get(k + 1, "")));
            do(k >> ch(k + 2));
        } else if starts(a, "-") {
            do(stop("неизвестный флаг {a}. Есть: -o, --arch, --os, -- (после него — аргументы программы)"));
        } else if cmd == "run" {
            do(extra >> add(a));
            do(k >> ch(k + 1));
        } else {
            do(stop("лишний аргумент {a}"));
        }
    }
    if arch != "arm64" and arch != "x86_64" {
        do(stop("неизвестная архитектура {arch}: можно arm64 или x86_64"));
    }
    if os != "macos" and os != "linux" and os != "windows" {
        do(stop("неизвестная система {os}: можно macos, linux или windows"));
    }
    if (os == "linux" or os == "windows") and arch != "x86_64" {
        do(arch >> ch("x86_64"));
    }
    if os == "windows" and cmd == "run" {
        do(stop("Windows-программу тут не запустить — собери: bitc build {PATH} --os windows -o имя.exe"));
    }
    do(IS_ARM >> ch(arch == "arm64"));
    do(IS_LINUX >> ch(os == "linux"));
    do(IS_WINDOWS >> ch(os == "windows"));
    file f = PATH;
    if not f >> exists {
        do(stop("не могу открыть {PATH}"));
    }
    string exe = out;
    if cmd == "build" {
        if exe == "" {
            if not ends(PATH, ".bit") {
                do(stop("{PATH} не кончается на .bit — скажи, куда собрать: -o имя"));
            }
            mas pb = PATH >> bytes;
            do(exe >> ch(pb >> text(0, (pb >> sz) - 4)));
        }
        if exe == PATH {
            do(stop("-o {exe} совпадает с исходником — так исходник затрётся"));
        }
    }
    string src = f >> read;
    string full = PATH;
    if not starts(full, "/") {
        dir folder = term >> folder;
        do(full >> ch((folder >> path) + "/" + full));
    }
    do(full >> ch(normalize_source_path(full)));
    do(SOURCES_ACTIVE >> add(full));
    do(P >> ch(add_source(PATH, src)));
    do(builtin_records());
    do(program(full, true));
    do(check_fns());
    string asm = assemble();
    if cmd == "asm" {
        print(asm);
        return;
    }
    string d = make_tmp();
    if cmd == "run" {
        do(exe >> ch("{d}/prog"));
    }
    do(link(asm, exe, arch, d));
    if cmd == "build" {
        do(clean_tmp(d));
        print("готово: {exe}");
        return;
    }
    mas command = (string);
    do(command >> add(exe));
    for value in extra { do(command >> add(value)); }
    num code = _bitc_run_direct(command);
    do(clean_tmp(d));
    do(term >> exit(code));
}

# ═══════════════ среда выполнения (собрано из rt/arm64.s и rt/x86_64.s) ═══════════════

fn rt_arm(mas o) {
    do(o >> add(""));
    do(o >> add("// ─────────── среда выполнения bit ───────────"));
    do(o >> add(".p2align 2"));
    do(o >> add("_bit_signal_handler:                 // async-signal-safe: set one aligned flag"));
    do(o >> add("    adrp x9, Lrt_signalled@PAGE"));
    do(o >> add("    add x9, x9, Lrt_signalled@PAGEOFF"));
    do(o >> add("    mov w10, #1"));
    do(o >> add("    stlr w10, [x9]"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_signalled:"));
    do(o >> add("    adrp x9, Lrt_signalled@PAGE"));
    do(o >> add("    add x9, x9, Lrt_signalled@PAGEOFF"));
    do(o >> add("    ldar w0, [x9]"));
    do(o >> add("    cmp w0, #0"));
    do(o >> add("    cset w0, ne"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_signal_init:                    // Darwin sigaction: handler, mask, flags"));
    do(o >> add("    stp x29, x30, [sp, #-16]!"));
    do(o >> add("    mov x29, sp"));
    do(o >> add("    sub sp, sp, #16"));
    do(o >> add("    adrp x9, _bit_signal_handler@PAGE"));
    do(o >> add("    add x9, x9, _bit_signal_handler@PAGEOFF"));
    do(o >> add("    str x9, [sp]"));
    do(o >> add("    str wzr, [sp, #8]"));
    do(o >> add("    mov w9, #2                       // SA_RESTART"));
    do(o >> add("    str w9, [sp, #12]"));
    do(o >> add("    mov w0, #2                       // SIGINT"));
    do(o >> add("    mov x1, sp"));
    do(o >> add("    mov x2, #0"));
    do(o >> add("    bl _sigaction"));
    do(o >> add("    cbnz w0, 9f"));
    do(o >> add("    mov w0, #15                      // SIGTERM"));
    do(o >> add("    mov x1, sp"));
    do(o >> add("    mov x2, #0"));
    do(o >> add("    bl _sigaction"));
    do(o >> add("    cbnz w0, 9f"));
    do(o >> add("    add sp, sp, #16"));
    do(o >> add("    ldp x29, x30, [sp], #16"));
    do(o >> add("    ret"));
    do(o >> add("9:  add sp, sp, #16"));
    do(o >> add("    ldp x29, x30, [sp], #16"));
    do(o >> add("    adrp x0, Lrt_esignal@PAGE"));
    do(o >> add("    add x0, x0, Lrt_esignal@PAGEOFF"));
    do(o >> add("    mov x1, #0"));
    do(o >> add("    b _bit_die"));
    do(o >> add(""));
    do(o >> add("_bit_rt_ensure:                     // однократная подготовка ключа потока и замка строк"));
    do(o >> add("    adrp x9, Lrt_ready@PAGE"));
    do(o >> add("    ldrb w10, [x9, Lrt_ready@PAGEOFF]"));
    do(o >> add("    cbnz w10, 9f"));
    do(o >> add("    stp x29, x30, [sp, #-16]!"));
    do(o >> add("    mov x29, sp"));
    do(o >> add("    adrp x0, Lrt_tkey@PAGE"));
    do(o >> add("    add x0, x0, Lrt_tkey@PAGEOFF"));
    do(o >> add("    mov x1, #0"));
    do(o >> add("    bl _pthread_key_create"));
    do(o >> add("    adrp x0, Lrt_slock@PAGE"));
    do(o >> add("    add x0, x0, Lrt_slock@PAGEOFF"));
    do(o >> add("    mov x1, #0"));
    do(o >> add("    bl _pthread_mutex_init"));
    do(o >> add("    adrp x9, Lrt_ready@PAGE"));
    do(o >> add("    mov w10, #1"));
    do(o >> add("    strb w10, [x9, Lrt_ready@PAGEOFF]"));
    do(o >> add("    ldp x29, x30, [sp], #16"));
    do(o >> add("9:  ret"));
    do(o >> add(""));
    do(o >> add("_bit_lock:"));
    do(o >> add("    stp x29, x30, [sp, #-16]!"));
    do(o >> add("    mov x29, sp"));
    do(o >> add("    bl _bit_rt_ensure"));
    do(o >> add("    adrp x0, Lrt_slock@PAGE"));
    do(o >> add("    add x0, x0, Lrt_slock@PAGEOFF"));
    do(o >> add("    bl _pthread_mutex_lock"));
    do(o >> add("    ldp x29, x30, [sp], #16"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_unlock:"));
    do(o >> add("    stp x29, x30, [sp, #-16]!"));
    do(o >> add("    mov x29, sp"));
    do(o >> add("    adrp x0, Lrt_slock@PAGE"));
    do(o >> add("    add x0, x0, Lrt_slock@PAGEOFF"));
    do(o >> add("    bl _pthread_mutex_unlock"));
    do(o >> add("    ldp x29, x30, [sp], #16"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_tstate:                        // → блок состояния этого потока"));
    do(o >> add("    stp x29, x30, [sp, #-16]!"));
    do(o >> add("    mov x29, sp"));
    do(o >> add("    stp x19, x20, [sp, #-16]!"));
    do(o >> add("    bl _bit_rt_ensure"));
    do(o >> add("    adrp x0, Lrt_tkey@PAGE"));
    do(o >> add("    add x0, x0, Lrt_tkey@PAGEOFF"));
    do(o >> add("    ldr x0, [x0]"));
    do(o >> add("    bl _pthread_getspecific"));
    do(o >> add("    cbnz x0, 9f"));
    do(o >> add("    mov x0, #64"));
    do(o >> add("    bl _bit_alloc"));
    do(o >> add("    mov x19, x0"));
    do(o >> add("    mov x0, x19"));
    do(o >> add("    mov x1, #0"));
    do(o >> add("    mov x2, #64"));
    do(o >> add("    bl _memset"));
    do(o >> add("    adrp x0, Lrt_tkey@PAGE"));
    do(o >> add("    add x0, x0, Lrt_tkey@PAGEOFF"));
    do(o >> add("    ldr x0, [x0]"));
    do(o >> add("    mov x1, x19"));
    do(o >> add("    bl _pthread_setspecific"));
    do(o >> add("    mov x0, x19"));
