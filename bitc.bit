    do(o >> add("    add rsp, 8"));
    do(o >> add("    pop rbx"));
    do(o >> add("    pop rbp"));
    do(o >> add("    jmp _bit_drop_str"));
    do(o >> add(""));
    do(o >> add("_bit_setjmp:                        # rdi = буфер → 0; сохраняет callee-saved, sp и адрес возврата"));
    do(o >> add("    mov [rdi], rbx"));
    do(o >> add("    mov [rdi + 8], rbp"));
