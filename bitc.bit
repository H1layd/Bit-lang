    do(o >> add("Lrt_echunk: .asciz \"\\321\\201\\320\\274\\320\\265\\321\\211\\320\\265\\320\\275\\320\\270\\320\\265\\040\\320\\270\\040\\321\\200\\320\\260\\320\\267\\320\\274\\320\\265\\321\\200\\040\\320\\264\\320\\276\\320\\273\\320\\266\\320\\275\\321\\213\\040\\320\\261\\321\\213\\321\\202\\321\\214\\040\\320\\275\\320\\265\\320\\276\\321\\202\\321\\200\\320\\270\\321\\206\\320\\260\\321\\202\\320\\265\\320\\273\\321\\214\\320\\275\\321\\213\\320\\274\\320\\270\""));
    do(o >> add("Lrt_erecv_timeout: .asciz \"\\320\\270\\321\\201\\321\\202\\320\\265\\320\\272\\320\\273\\320\\276\\040\\320\\262\\321\\200\\320\\265\\320\\274\\321\\217\\040\\320\\276\\320\\266\\320\\270\\320\\264\\320\\260\\320\\275\\320\\270\\321\\217\\040\\162\\145\\143\\166\""));
    do(o >> add("Lrt_erecv_args: .asciz \"\\162\\145\\143\\166\\072\\040\\321\\200\\320\\260\\320\\267\\320\\274\\320\\265\\321\\200\\040\\061\\056\\056\\062\\061\\064\\067\\064\\070\\063\\066\\064\\067\\054\\040\\320\\276\\320\\266\\320\\270\\320\\264\\320\\260\\320\\275\\320\\270\\320\\265\\040\\060\\056\\056\\062\\061\\064\\067\\064\\070\\063\\066\\064\\067\\040\\320\\274\\321\\201\""));
    do(o >> add("Lrt_wb: .asciz \"wb\""));
