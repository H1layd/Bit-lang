    do(o >> add("Lrt_eof: .asciz \"\\320\\262\\320\\262\\320\\276\\320\\264 \\320\\267\\320\\260\\320\\272\\320\\276\\320\\275\\321\\207\\320\\270\\320\\273\\321\\201\\321\\217, \\320\\260 \\320\\277\\321\\200\\320\\276\\320\\263\\321\\200\\320\\260\\320\\274\\320\\274\\320\\260 \\320\\266\\320\\264\\320\\260\\320\\273\\320\\260 \\320\\267\\320\\275\\320\\260\\321\\207\\320\\265\\320\\275\\320\\270\\320\\265\""));
