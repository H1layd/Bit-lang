    do(o >> add("Lrt_mekill: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\320\\276\\321\\201\\321\\202\\320\\260\\320\\275\\320\\276\\320\\262\\320\\270\\321\\202\\321\\214 \\320\\277\\321\\200\\320\\276\\321\\206\\320\\265\\321\\201\\321\\201 \""));
