    do(o >> add("Lrt_echar_range: .asciz \"char: \\320\\272\\320\\276\\320\\264 \\321\\201\\320\\270\\320\\274\\320\\262\\320\\276\\320\\273\\320\\260 \\320\\276\\321\\202 0 \\320\\264\\320\\276 1114111\""));
    do(o >> add("Lrt_elock: .asciz \"lock operation failed\""));
