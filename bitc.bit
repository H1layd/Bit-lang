}

fn rt_x86_windows(mas o) {
    do(o >> add("// ─────────── среда выполнения bit (Windows x64) ───────────"));
    do(o >> add("// Внутри bit всё по своему соглашению (rdi, rsi, rdx...), а соглашение Windows"));
    do(o >> add("// (rcx, rdx, r8, r9 + 32 байта «теневого» места) спрятано в обёртках _w_* и ядре."));
    do(o >> add(".intel_syntax noprefix"));
    do(o >> add(".text"));
    do(o >> add(""));
    do(o >> add("// ── обёртки libc: вход по-нашему (rdi,rsi,rdx,rcx), внутри — Windows ABI ──"));
    do(o >> add("_w_getentropy:"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    xor ecx, ecx"));
    do(o >> add("    mov rdx, rdi"));
    do(o >> add("    mov r8d, esi"));
    do(o >> add("    mov r9d, 2"));
    do(o >> add("    call BCryptGenRandom"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_rename:"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    mov rdx, rsi"));
    do(o >> add("    // MOVEFILE_REPLACE_EXISTING"));
    do(o >> add("    mov r8d, 1"));
    do(o >> add("    call MoveFileExA"));
    do(o >> add("    test eax, eax"));
    do(o >> add("    jnz 1f"));
    do(o >> add("    call GetLastError"));
    do(o >> add("    mov dword ptr [rsp + 32], eax"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    mov rdx, rsi"));
    do(o >> add("    call strcmp"));
    do(o >> add("    test eax, eax"));
    do(o >> add("    jnz 2f"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    call GetFileAttributesA"));
    do(o >> add("    cmp eax, -1"));
    do(o >> add("    jne 1f"));
    do(o >> add("2:  mov eax, dword ptr [rsp + 32]"));
    do(o >> add("    // ERROR_NOT_SAME_DEVICE -> EXDEV"));
    do(o >> add("    mov ecx, 5"));
    do(o >> add("    mov edx, 18"));
    do(o >> add("    cmp eax, 17"));
    do(o >> add("    cmove ecx, edx"));
    do(o >> add("    mov dword ptr [rsp + 32], ecx"));
    do(o >> add("    call _errno"));
    do(o >> add("    mov ecx, dword ptr [rsp + 32]"));
    do(o >> add("    mov dword ptr [rax], ecx"));
    do(o >> add("    mov eax, -1"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("1:  xor eax, eax"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_malloc:"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    call malloc"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_calloc:"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    mov rdx, rsi"));
    do(o >> add("    call calloc"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_realloc:"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    mov rdx, rsi"));
    do(o >> add("    call realloc"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_free:"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    call free"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_strlen:"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    call strlen"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_memcpy:"));
    do(o >> add("    mov r8, rdx"));
    do(o >> add("    mov rdx, rsi"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    call memcpy"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add("_w_qsort:"));
    do(o >> add("    mov r9, rcx"));
    do(o >> add("    mov r8, rdx"));
    do(o >> add("    mov rdx, rsi"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    sub rsp, 40"));
    do(o >> add("    call qsort"));
    do(o >> add("    add rsp, 40"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("// ── ядро ──"));
    do(o >> add("_bit_alloc:"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    sub rsp, 32"));
    do(o >> add("    mov rcx, rdi"));
    do(o >> add("    call malloc"));
    do(o >> add("    add rsp, 32"));
    do(o >> add("    pop rbp"));
    do(o >> add("    test rax, rax"));
    do(o >> add("    jz _bit_oom"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_oom:"));
    do(o >> add("    and rsp, -16"));
    do(o >> add("    sub rsp, 32"));
    do(o >> add("    lea rcx, [rip + Lrt_oom]"));
    do(o >> add("    call puts"));
    do(o >> add("    mov ecx, 1"));
    do(o >> add("    call exit"));
    do(o >> add(""));
    do(o >> add("_bit_signal_handler:                 # Windows console control callback"));
    do(o >> add("    cmp ecx, 0                       # CTRL_C_EVENT"));
    do(o >> add("    je 1f"));
    do(o >> add("    cmp ecx, 1                       # CTRL_BREAK_EVENT"));
    do(o >> add("    je 1f"));
    do(o >> add("    cmp ecx, 2                       # CTRL_CLOSE_EVENT"));
    do(o >> add("    je 2f"));
    do(o >> add("    xor eax, eax"));
    do(o >> add("    ret"));
    do(o >> add("1:  mov dword ptr [rip + Lrt_signalled], 1"));
    do(o >> add("    mov eax, 1"));
    do(o >> add("    ret"));
    do(o >> add("2:  mov dword ptr [rip + Lrt_signalled], 1"));
    do(o >> add("    # Returning from a close handler ends the process immediately. Keep this"));
    do(o >> add("    # handler alive while the main thread performs cleanup; Windows may still"));
    do(o >> add("    # terminate the process when its console-close timeout expires."));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    and rsp, -16"));
    do(o >> add("    sub rsp, 32"));
    do(o >> add("3:  mov ecx, 500"));
    do(o >> add("    call Sleep"));
    do(o >> add("    jmp 3b"));
    do(o >> add(""));
    do(o >> add("_bit_signalled:"));
    do(o >> add("    xor eax, eax"));
    do(o >> add("    cmp dword ptr [rip + Lrt_signalled], 0"));
    do(o >> add("    setne al"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_signal_init:"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    and rsp, -16"));
    do(o >> add("    sub rsp, 32"));
    do(o >> add("    # Explicit opt-in also enables CTRL+C inherited as ignored from a parent."));
    do(o >> add("    xor ecx, ecx"));
    do(o >> add("    xor edx, edx"));
    do(o >> add("    call SetConsoleCtrlHandler"));
    do(o >> add("    lea rcx, [rip + _bit_signal_handler]"));
    do(o >> add("    mov edx, 1"));
    do(o >> add("    call SetConsoleCtrlHandler"));
    do(o >> add("    test eax, eax"));
    do(o >> add("    jz 9f"));
    do(o >> add("    mov rsp, rbp"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add("9:  mov rsp, rbp"));
    do(o >> add("    pop rbp"));
    do(o >> add("    lea rdi, [rip + Lrt_esignal]"));
    do(o >> add("    xor esi, esi"));
    do(o >> add("    jmp _bit_die"));
    do(o >> add(""));
    do(o >> add("_bit_rt_ensure:                      # подготовка ключа потока и замка строк"));
    do(o >> add("    cmp byte ptr [rip + Lrt_ready], 0"));
    do(o >> add("    jne 9f"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    and rsp, -16"));
    do(o >> add("    sub rsp, 32"));
    do(o >> add("    call TlsAlloc"));
    do(o >> add("    mov [rip + Lrt_tkey], rax"));
