    do(o >> add("Lrt_ewrite: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\320\\267\\320\\260\\320\\277\\320\\270\\321\\201\\320\\260\\321\\202\\321\\214 \\320\\262 \\321\\204\\320\\260\\320\\271\\320\\273: \""));
    do(o >> add("Lrt_erm: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\321\\203\\320\\264\\320\\260\\320\\273\\320\\270\\321\\202\\321\\214: \""));
    do(o >> add("Lrt_emv: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\320\\277\\320\\265\\321\\200\\320\\265\\320\\274\\320\\265\\321\\201\\321\\202\\320\\270\\321\\202\\321\\214: \""));
    do(o >> add("Lrt_emk: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\321\\201\\320\\276\\320\\267\\320\\264\\320\\260\\321\\202\\321\\214 \\320\\277\\320\\260\\320\\277\\320\\272\\321\\203: \""));
    do(o >> add("Lrt_edir: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\320\\276\\321\\202\\320\\272\\321\\200\\321\\213\\321\\202\\321\\214 \\320\\277\\320\\260\\320\\277\\320\\272\\321\\203: \""));
    do(o >> add("Lrt_erun: .asciz \"\\320\\275\\320\\265 \\320\\274\\320\\276\\320\\263\\321\\203 \\320\\267\\320\\260\\320\\277\\321\\203\\321\\201\\321\\202\\320\\270\\321\\202\\321\\214 \\320\\272\\320\\276\\320\\274\\320\\260\\320\\275\\320\\264\\321\\203: \""));
    do(o >> add(".text"));
