    do(o >> add("Lrt_numr: .asciz \"\\320\\275\\321\\203\\320\\266\\320\\275\\320\\276 \\321\\206\\320\\265\\320\\273\\320\\276\\320\\265 \\321\\207\\320\\270\\321\\201\\320\\273\\320\\276 \\320\\276\\321\\202 %lld \\320\\264\\320\\276 %lld, \\320\\277\\320\\276\\320\\277\\321\\200\\320\\276\\320\\261\\321\\203\\320\\271 \\320\\265\\321\\211\\321\\221 \\321\\200\\320\\260\\320\\267: \""));
    do(o >> add("Lrt_num: .asciz \"\\320\\275\\321\\203\\320\\266\\320\\275\\320\\276 \\321\\206\\320\\265\\320\\273\\320\\276\\320\\265 \\321\\207\\320\\270\\321\\201\\320\\273\\320\\276, \\320\\277\\320\\276\\320\\277\\321\\200\\320\\276\\320\\261\\321\\203\\320\\271 \\320\\265\\321\\211\\321\\221 \\321\\200\\320\\260\\320\\267: \""));
    do(o >> add("Lrt_decr: .asciz \"\\320\\275\\321\\203\\320\\266\\320\\275\\320\\276 \\321\\207\\320\\270\\321\\201\\320\\273\\320\\276 \\320\\276\\321\\202 %g \\320\\264\\320\\276 %g, \\320\\277\\320\\276\\320\\277\\321\\200\\320\\276\\320\\261\\321\\203\\320\\271 \\320\\265\\321\\211\\321\\221 \\321\\200\\320\\260\\320\\267: \""));
    do(o >> add("Lrt_dec: .asciz \"\\320\\275\\321\\203\\320\\266\\320\\275\\320\\276 \\321\\207\\320\\270\\321\\201\\320\\273\\320\\276, \\320\\277\\320\\276\\320\\277\\321\\200\\320\\276\\320\\261\\321\\203\\320\\271 \\320\\265\\321\\211\\321\\221 \\321\\200\\320\\260\\320\\267: \""));
    do(o >> add("Lrt_boolm: .asciz \"\\320\\275\\321\\203\\320\\266\\320\\275\\320\\276 true \\320\\270\\320\\273\\320\\270 false (\\320\\264\\320\\260/\\320\\275\\320\\265\\321\\202), \\320\\277\\320\\276\\320\\277\\321\\200\\320\\276\\320\\261\\321\\203\\320\\271 \\320\\265\\321\\211\\321\\221 \\321\\200\\320\\260\\320\\267: \""));
    do(o >> add("Lrt_rb: .asciz \"rb\""));
