    do(o >> add("Lrt_oom: .asciz \"\\320\\275\\320\\265 \\321\\205\\320\\262\\320\\260\\321\\202\\320\\260\\320\\265\\321\\202 \\320\\277\\320\\260\\320\\274\\321\\217\\321\\202\\320\\270\""));
    do(o >> add("Lrt_full: .asciz \"\\320\\274\\320\\260\\321\\201\\321\\201\\320\\270\\320\\262 \\320\\267\\320\\260\\320\\277\\320\\276\\320\\273\\320\\275\\320\\265\\320\\275 \\342\\200\\224 \\321\\215\\320\\273\\320\\265\\320\\274\\320\\265\\320\\275\\321\\202\\320\\276\\320\\262 \\321\\203\\320\\266\\320\\265 \\321\\201\\321\\202\\320\\276\\320\\273\\321\\214\\320\\272\\320\\276, \\321\\201\\320\\272\\320\\276\\320\\273\\321\\214\\320\\272\\320\\276 \\320\\273\\320\\270\\320\\274\\320\\270\\321\\202\""));
