fn rt_x86(mas o) {
    do(o >> add(".intel_syntax noprefix"));
    do(o >> add(".section __TEXT,__text,regular,pure_instructions"));
    do(o >> add(""));
    do(o >> add("// ─────────── среда выполнения bit (x86_64) ───────────"));
    do(o >> add("// аргументы: rdi, rsi, rdx, rcx, r8, r9; результат: rax"));
    do(o >> add(".p2align 4"));
    do(o >> add("_bit_signal_handler:                 // async-signal-safe: set one aligned flag"));
    do(o >> add("    mov dword ptr [rip + Lrt_signalled], 1"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_signalled:"));
    do(o >> add("    xor eax, eax"));
    do(o >> add("    cmp dword ptr [rip + Lrt_signalled], 0"));
    do(o >> add("    setne al"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_signal_init:                    // Darwin sigaction: handler, mask, flags"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    sub rsp, 16"));
    do(o >> add("    lea rax, [rip + _bit_signal_handler]"));
    do(o >> add("    mov [rsp], rax"));
    do(o >> add("    mov dword ptr [rsp + 8], 0"));
    do(o >> add("    mov dword ptr [rsp + 12], 2      // SA_RESTART"));
    do(o >> add("    mov edi, 2                       // SIGINT"));
    do(o >> add("    mov rsi, rsp"));
    do(o >> add("    xor edx, edx"));
    do(o >> add("    call _sigaction"));
    do(o >> add("    test eax, eax"));
    do(o >> add("    jnz 9f"));
    do(o >> add("    mov edi, 15                      // SIGTERM"));
    do(o >> add("    mov rsi, rsp"));
    do(o >> add("    xor edx, edx"));
    do(o >> add("    call _sigaction"));
    do(o >> add("    test eax, eax"));
    do(o >> add("    jnz 9f"));
    do(o >> add("    add rsp, 16"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add("9:  add rsp, 16"));
    do(o >> add("    pop rbp"));
    do(o >> add("    lea rdi, [rip + Lrt_esignal]"));
    do(o >> add("    xor esi, esi"));
    do(o >> add("    jmp _bit_die"));
    do(o >> add(""));
    do(o >> add("_bit_rt_ensure:                     // однократная подготовка ключа потока и замка строк"));
    do(o >> add("    cmp byte ptr [rip + Lrt_ready], 0"));
    do(o >> add("    jne 9f"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    sub rsp, 16"));
    do(o >> add("    lea rdi, [rip + Lrt_tkey]"));
    do(o >> add("    xor esi, esi"));
    do(o >> add("    call _pthread_key_create"));
    do(o >> add("    lea rdi, [rip + Lrt_slock]"));
    do(o >> add("    xor esi, esi"));
    do(o >> add("    call _pthread_mutex_init"));
    do(o >> add("    mov byte ptr [rip + Lrt_ready], 1"));
    do(o >> add("    add rsp, 16"));
    do(o >> add("    pop rbp"));
    do(o >> add("9:  ret"));
    do(o >> add(""));
    do(o >> add("_bit_lock:"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    call _bit_rt_ensure"));
    do(o >> add("    lea rdi, [rip + Lrt_slock]"));
    do(o >> add("    call _pthread_mutex_lock"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_unlock:"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    lea rdi, [rip + Lrt_slock]"));
    do(o >> add("    call _pthread_mutex_unlock"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_tstate:                        // → блок состояния этого потока"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    push rbx"));
    do(o >> add("    sub rsp, 8"));
    do(o >> add("    call _bit_rt_ensure"));
    do(o >> add("    mov rdi, [rip + Lrt_tkey]"));
    do(o >> add("    call _pthread_getspecific"));
    do(o >> add("    test rax, rax"));
    do(o >> add("    jnz 9f"));
    do(o >> add("    mov edi, 64"));
    do(o >> add("    call _bit_alloc"));
    do(o >> add("    mov rbx, rax"));
    do(o >> add("    mov rdi, rax"));
    do(o >> add("    xor esi, esi"));
    do(o >> add("    mov edx, 64"));
    do(o >> add("    call _memset"));
    do(o >> add("    mov rdi, [rip + Lrt_tkey]"));
    do(o >> add("    mov rsi, rbx"));
    do(o >> add("    call _pthread_setspecific"));
    do(o >> add("    mov rax, rbx"));
    do(o >> add("9:  add rsp, 8"));
    do(o >> add("    pop rbx"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_recover_enter:                 // rdi = frame allocated by the compiler"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    push rbx"));
    do(o >> add("    push r12"));
    do(o >> add("    mov r12, rdi"));
    do(o >> add("    call _bit_tstate"));
    do(o >> add("    mov rbx, rax"));
    do(o >> add("    mov rax, [rbx]"));
    do(o >> add("    mov [r12 + 168], rax"));
    do(o >> add("    mov [rbx], r12"));
    do(o >> add("    mov rax, [rbx + 8]"));
    do(o >> add("    mov [r12 + 176], rax"));
    do(o >> add("    mov qword ptr [rbx + 32], 0"));
    do(o >> add("    mov rax, r12"));
    do(o >> add("    pop r12"));
    do(o >> add("    pop rbx"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_recover_leave:"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    push rbx"));
    do(o >> add("    sub rsp, 8"));
    do(o >> add("    call _bit_tstate"));
    do(o >> add("    mov rbx, rax"));
    do(o >> add("    mov rax, [rbx]"));
    do(o >> add("    mov rax, [rax + 168]"));
    do(o >> add("    mov [rbx], rax"));
    do(o >> add("    add rsp, 8"));
    do(o >> add("    pop rbx"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_own_str:                       // rdi = stack record with string and previous pointer"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    push rbx"));
    do(o >> add("    sub rsp, 8"));
    do(o >> add("    mov rbx, rdi"));
    do(o >> add("    call _bit_tstate"));
    do(o >> add("    mov rcx, [rax + 8]"));
    do(o >> add("    mov [rbx + 8], rcx"));
    do(o >> add("    mov [rax + 8], rbx"));
    do(o >> add("    add rsp, 8"));
    do(o >> add("    pop rbx"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_drop_owned:"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    push rbx"));
    do(o >> add("    sub rsp, 8"));
    do(o >> add("    call _bit_tstate"));
    do(o >> add("    mov rbx, rax"));
    do(o >> add("    mov rax, [rbx + 8]"));
    do(o >> add("    mov rcx, [rax + 8]"));
    do(o >> add("    mov [rbx + 8], rcx"));
    do(o >> add("    mov rdi, [rax]"));
    do(o >> add("    add rsp, 8"));
    do(o >> add("    pop rbx"));
    do(o >> add("    pop rbp"));
    do(o >> add("    jmp _bit_drop_str"));
    do(o >> add(""));
    do(o >> add("_bit_setjmp:                        // rdi = буфер → 0; сохраняет callee-saved, sp и адрес возврата"));
    do(o >> add("    mov [rdi], rbx"));
    do(o >> add("    mov [rdi + 8], rbp"));
    do(o >> add("    mov [rdi + 16], r12"));
    do(o >> add("    mov [rdi + 24], r13"));
    do(o >> add("    mov [rdi + 32], r14"));
    do(o >> add("    mov [rdi + 40], r15"));
    do(o >> add("    lea rdx, [rsp + 8]"));
    do(o >> add("    mov [rdi + 48], rdx"));
    do(o >> add("    mov rdx, [rsp]"));
    do(o >> add("    mov [rdi + 56], rdx"));
    do(o >> add("    xor eax, eax"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_longjmp:                       // rdi = буфер, rsi = значение → возврат из _bit_setjmp"));
    do(o >> add("    mov rbx, [rdi]"));
    do(o >> add("    mov rbp, [rdi + 8]"));
    do(o >> add("    mov r12, [rdi + 16]"));
    do(o >> add("    mov r13, [rdi + 24]"));
    do(o >> add("    mov r14, [rdi + 32]"));
    do(o >> add("    mov r15, [rdi + 40]"));
    do(o >> add("    mov rsp, [rdi + 48]"));
    do(o >> add("    mov rax, rsi"));
    do(o >> add("    jmp qword ptr [rdi + 56]"));
    do(o >> add(""));
    do(o >> add("_bit_set_errcode:                   // rdi = код → запомнить для этого потока"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    push rbx"));
    do(o >> add("    sub rsp, 8"));
    do(o >> add("    mov rbx, rdi"));
    do(o >> add("    call _bit_tstate"));
    do(o >> add("    mov [rax + 32], rbx"));
    do(o >> add("    add rsp, 8"));
    do(o >> add("    pop rbx"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_term_errcode:                  // → код последней пойманной ошибки (0 = без кода)"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    call _bit_tstate"));
    do(o >> add("    mov rax, [rax + 32]"));
    do(o >> add("    pop rbp"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_errno_map:                     // edi = код ошибки системы → 1 отказ, 2 таймаут, 3 нет маршрута, 0 без кода"));
    do(o >> add("    cmp edi, 61                     # ECONNREFUSED (Darwin)"));
    do(o >> add("    je 1f"));
    do(o >> add("    cmp edi, 60                     # ETIMEDOUT (Darwin)"));
    do(o >> add("    je 2f"));
    do(o >> add("    cmp edi, 51                     # ENETUNREACH (Darwin)"));
    do(o >> add("    je 3f"));
    do(o >> add("    cmp edi, 65                     # EHOSTUNREACH (Darwin)"));
    do(o >> add("    je 3f"));
    do(o >> add("    xor eax, eax"));
    do(o >> add("    ret"));
    do(o >> add("1:  mov eax, 1"));
    do(o >> add("    ret"));
    do(o >> add("2:  mov eax, 2"));
    do(o >> add("    ret"));
    do(o >> add("3:  mov eax, 3"));
    do(o >> add("    ret"));
    do(o >> add(""));
    do(o >> add("_bit_errno_code:                    // → код ошибки системы из errno"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
    do(o >> add("    call ___error"));
    do(o >> add("    mov edi, dword ptr [rax]"));
    do(o >> add("    pop rbp"));
    do(o >> add("    jmp _bit_errno_map"));
    do(o >> add(""));
    do(o >> add("// User locks have process lifetime; aliases refer to the same mutex."));
    do(o >> add("_bit_user_lock_new:"));
    do(o >> add("    push rbp"));
    do(o >> add("    mov rbp, rsp"));
