# Последняя орбита — текстовая стратегия на 8 ходов.
# Цель: поднять сигнал до 3 и продержаться до спасателей.

host {
    num day = 1;
    num hull = 8;
    num power = 10;
    num food = 10;
    num signal = 0;
    num action = 0;

    print("╔══════════════════════════════════════╗");
    print("║        ПОСЛЕДНЯЯ ОРБИТА             ║");
    print("╚══════════════════════════════════════╝");
    print("Экипаж из четырёх человек застрял на станции «Полынь».");
    print("Спасатели услышат вас, если сигнал достигнет 3.");
    print("Выдержите 8 суток. Каждый ход выбирайте одно действие.");

    while day <= 8 and hull > 0 and power > 0 and food > 0 {
        print("");
        print("── СУТКИ {day} / 8 ──");
        print("Корпус {hull}/10 | энергия {power}/10 | пайки {food} | сигнал {signal}/3");
        if day % 2 == 0 {
            print("Прогноз: солнечная вспышка ударит по энергосистеме.");
        } else {
            if day % 3 == 0 {
                print("Прогноз: пылевой фронт может повредить запасы.");
            } else {
                print("Прогноз: тихий участок орбиты. Можно рискнуть.");
            }
        }
        print("1 — заварить корпус (+2 корпус, −1 энергия)");
        print("2 — перезапустить реактор (+4 энергии, максимум 10)");
        print("3 — найти аварийные пайки (+4 пайка, −1 энергия)");
        print("4 — настроить антенну (+1 сигнал, −2 энергии)");
        print("Твой выбор (1–4):");
        do(action >> input(1:4));

        if action == 1 {
            if hull < 9 { do(hull >> ch(hull + 2)); }
            else { do(hull >> ch(10)); }
            do(power >> ch(power - 1));
            print("Ты варишь трещины. Металл снова держит давление.");
        } else {
            if action == 2 {
                do(power >> ch(power + 4));
                if power > 10 { do(power >> ch(10)); }
                print("Реактор гудит громче. Свет возвращается в жилой отсек.");
            } else {
                if action == 3 {
                    do(food >> ch(food + 4));
                    do(power >> ch(power - 1));
                    print("В грузовом отсеке нашлись консервы и вода.");
                } else {
                    do(signal >> ch(signal + 1));
                    do(power >> ch(power - 2));
                    print("Антенна поймала слабый ответ с Земли.");
                }
            }
        }

        # Ночная смена расходует ресурсы.
        do(food >> ch(food - 1));
        do(power >> ch(power - 1));

        if day % 3 == 0 {
            do(hull >> ch(hull - 1));
            print("Пылевой фронт царапает внешний корпус. Корпус −1.");
        }
        if day % 2 == 0 {
            do(power >> ch(power - 1));
            print("Солнечная вспышка перегружает контуры. Энергия −1.");
        }

        if hull > 10 { do(hull >> ch(10)); }
        if power > 10 { do(power >> ch(10)); }
        print("Итог суток: корпус {hull}, энергия {power}, пайки {food}, сигнал {signal}.");
        do(day >> ch(day + 1));
    }

    print("");
    if hull <= 0 or power <= 0 or food <= 0 {
        print("СВЯЗЬ ПОТЕРЯНА. «Полынь» не пережила эту орбиту.");
        print("Дожили до суток {day}. Сигнал успел вырасти до {signal}.");
    } else {
        if signal >= 3 {
            print("На частоте появляется голос: «Полынь, мы вас видим. Держитесь».");
            print("ПОБЕДА: спасательный корабль уже вышел на орбиту.");
        } else {
            print("Восьмые сутки. Запасы ещё есть, но сигнал слишком слабый.");
            print("Экипаж выжил — спасатели вас пока не нашли.");
        }
    }
    print("Финал: корпус {hull}, энергия {power}, пайки {food}, сигнал {signal}.");
}
