# подключение с таймаутом и кодом ошибки
host {
    recover {
        conn c = "127.0.0.1:9100" >> connect(500);
        print("подключился за полсекунды");
        do(c >> close);
    } else {
        num code = term >> error_code;
        # 1 — цель отказала, 2 — истекло ожидание, 3 — нет маршрута, 0 — без кода
        if code == 1 {
            print("порт закрыт");
        } else if code == 2 {
            print("цель не отвечает: истекло ожидание");
        } else if code == 3 {
            print("цель недостижима");
        } else {
            print("другое: код {code}, {term >> error}");
        }
    }
}
